<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>MarketAssistant</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- SK 搜索连接器（Plugins.Web）及泛型 ITextSearch 接口均为实验性 API（SKEXP0001/0050）且无稳定替代，
         官方已确认 SK 进入维护模式，等待 MAF 生态补齐搜索能力，期间按需抑制 -->
    <NoWarn>$(NoWarn);MAAI001;SKEXP0001;SKEXP0050</NoWarn>
    <InternalsVisibleTo>TestMarketAssistant</InternalsVisibleTo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Svg.Skia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarketAssistant.Core\MarketAssistant.Core.csproj" />
    <ProjectReference Include="..\MarketAssistant.Agents\MarketAssistant.Agents.csproj" />
    <ProjectReference Include="..\MarketAssistant.Trading\MarketAssistant.Trading.csproj" />
    <ProjectReference Include="..\MarketAssistant.DataProviders\MarketAssistant.DataProviders.csproj" />
    <ProjectReference Include="..\MarketAssistant.Rag\MarketAssistant.Rag.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AdaptiveCards" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows.Generators">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.SqliteVec" />
    <PackageReference Include="Microsoft.SemanticKernel.Plugins.Web" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Skender.Stock.Indicators" />
    <PackageReference Include="SmartReader" />
    <!-- Added for CLIP ONNX embedding support -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="YamlDotNet" />
    <!-- RSS 解析（CoinTelegraph 等虚拟币新闻源） -->
    <PackageReference Include="System.ServiceModel.Syndication" />
  </ItemGroup>
</Project>
