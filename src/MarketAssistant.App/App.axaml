<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MarketAssistant.App"
             xmlns:infra="using:MarketAssistant.Infrastructure.Core"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <infra:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Resources/Styles/Colors.axaml"/>
                <ResourceInclude Source="/Resources/Styles/Elevation.axaml"/>
                <ResourceInclude Source="/Resources/Styles/Motion.axaml"/>
                <ResourceInclude Source="/Resources/Styles/Spacing.axaml"/>
                <ResourceInclude Source="/Resources/Styles/Geometries.axaml"/>
                <!-- ToggleSwitch 主题必须在 Spacing/Colors 之后：它引用 BodySmFontSize 与主题色阶。
                     放在 Resources 而非 Styles —— 资源查找优先 Resources，这是覆盖 FluentTheme
                     内置 {x:Type ToggleSwitch} 主题的干净途径。 -->
                <ResourceInclude Source="/Resources/Styles/ToggleSwitchStyles.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- 全局默认字体：Inter（拉丁）+ 中文回退链。必须在主题样式之后、组件样式之前，
             这样组件样式未显式指定 FontFamily 时都会继承到这里。 -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        </Style>
        <Style Selector="UserControl">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <!-- 表格数字：等宽字体族缺失时（三平台回退各不相同）仍保证数字逐位对齐、刷新不跳动。
                 只影响数字字形，不影响中文。等宽数字是"数值锁宽"的兜底，见 design.md 3.3。 -->
            <Setter Property="FontFeatures" Value="tnum"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
        </Style>

        <StyleInclude Source="/Resources/Styles/ButtonStyles.axaml"/>
        <StyleInclude Source="/Resources/Styles/CardStyles.axaml"/>
        <StyleInclude Source="/Resources/Styles/TextStyles.axaml"/>
        <StyleInclude Source="/Resources/Styles/ListStyles.axaml"/>
        <StyleInclude Source="/Resources/Styles/SkeletonStyles.axaml"/>
        <StyleInclude Source="/Resources/Styles/FormStyles.axaml"/>
        <StyleInclude Source="/Views/Controls/CardView.axaml"/>
        <StyleInclude Source="/Views/Controls/PageHeaderView.axaml"/>
    </Application.Styles>

    <!-- 系统托盘图标 -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/tray_logo.ico" 
                      ToolTipText="MarketAssistant - 智能股票分析助手"
                      Clicked="TrayIcon_Clicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="显示主窗口" Click="ShowMainWindow_Click"/>
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="退出" Click="Exit_Click"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>