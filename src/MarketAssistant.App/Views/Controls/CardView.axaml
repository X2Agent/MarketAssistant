<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MarketAssistant.Views.Controls">

    <!-- ================================================================== -->
    <!-- CardView — v3：无边框、无默认阴影，靠白色表面与页面底色分层            -->
    <!--                                                                     -->
    <!-- 卡片内不再画分隔线。标题与内容之间靠 20px 留白 + 字重差来分区。         -->
    <!-- ================================================================== -->
    <Style Selector="controls|CardView">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:CardView">
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="{StaticResource NoBorderThickness}"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="{StaticResource CardPadding}">

                    <Grid RowDefinitions="Auto,Auto,*">

                        <!-- 字符串标题 -->
                        <TextBlock x:Name="PART_StringHeaderLabel"
                                   Grid.Row="0"
                                   FontSize="{StaticResource BodyFontSize}"
                                   FontWeight="{DynamicResource WeightTitle}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="{StaticResource BottomMargin}"
                                   IsVisible="False"/>

                        <!-- 视图标题 -->
                        <ContentPresenter x:Name="PART_ViewHeaderContentPresenter"
                                          Grid.Row="1"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Margin="{StaticResource BottomMargin}"
                                          IsVisible="False"/>

                        <!-- 主要内容。v3 移除了分隔线：改由标题的底部外边距建立间距。 -->
                        <ContentPresenter Grid.Row="2"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
