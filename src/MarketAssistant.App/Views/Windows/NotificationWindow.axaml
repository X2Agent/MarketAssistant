<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MarketAssistant.Views.Windows.NotificationWindow"
        Width="{StaticResource NotificationWidth}"
        Height="{StaticResource NotificationHeight}"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual">

    <!-- 悬浮通知：v3 唯一允许用重阴影的场景之一；无边框，靠表面色阶与阴影浮起 -->
    <Border Name="NotificationBorder"
            Background="{StaticResource NotificationDarkBackgroundBrush}"
            BorderThickness="{StaticResource NoBorderThickness}"
            CornerRadius="{StaticResource CardCornerRadius}"
            Padding="{StaticResource DefaultCardPadding}"
            Margin="{StaticResource SmallMargin}"
            BoxShadow="{StaticResource ShadowModal}">

        <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- 图标区域：语义色圆角块，尺寸与标题字号协调 -->
            <Border Grid.Column="0"
                    Width="{StaticResource MediumIconSize}"
                    Height="{StaticResource MediumIconSize}"
                    CornerRadius="{StaticResource NotificationIconCornerRadius}"
                    Background="{DynamicResource SuccessBrush}"
                    VerticalAlignment="Center">
                <TextBlock Text="✓"
                           FontSize="{StaticResource BodyFontSize}"
                           FontWeight="{DynamicResource WeightEmphasis}"
                           Foreground="{StaticResource TextOnEmphasisBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- 消息内容 -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="{StaticResource SmallHorizontalMargin}">
                <ScrollViewer MaxHeight="{StaticResource NotificationMessageMaxHeight}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Name="MessageText"
                               Text="操作成功"
                               FontSize="{StaticResource BodySmFontSize}"
                               FontWeight="{DynamicResource WeightEmphasis}"
                               Foreground="{StaticResource NotificationTextLightBrush}"
                               TextWrapping="Wrap"
                               LineHeight="{StaticResource CaptionLineHeight}"/>
                </ScrollViewer>
            </StackPanel>

            <!-- 关闭按钮 -->
            <Button Grid.Column="2"
                    Name="CloseButton"
                    Content="✕"
                    Width="{StaticResource DefaultIconSize}"
                    Height="{StaticResource DefaultIconSize}"
                    FontSize="{StaticResource CaptionFontSize}"
                    Foreground="{StaticResource NotificationTextSecondaryBrush}"
                    Background="Transparent"
                    BorderThickness="{StaticResource NoBorderThickness}"
                    VerticalAlignment="Center"
                    Padding="{StaticResource NoPadding}"
                    CornerRadius="{StaticResource TinyCornerRadius}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Cursor="Hand">
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{StaticResource NotificationDarkHoverBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource NotificationTextLightBrush}"/>
                    </Style>
                    <Style Selector="Button:pressed">
                        <Setter Property="Background" Value="{StaticResource NotificationDarkPressedBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource NotificationTextLightBrush}"/>
                    </Style>
                </Button.Styles>
            </Button>
        </Grid>
    </Border>
</Window>
