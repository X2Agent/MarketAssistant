<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MarketAssistant.ViewModels.Home"
        xmlns:controls="using:MarketAssistant.Views.Controls"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
        x:Class="MarketAssistant.Views.Windows.DailyBriefingWindow"
        x:DataType="vm:DailyBriefingViewModel"
        Title="每日简报"
        Width="760"
        MinWidth="480"
        MaxWidth="960"
        Height="620"
        MinHeight="320"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">

    <Window.Styles>
        <!-- 重新生成期间旧正文变淡：表示"这份即将被替换"，避免被当成新结果阅读 -->
        <Style Selector="ScrollViewer.generating">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </Window.Styles>

    <Border Padding="{StaticResource CardPadding}">
        <DockPanel LastChildFill="True">

            <!-- 头部：标题 + 元信息（生成时间 / Token 成本）+ 操作按钮 -->
            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                  Margin="{StaticResource SmallBottomMargin}">
                <TextBlock Grid.Column="0"
                           Text="每日简报"
                           FontSize="{StaticResource BodyFontSize}"
                           FontWeight="{DynamicResource WeightTitle}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Margin="{StaticResource SmallLeftMargin}"
                           FontSize="{StaticResource CaptionFontSize}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding BriefingMetaText}"/>

                <!-- 生成态只在弹窗内呈现，首页标题栏不指示简报状态；
                     "正在生成"的视觉由正文区骨架承担，这里只留一句文案。 -->
                <TextBlock Grid.Column="2"
                           Text="生成中..."
                           FontSize="{StaticResource CaptionFontSize}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="{StaticResource SmallLeftMargin}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsGenerating}"/>

                <!-- 生成今日简报（纯手动策略：唯一会产生模型调用与费用的入口，
                     因此显式命名并给出确认语义，不做任何后台自动生成；
                     功能总开关关闭时禁用） -->
                <Button Grid.Column="3"
                        Content="生成今日简报"
                        Classes="btn-primary"
                        Command="{Binding RefreshCommand}"
                        IsVisible="{Binding !IsGenerating}"
                        IsEnabled="{Binding IsBriefingEnabled}"
                        ToolTip.Tip="调用模型生成今日简报，会产生 Token 费用"
                        Margin="{StaticResource SmallLeftMargin}"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="4"
                        Content="关闭"
                        Classes="btn-secondary"
                        Click="OnCloseClick"
                        Margin="{StaticResource SmallLeftMargin}"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- 底栏：近 30 天累计用量摘要（成本透明；无历史记录时隐藏） -->
            <TextBlock DockPanel.Dock="Bottom"
                       Margin="{StaticResource SmallTopMargin}"
                       FontSize="{StaticResource CaptionFontSize}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding UsageSummaryText}"
                       IsVisible="{Binding ShowUsageSummary}"/>

            <!-- 正文区：生成中骨架 / Markdown 全文 / 空态与失败态 -->
            <Panel>
                <!-- 生成中骨架：按 RichTextBlock 正文行高（24 / 行）排布，
                     与生成完成后的 Markdown 段落同高，正文出现时不塌陷。
                     行宽刻意参差，读起来是"一段文字即将出现"而不是"表格在加载"。 -->
                <controls:SkeletonLines IsVisible="{Binding ShowBriefingSkeleton}"
                                        Row="Body"
                                        LineCount="10"
                                        LineWidths="*,*,420,*,*,*,360,*,*,280"
                                        Spacing="{StaticResource SmallSpacing}"/>

                <!-- 全文：Width 由 Window 固定，Markdown 控件树因此正常折行、
                     高度自适应内容；ScrollViewer 负责超长文本的兜底滚动。
                     使用项目既有的 RichTextBlock（Markdown.Avalonia）渲染，
                     裸 TextBlock 只会显示 ** 与列表符等未渲染标记。
                     重新生成期间保留旧正文并调淡（不叠骨架）；重新生成失败时旧正文照常可读，
                     失败信息走顶部提示条，与交易监控页的刷新失败条同一做法。 -->
                <DockPanel IsVisible="{Binding HasBriefing}">
                    <controls:StatusBanner DockPanel.Dock="Top"
                                           Severity="Danger"
                                           Message="{Binding ErrorMessage}"
                                           Margin="{StaticResource SmallBottomMargin}"
                                           IsVisible="{Binding ShowRegenerateFailedBanner}">
                        <Button Content="重试"
                                Classes="btn-secondary btn-sm"
                                Command="{Binding RetryCommand}"/>
                    </controls:StatusBanner>

                    <ScrollViewer Classes.generating="{Binding IsGenerating}">
                        <controls:RichTextBlock Text="{Binding BriefingContent}"/>
                    </ScrollViewer>
                </DockPanel>

                <!-- 空态 / 失败态：只在既无简报又不在生成时出现 -->
                <controls:StateOverlayView State="{Binding BodyOverlayState}"
                                           Message="{Binding OverlayMessage}"
                                           RetryCommand="{Binding RetryCommand}"
                                           RetryText="重试"
                                           ShowLoading="False"/>
            </Panel>
        </DockPanel>
    </Border>
</Window>