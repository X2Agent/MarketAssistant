<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MarketAssistant.Views.Windows.InputDialogWindow"
        Width="{StaticResource DialogWidth}"
        MinWidth="350"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">

    <Border Padding="{StaticResource CardPadding}">
        <StackPanel Spacing="{StaticResource SmallSpacing}">

            <!-- 提示信息 -->
            <TextBlock Name="PromptText"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource LabelFontSize}"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <!-- 输入框 -->
            <TextBox Name="InputTextBox"
                     PlaceholderText="请输入..."/>

            <!-- 按钮区域 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="{StaticResource SmallSpacing}"
                        Margin="0,4,0,0">
                <Button Name="OkButton"
                        Content="确定"
                        Classes="btn-primary"
                        MinWidth="{StaticResource SmallButtonMinWidth}"
                        Padding="16,8"
                        Click="OnOkClick"/>
                <Button Name="CancelButton"
                        Content="取消"
                        Classes="btn-secondary"
                        MinWidth="{StaticResource SmallButtonMinWidth}"
                        Padding="16,8"
                        Click="OnCancelClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
