<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MarketAssistant.Views.Windows.InputDialogWindow"
        Width="{StaticResource DialogCardWidth}"
        MinWidth="360"
        MaxWidth="560"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">

    <!-- 居中卡片规范：宽 440，内边距 24，圆角 12，无边框 -->
    <Border Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="{StaticResource CardCornerRadius}"
            BorderThickness="{StaticResource NoBorderThickness}"
            Padding="{StaticResource PagePadding}"
            Margin="{StaticResource PagePaddingCompact}">
        <StackPanel Spacing="{StaticResource DefaultSpacing}">

            <!-- 提示信息 -->
            <TextBlock Name="PromptText"
                       TextWrapping="Wrap"
                       Classes="body"/>

            <!-- 输入框：聚焦走双环，不画亮线 -->
            <TextBox Name="InputTextBox"
                     PlaceholderText="请输入..."/>

            <!-- 按钮区域 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="{StaticResource SmallSpacing}"
                        Margin="{StaticResource TinyTopMargin}">
                <Button Name="CancelButton"
                        Content="取消"
                        Classes="btn-secondary"
                        MinWidth="{StaticResource SmallButtonMinWidth}"
                        Click="OnCancelClick"/>
                <Button Name="OkButton"
                        Content="确定"
                        Classes="btn-primary"
                        MinWidth="{StaticResource SmallButtonMinWidth}"
                        Click="OnOkClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
