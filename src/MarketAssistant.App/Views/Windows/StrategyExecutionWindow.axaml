<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:MarketAssistant.Trading.Models"
        xmlns:trading="using:MarketAssistant.Views.Components.Trading"
        x:Class="MarketAssistant.Views.Windows.StrategyExecutionWindow"
        x:DataType="models:TradingStrategy"
        Width="{StaticResource MaxDialogWidth}"
        MinWidth="400"
        MaxWidth="700"
        Height="600"
        MinHeight="400"
        MaxHeight="800"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">

    <Border Padding="{StaticResource CardPadding}">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- 策略概要：与策略配置页 / 监控页同一份行组件（DataContext 即当前策略，不带操作按钮） -->
            <trading:StrategyRowView Grid.Row="0"/>

            <!-- 交易记录列表：与交易历史页同一份行组件 -->
            <ScrollViewer Grid.Row="1" Margin="{StaticResource TinyTopMargin}">
                <StackPanel Spacing="{StaticResource TinySpacing}">
                    <TextBlock Name="EmptyText"
                               Classes="body-sm"
                               Text="该策略暂无执行记录"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="{StaticResource DefaultMargin}"/>
                    <ItemsControl Name="RecordsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TradeRecord">
                                <trading:TradeRecordRowView/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部关闭按钮：窗口只有一个出口，用次要按钮，不抢眼 -->
            <Button Grid.Row="2"
                    Content="关闭"
                    Classes="btn-secondary"
                    HorizontalAlignment="Center"
                    Click="OnCloseClick"
                    MinWidth="{StaticResource SmallButtonMinWidth}"
                    Margin="{StaticResource TinyTopMargin}"/>
        </Grid>
    </Border>
</Window>
