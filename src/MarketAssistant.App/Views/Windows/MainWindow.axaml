<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MarketAssistant.ViewModels"
        xmlns:infra="using:MarketAssistant.Infrastructure.Core"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="MarketAssistant.Views.Windows.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="MarketAssistant - 智能股票分析助手"
        MinWidth="{StaticResource MainWindowMinWidth}"
        MinHeight="{StaticResource MainWindowMinHeight}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <infra:ViewLocator x:Key="ViewLocator"/>
    </Window.Resources>

    <Window.KeyBindings>
        <!-- Ctrl+M 快捷键切换市场 -->
        <KeyBinding Gesture="Ctrl+M" Command="{Binding ToggleMarketCommand}"/>
    </Window.KeyBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource NavRailWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 左侧图标导航栏 -->
        <Border Grid.Column="0"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource RightBorderThickness}">
            <Border.Resources>
                <!-- 导航项模板：图标 + 活跃态左侧指示条（主导航与底部导航共享） -->
                <DataTemplate x:Key="NavRailItemTemplate" x:DataType="vm:NavigationItemViewModel">
                    <Panel Width="{StaticResource NavIconSize}"
                           Height="{StaticResource NavIconSize}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           ToolTip.Tip="{Binding Title}">
                        <svg:Svg Width="{StaticResource NavIconSize}"
                                Height="{StaticResource NavIconSize}"
                                Path="{Binding IconPath}"
                                IsVisible="{Binding !IsVisible, ElementName=SelectedIcon}"/>
                        <svg:Svg x:Name="SelectedIcon" Width="{StaticResource NavIconSize}"
                                Height="{StaticResource NavIconSize}"
                                Path="{Binding SelectedIconPath}"
                                IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                        <!-- 告警未读徽标（仅告警导航项在存在未读时显示） -->
                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{StaticResource ErrorBrush}"
                                 Stroke="{DynamicResource CardBackgroundBrush}"
                                 StrokeThickness="1.5"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 IsVisible="{Binding HasUnreadBadge}"/>
                    </Panel>
                </DataTemplate>
            </Border.Resources>
            <Border.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="{StaticResource SmallMargin}"/>
                    <Setter Property="Width" Value="{StaticResource NavItemSize}"/>
                    <Setter Property="Height" Value="{StaticResource NavItemSize}"/>
                    <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
                <!-- 活跃态：浅色选中背景，替代整块品牌蓝填充 -->
                <Style Selector="ListBoxItem:selected">
                    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                </Style>
                <Style Selector="ListBoxItem:focus">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="{StaticResource ThickBorderThickness}"/>
                </Style>
                <!-- 导航栏市场切换芯片：显示当前市场，点击在 A股/虚拟币间切换（导航栏唯一切换入口） -->
                <Style Selector="Button.market-chip">
                    <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}"/>
                    <Setter Property="Padding" Value="6,3"/>
                    <Setter Property="FontSize" Value="{StaticResource MiniFontSize}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
                <Style Selector="Button.market-chip:pointerover">
                    <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                </Style>
            </Border.Styles>
            <DockPanel Margin="{StaticResource LogoTopMargin}">
                <!-- 应用 Logo（纯品牌展示）与市场切换芯片 -->
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Spacing="{StaticResource SmallSpacing}">
                    <!-- Logo：仅作品牌标识；市场切换由下方芯片与 Ctrl+M 承担，避免一处功能两个入口 -->
                    <Border Width="{StaticResource AppLogoSize}"
                            Height="{StaticResource AppLogoSize}"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            ClipToBounds="True"
                            HorizontalAlignment="Center">
                        <Image Source="/Assets/logo_ui.png"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <!-- 市场切换芯片：当前市场名 + 切换指示，点击切换（ToggleMarket 与 Ctrl+M 等价） -->
                    <Button Classes="market-chip"
                            Width="60"
                            HorizontalAlignment="Center"
                            Command="{Binding ToggleMarketCommand}"
                            AutomationProperties.Name="切换市场"
                            ToolTip.Tip="点击切换市场（Ctrl+M）">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                            <TextBlock Text="{Binding CurrentMarketShortText}" VerticalAlignment="Center"/>
                            <TextBlock Text="⇄" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 底部固定：设置 / 关于（对齐原型 sidebar nav-bot）。
                     注意：必须声明在主导航之前，否则作为 DockPanel 最后一个子元素会被 LastChildFill 当作填充项，Bottom 停靠失效导致两项不可见 -->
                <ListBox DockPanel.Dock="Bottom"
                         ItemsSource="{Binding BottomNavigationItems}"
                         SelectedItem="{Binding SelectedBottomNavigationItem}"
                         Background="Transparent"
                         BorderThickness="{StaticResource NoBorderThickness}"
                         Padding="{StaticResource NoPadding}"
                         ItemTemplate="{StaticResource NavRailItemTemplate}"/>

                <!-- 主导航（贴顶，DockPanel 最后的填充子项） -->
                <ListBox ItemsSource="{Binding MainNavigationItems}"
                         SelectedItem="{Binding SelectedMainNavigationItem}"
                         Background="Transparent"
                         BorderThickness="{StaticResource NoBorderThickness}"
                         Padding="{StaticResource NoPadding}"
                         ItemTemplate="{StaticResource NavRailItemTemplate}"/>
            </DockPanel>
        </Border>

        <!-- 常驻顶部栏：仅在首页（行情条）与二级页面（返回 + 标题）显示；
             其余根页面顶栏无实质内容，整条隐藏（市场切换器已移入左侧导航栏） -->
        <Border Grid.Column="1"
                Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource NavBarBottomBorder}"
                IsVisible="{Binding ShowTopBar}">
            <Grid ColumnDefinitions="Auto,Auto,*" Margin="{StaticResource PagePadding}">
                <!-- 返回按钮 -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            Spacing="{StaticResource SmallSpacing}"
                            IsVisible="{Binding CanGoBack}">
                    <Button Command="{Binding GoBackCommand}"
                            Background="Transparent"
                            BorderThickness="{StaticResource NoBorderThickness}"
                            Padding="{StaticResource SmallMargin}"
                            ToolTip.Tip="返回">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                            <TextBlock Text="←" 
                                       FontSize="{StaticResource SubTitleFontSize}" 
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="返回" 
                                       FontSize="{StaticResource LabelFontSize}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Border Width="{StaticResource DividerHeight}" 
                            Height="{StaticResource SmallIconSize}" 
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 页面标题 -->
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentPageTitle}"
                           FontSize="{StaticResource LabelFontSize}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- 行情条（贯穿标题与市场切换器之间的弹性区域，均分分块展示，对齐原型 tb-ticker）；
                     仅首页根页面常驻（其余根页面与二级详情页隐藏），无数据时随 ShowIndexTickers 自动隐藏 -->
                <ItemsControl Grid.Column="2"
                              ItemsSource="{Binding IndexTickers}"
                              IsVisible="{Binding ShowIndexTickers}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Margin="{StaticResource SmallHorizontalMargin}">
                    <ItemsControl.Styles>
                        <!-- 首块隐藏左侧分隔线（分隔线仅出现在块与块之间） -->
                        <Style Selector="UniformGrid > ContentPresenter:first-child Border.ticker-sep">
                            <Setter Property="IsVisible" Value="False"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IndexTickerItemViewModel">
                            <!-- ClipToBounds：极窄窗口下单元格内容溢出时按块裁剪，避免与相邻块文字重叠 -->
                            <Panel VerticalAlignment="Center" ClipToBounds="True">
                                <!-- 块间竖分隔线（对齐原型 tb-tsep） -->
                                <Border Classes="ticker-sep"
                                        Width="{StaticResource DividerHeight}"
                                        Height="14"
                                        Background="{DynamicResource BorderBrush}"
                                        HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource SmallFontSize}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Price}"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontSize="{StaticResource SmallFontSize}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ChangeText}"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontSize="{StaticResource SmallFontSize}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IsUp}"
                                               Foreground="{StaticResource BullishBrush}"/>
                                    <TextBlock Text="{Binding ChangeText}"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontSize="{StaticResource SmallFontSize}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IsDown}"
                                               Foreground="{StaticResource BearishBrush}"/>
                                    <!-- 中性/无涨跌语义（平盘、主导率、恐惧贪婪分类） -->
                                    <TextBlock Text="{Binding ChangeText}"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontSize="{StaticResource SmallFontSize}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IsNeutral}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 右侧内容区域 -->
        <ContentControl Grid.Column="1"
                        Grid.Row="1"
                        Content="{Binding CurrentPage}"
                        ContentTemplate="{StaticResource ViewLocator}"/>
    </Grid>

</Window>
