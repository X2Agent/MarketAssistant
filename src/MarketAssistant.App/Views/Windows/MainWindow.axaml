<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MarketAssistant.ViewModels"
        xmlns:infra="using:MarketAssistant.Infrastructure.Core"
        xmlns:views="using:MarketAssistant.Views.Components"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="MarketAssistant.Views.Windows.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Shell"
        Icon="/Assets/logo.ico"
        Title="MarketAssistant - 智能股票分析助手"
        MinWidth="{StaticResource MainWindowMinWidth}"
        MinHeight="{StaticResource MainWindowMinHeight}"
        Background="{DynamicResource PageBackgroundBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <infra:ViewLocator x:Key="ViewLocator"/>
    </Window.Resources>

    <Window.KeyBindings>
        <!-- Ctrl+M 快捷键切换市场 -->
        <KeyBinding Gesture="Ctrl+M" Command="{Binding ToggleMarketCommand}"/>
    </Window.KeyBindings>
    <Window.Styles>
        <!-- 窄窗收起：由代码后置在 ShellGrid 上切换 compact 类，
             纯样式驱动，避免每次尺寸变化都遍历可视树。 -->
        <Style Selector="Grid.compact TextBlock.nav-label">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid.compact TextBlock.nav-group">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid.compact StackPanel#BrandText">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Grid.compact StackPanel.nav-header">
            <Setter Property="Margin" Value="0,16,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- 收起后导航项内边距归零、内容居中（图标居中于 72px 轨道） -->
        <Style Selector="Grid.compact Grid.nav-item">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Grid.compact StackPanel.nav-holder">
            <Setter Property="Margin" Value="{StaticResource NavHolderCompactPadding}"/>
        </Style>
        <!-- 收起后市场切换芯片只剩图标级宽度（48px 内容区），去掉横向内边距与副箭头 -->
        <Style Selector="Grid.compact Button.market-chip">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Grid.compact TextBlock#MarketChipArrow">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- ============================================================ -->
        <!-- 侧边导航项：图标 + 文字。v3 从 72px 纯图标轨升级为 240px 文字导航 -->
        <!-- ============================================================ -->
        <Style Selector="ListBox.nav-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Height" Value="{StaticResource NavItemHeight}"/>
            <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.nav-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        </Style>
        <!-- 选中态：强调色浅底 + 强调色文字，不用左侧竖条（v3 去掉装饰性指示条） -->
        <Style Selector="ListBox.nav-list ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
        </Style>
        <Style Selector="ListBox.nav-list ListBoxItem:selected TextBlock.nav-label">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="{DynamicResource WeightEmphasis}"/>
        </Style>

        <Style Selector="TextBlock.nav-label">
            <Setter Property="FontSize" Value="{StaticResource BodySmFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style Selector="TextBlock.nav-group">
            <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
            <Setter Property="Margin" Value="{StaticResource NavGroupMargin}"/>
        </Style>

        <!-- 市场切换芯片 -->
        <Style Selector="Button.market-chip">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="{StaticResource SegmentButtonPadding}"/>
            <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource WeightEmphasis}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="{StaticResource TinyCornerRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.market-chip:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        </Style>

        <!-- 顶栏已移除（v3）：返回导航浮层化于内容区左上角，行情条归属首页头部。 -->
    </Window.Styles>

    <Panel>
        <Grid x:Name="ShellGrid">
            <Grid.ColumnDefinitions>
                <!-- 展开/收起宽度由代码后置按 CompactWindowBreakpoint 切换，取值来自 Spacing.axaml 令牌 -->
                <ColumnDefinition Width="{StaticResource NavRailWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================================ -->
            <!-- 左侧导航：240px 文字导航                                       -->
            <!-- ============================================================ -->
            <Border Grid.Column="0"
                    Name="NavRail"
                    Background="{DynamicResource CardBackgroundBrush}">
                <DockPanel>

                    <!-- 品牌区 -->
                    <StackPanel DockPanel.Dock="Top" Classes="nav-header" Margin="{StaticResource NavHeaderPadding}" Spacing="{StaticResource LargeSpacing}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                            <Border Classes="brand" Width="{StaticResource AppLogoSize}"
                                    Height="{StaticResource AppLogoSize}"
                                    CornerRadius="{StaticResource SmallCornerRadius}"
                                    ClipToBounds="True">
                                <Image Source="/Assets/logo_ui.png" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource TinySpacing}" Name="BrandText">
                                <TextBlock Text="MarketAssistant"
                                           FontSize="{StaticResource BodySmFontSize}"
                                           FontWeight="{DynamicResource WeightTitle}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="AI 市场分析工作站"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextDisabledBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 市场切换：全页面恒显 -->
                        <Button Classes="market-chip"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ToggleMarketCommand}"
                                AutomationProperties.Name="切换市场"
                                ToolTip.Tip="点击切换市场（Ctrl+M）">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CurrentMarketText}" VerticalAlignment="Center"/>
                                <TextBlock Name="MarketChipArrow" Text="⇄" VerticalAlignment="Center" Opacity="0.6"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 底部：设置 / 关于 -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="{StaticResource NavFooterPadding}" Spacing="{StaticResource TinySpacing}">
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="{StaticResource SmallBottomMargin}"/>
                        <ListBox ItemsSource="{Binding BottomNavigationItems}"
                                 SelectedItem="{Binding SelectedBottomNavigationItem}"
                                 Classes="nav-list"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="{StaticResource NoPadding}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                    <Grid Classes="nav-item" ColumnDefinitions="20,*" Margin="{StaticResource NavItemInnerMargin}" VerticalAlignment="Center">
                                        <Panel Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                            <svg:Svg Width="20" Height="20" Path="{Binding IconPath}"
                                                     IsVisible="{Binding !$parent[ListBoxItem].IsSelected}"/>
                                            <svg:Svg Width="20" Height="20" Path="{Binding SelectedIconPath}"
                                                     IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                                        </Panel>
                                        <TextBlock Grid.Column="1" Classes="nav-label" Text="{Binding Title}"
                                                   Margin="{StaticResource SmallLeftMargin}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- 主导航 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Classes="nav-holder" Margin="{StaticResource NavHolderPadding}">
                            <TextBlock Classes="nav-group" Text="市场"/>
                            <ListBox ItemsSource="{Binding MainNavigationItems}"
                                     SelectedItem="{Binding SelectedMainNavigationItem}"
                                     Classes="nav-list"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="{StaticResource NoPadding}">
                                <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                    <Grid Classes="nav-item" ColumnDefinitions="20,*,Auto" Margin="{StaticResource NavItemInnerMargin}" VerticalAlignment="Center">
                                        <Panel Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                            <svg:Svg Width="20" Height="20" Path="{Binding IconPath}"
                                                     IsVisible="{Binding !$parent[ListBoxItem].IsSelected}"/>
                                            <svg:Svg Width="20" Height="20" Path="{Binding SelectedIconPath}"
                                                     IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                                        </Panel>
                                        <TextBlock Grid.Column="1" Classes="nav-label"
                                                   Text="{Binding Title}" Margin="{StaticResource SmallLeftMargin}"/>
                                        <!-- 未读告警 -->
                                        <Border Grid.Column="2"
                                                Width="6" Height="6" CornerRadius="3"
                                                Background="{DynamicResource ErrorBrush}"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasUnreadBadge}"/>
                                    </Grid>
                                </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- 内容区：顶栏已移除（v3），二级页面的返回入口为布局内窄条。       -->
            <!-- ============================================================ -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentPage}"
                                ContentTemplate="{StaticResource ViewLocator}"/>

                <!-- 返回导航条：仅二级页面（CanGoBack）时出现；根页面整行折叠为零高度，
                     不再使用浮层——浮层会遮挡页面左上角的卡片与标题。
                     左侧「← 标题」，右侧是页面级操作槽：页面内不要为一个图标按钮另起一整行，
                     否则顶部会多出一条几乎全空的横带。 -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="{StaticResource SmallSpacing}"
                      Margin="{StaticResource BackBarMargin}"
                      VerticalAlignment="Center"
                      IsVisible="{Binding CanGoBack}">
                    <!-- 返回：btn-icon 提供 40×40 标准点击区，图标 20。
                         旧版是 btn-sm + Padding=0 的纯文本 ←，实际命中区只有约 10×20。 -->
                    <Button Grid.Column="0"
                            Classes="btn-ghost btn-icon"
                            Command="{Binding GoBackCommand}"
                            ToolTip.Tip="返回（Esc）"
                            AutomationProperties.Name="返回">
                        <PathIcon Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                                  Width="{StaticResource SmallIconSize}"
                                  Height="{StaticResource SmallIconSize}"/>
                    </Button>
                    <TextBlock Grid.Column="1"
                               Name="PageTitle"
                               Classes="body-sm"
                               FontWeight="{DynamicResource WeightTitle}"
                               Text="{Binding CurrentPageTitle}"
                               VerticalAlignment="Center"/>

                    <!-- 页面级操作槽：按页面 ViewModel 类型注入操作控件，其 DataContext 即页面 VM。
                         末尾的兜底空模板必须保留：全局 ViewLocator 匹配所有 ViewModelBase，
                         没有它，其余二级页面会把整页视图渲染进返回条。 -->
                    <ContentControl Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Content="{Binding CurrentPage}">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="vm:AgentAnalysisViewModel">
                                <views:AgentAnalysisMenuButton/>
                            </DataTemplate>
                            <DataTemplate DataType="vm:ViewModelBase">
                                <Panel/>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                </Grid>
            </Grid>
        </Grid>
    </Panel>

</Window>
