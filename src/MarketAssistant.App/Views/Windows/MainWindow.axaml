<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MarketAssistant.ViewModels"
        xmlns:infra="using:MarketAssistant.Infrastructure.Core"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="MarketAssistant.Views.Windows.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="MarketAssistant - 智能股票分析助手"
        MinWidth="{StaticResource MainWindowMinWidth}"
        MinHeight="{StaticResource MainWindowMinHeight}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <infra:ViewLocator x:Key="ViewLocator"/>
    </Window.Resources>

    <Window.KeyBindings>
        <!-- Ctrl+M 快捷键切换市场 -->
        <KeyBinding Gesture="Ctrl+M" Command="{Binding ToggleMarketCommand}"/>
    </Window.KeyBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource NavRailWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 左侧图标导航栏 -->
        <Border Grid.Column="0"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource RightBorderThickness}">
            <StackPanel Margin="{StaticResource LogoTopMargin}" Spacing="{StaticResource TinySpacing}">
                <!-- 应用Logo图标和市场名称 -->
                <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource TinySpacing}">
                    <!-- Logo按钮（点击切换市场） -->
                    <Button Width="{StaticResource AppLogoSize}"
                            Height="{StaticResource AppLogoSize}"
                            AutomationProperties.Name="切换市场"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            HorizontalAlignment="Center"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="{StaticResource NoBorderThickness}"
                            Command="{Binding ToggleMarketCommand}">
                        <ToolTip.Tip>
                            <StackPanel>
                                <TextBlock Text="点击切换市场" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentMarketText}" FontSize="{StaticResource TinyFontSize}" Opacity="0.8"/>
                                <TextBlock Text="快捷键: Ctrl+M" FontSize="{StaticResource MiniFontSize}" Opacity="0.6"/>
                            </StackPanel>
                        </ToolTip.Tip>
                        <Border Width="{StaticResource AppLogoSize}"
                                Height="{StaticResource AppLogoSize}"
                                CornerRadius="{StaticResource DefaultCornerRadius}"
                                ClipToBounds="True">
                            <Image Source="/Assets/logo.png"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                    
                    <!-- 市场名称文字 -->
                    <TextBlock Text="{Binding CurrentMarketText}" 
                               FontSize="{StaticResource MiniFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="{StaticResource MarketLabelMargin}"/>
                </StackPanel>

                <!-- 导航菜单 -->
                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         Background="Transparent"
                         BorderThickness="{StaticResource NoBorderThickness}"
                         Padding="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="{StaticResource SmallMargin}"/>
                            <Setter Property="Width" Value="{StaticResource FABSize}"/>
                            <Setter Property="Height" Value="{StaticResource AppLogoSize}"/>
                            <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                        <!-- 活跃态：浅色选中背景，替代整块品牌蓝填充 -->
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:focus">
                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="BorderThickness" Value="{StaticResource ThickBorderThickness}"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItemViewModel">
                            <!-- 图标 + 活跃态左侧指示条 -->
                            <Panel Width="{StaticResource DefaultIconSize}" 
                                   Height="{StaticResource DefaultIconSize}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding Title}">
                                <!-- 活跃态左侧 3px 竖条 -->
                                <Border Width="3"
                                        Height="20"
                                        CornerRadius="1.5"
                                        Background="{StaticResource PrimaryLightBrush}"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                                <svg:Svg Width="{StaticResource DefaultIconSize}" 
                                        Height="{StaticResource DefaultIconSize}" 
                                        Path="{Binding IconPath}"
                                        IsVisible="{Binding !IsVisible, ElementName=SelectedIcon}"/>
                                <svg:Svg x:Name="SelectedIcon" Width="{StaticResource DefaultIconSize}" 
                                        Height="{StaticResource DefaultIconSize}" 
                                        Path="{Binding SelectedIconPath}" 
                                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- 常驻顶部栏：标题/返回 + 分段市场切换器 -->
        <Border Grid.Column="1" 
                Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource NavBarBottomBorder}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="{StaticResource PagePadding}">
                <!-- 返回按钮 -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            Spacing="{StaticResource SmallSpacing}"
                            IsVisible="{Binding CanGoBack}">
                    <Button Command="{Binding GoBackCommand}"
                            Background="Transparent"
                            BorderThickness="{StaticResource NoBorderThickness}"
                            Padding="{StaticResource SmallMargin}"
                            ToolTip.Tip="返回">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                            <TextBlock Text="←" 
                                       FontSize="{StaticResource SubTitleFontSize}" 
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="返回" 
                                       FontSize="{StaticResource LabelFontSize}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Border Width="{StaticResource DividerHeight}" 
                            Height="{StaticResource SmallIconSize}" 
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 页面标题 -->
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentPageTitle}" 
                           FontSize="{StaticResource LabelFontSize}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- A股 / 虚拟币 分段市场切换器 -->
                <Border Grid.Column="3"
                        Padding="2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceVariantBrush}"
                        CornerRadius="{StaticResource DefaultCornerRadius}"
                        ToolTip.Tip="快捷键: Ctrl+M">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes.active="{Binding IsAShareMarket}"
                            Command="{Binding SwitchMarketCommand}"
                            CommandParameter="AShare"
                            Padding="12,4"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            BorderThickness="{StaticResource NoBorderThickness}"
                            AutomationProperties.Name="切换到A股市场">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Style>
                            <Style Selector="Button[IsPressed=true]">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button.active">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <TextBlock Text="A股"
                                   FontSize="{StaticResource TinyFontSize}"
                                   FontWeight="SemiBold"/>
                    </Button>
                    <Button Classes.active="{Binding IsCryptoMarket}"
                            Command="{Binding SwitchMarketCommand}"
                            CommandParameter="Crypto"
                            Padding="12,4"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            BorderThickness="{StaticResource NoBorderThickness}"
                            AutomationProperties.Name="切换到虚拟币市场">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Style>
                            <Style Selector="Button[IsPressed=true]">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="Button.active">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <TextBlock Text="虚拟币"
                                   FontSize="{StaticResource TinyFontSize}"
                                   FontWeight="SemiBold"/>
                    </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧内容区域 -->
        <ContentControl Grid.Column="1"
                        Grid.Row="1"
                        Content="{Binding CurrentPage}"
                        ContentTemplate="{StaticResource ViewLocator}"/>
    </Grid>

</Window>
