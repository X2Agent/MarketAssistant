<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MarketAssistant.ViewModels"
        xmlns:infra="using:MarketAssistant.Infrastructure.Core"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="MarketAssistant.Views.Windows.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="MarketAssistant - 智能股票分析助手"
        MinWidth="{StaticResource MainWindowMinWidth}"
        MinHeight="{StaticResource MainWindowMinHeight}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <infra:ViewLocator x:Key="ViewLocator"/>
    </Window.Resources>

    <Window.KeyBindings>
        <!-- Ctrl+M 快捷键切换市场 -->
        <KeyBinding Gesture="Ctrl+M" Command="{Binding ToggleMarketCommand}"/>
    </Window.KeyBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource NavRailWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 左侧图标导航栏 -->
        <Border Grid.Column="0"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource RightBorderThickness}">
            <Border.Resources>
                <!-- 导航项模板：图标 + 活跃态左侧指示条（主导航与底部导航共享） -->
                <DataTemplate x:Key="NavRailItemTemplate" x:DataType="vm:NavigationItemViewModel">
                    <Panel Width="{StaticResource DefaultIconSize}"
                           Height="{StaticResource DefaultIconSize}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           ToolTip.Tip="{Binding Title}">
                        <svg:Svg Width="{StaticResource DefaultIconSize}"
                                Height="{StaticResource DefaultIconSize}"
                                Path="{Binding IconPath}"
                                IsVisible="{Binding !IsVisible, ElementName=SelectedIcon}"/>
                        <svg:Svg x:Name="SelectedIcon" Width="{StaticResource DefaultIconSize}"
                                Height="{StaticResource DefaultIconSize}"
                                Path="{Binding SelectedIconPath}"
                                IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                    </Panel>
                </DataTemplate>
            </Border.Resources>
            <Border.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="{StaticResource SmallMargin}"/>
                    <Setter Property="Width" Value="{StaticResource FABSize}"/>
                    <Setter Property="Height" Value="{StaticResource AppLogoSize}"/>
                    <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
                <!-- 活跃态：浅色选中背景，替代整块品牌蓝填充 -->
                <Style Selector="ListBoxItem:selected">
                    <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                </Style>
                <Style Selector="ListBoxItem:focus">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="{StaticResource ThickBorderThickness}"/>
                </Style>
            </Border.Styles>
            <DockPanel Margin="{StaticResource LogoTopMargin}">
                <!-- 应用Logo图标和市场名称 -->
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Spacing="{StaticResource TinySpacing}">
                    <!-- Logo按钮（点击切换市场） -->
                    <Button Width="{StaticResource AppLogoSize}"
                            Height="{StaticResource AppLogoSize}"
                            AutomationProperties.Name="切换市场"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            HorizontalAlignment="Center"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="{StaticResource NoBorderThickness}"
                            Command="{Binding ToggleMarketCommand}">
                        <ToolTip.Tip>
                            <StackPanel>
                                <TextBlock Text="点击切换市场" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentMarketText}" FontSize="{StaticResource TinyFontSize}" Opacity="0.8"/>
                                <TextBlock Text="快捷键: Ctrl+M" FontSize="{StaticResource MiniFontSize}" Opacity="0.6"/>
                            </StackPanel>
                        </ToolTip.Tip>
                        <Border Width="{StaticResource AppLogoSize}"
                                Height="{StaticResource AppLogoSize}"
                                CornerRadius="{StaticResource DefaultCornerRadius}"
                                ClipToBounds="True">
                            <Image Source="/Assets/logo.png"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                    
                    <!-- 市场名称文字 -->
                    <TextBlock Text="{Binding CurrentMarketText}" 
                               FontSize="{StaticResource MiniFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="{StaticResource MarketLabelMargin}"/>
                </StackPanel>

                <!-- 底部固定：设置 / 关于（对齐原型 sidebar nav-bot）。
                     注意：必须声明在主导航之前，否则作为 DockPanel 最后一个子元素会被 LastChildFill 当作填充项，Bottom 停靠失效导致两项不可见 -->
                <ListBox DockPanel.Dock="Bottom"
                         ItemsSource="{Binding BottomNavigationItems}"
                         SelectedItem="{Binding SelectedBottomNavigationItem}"
                         Background="Transparent"
                         BorderThickness="{StaticResource NoBorderThickness}"
                         Padding="0"
                         ItemTemplate="{StaticResource NavRailItemTemplate}"/>

                <!-- 主导航（贴顶，DockPanel 最后的填充子项） -->
                <ListBox ItemsSource="{Binding MainNavigationItems}"
                         SelectedItem="{Binding SelectedMainNavigationItem}"
                         Background="Transparent"
                         BorderThickness="{StaticResource NoBorderThickness}"
                         Padding="0"
                         ItemTemplate="{StaticResource NavRailItemTemplate}"/>
            </DockPanel>
        </Border>

        <!-- 常驻顶部栏：标题/返回 + 分段市场切换器 -->
        <Border Grid.Column="1" 
                Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource NavBarBottomBorder}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="{StaticResource PagePadding}">
                <!-- 返回按钮 -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal" 
                            Spacing="{StaticResource SmallSpacing}"
                            IsVisible="{Binding CanGoBack}">
                    <Button Command="{Binding GoBackCommand}"
                            Background="Transparent"
                            BorderThickness="{StaticResource NoBorderThickness}"
                            Padding="{StaticResource SmallMargin}"
                            ToolTip.Tip="返回">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                            <TextBlock Text="←" 
                                       FontSize="{StaticResource SubTitleFontSize}" 
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="返回" 
                                       FontSize="{StaticResource LabelFontSize}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Border Width="{StaticResource DividerHeight}" 
                            Height="{StaticResource SmallIconSize}" 
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 页面标题 -->
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentPageTitle}"
                           FontSize="{StaticResource LabelFontSize}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- 行情条（模拟数据；贯穿标题与市场切换器之间的弹性区域，均分分块展示，对齐原型 tb-ticker） -->
                <ItemsControl Grid.Column="2"
                              ItemsSource="{Binding IndexTickers}"
                              IsVisible="{Binding !CanGoBack}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Margin="{StaticResource SmallHorizontalMargin}">
                    <ItemsControl.Styles>
                        <!-- 首块隐藏左侧分隔线（分隔线仅出现在块与块之间） -->
                        <Style Selector="UniformGrid > ContentPresenter:first-child Border.ticker-sep">
                            <Setter Property="IsVisible" Value="False"/>
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IndexTickerItemViewModel">
                            <Panel VerticalAlignment="Center">
                                <!-- 块间竖分隔线（对齐原型 tb-tsep） -->
                                <Border Classes="ticker-sep"
                                        Width="{StaticResource DividerHeight}"
                                        Height="14"
                                        Background="{DynamicResource BorderBrush}"
                                        HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource SmallFontSize}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Price}"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontSize="{StaticResource SmallFontSize}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ChangeText}"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontSize="{StaticResource SmallFontSize}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IsUp}"
                                               Foreground="{StaticResource BullishBrush}"/>
                                    <TextBlock Text="{Binding ChangeText}"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontSize="{StaticResource SmallFontSize}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IsDown}"
                                               Foreground="{StaticResource BearishBrush}"/>
                                </StackPanel>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- A股 / 虚拟币 分段市场切换器（二级页面对齐原型 tb-mkt：与行情条一并隐藏） -->
                <Border Grid.Column="3"
                        Padding="2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceVariantBrush}"
                        CornerRadius="{StaticResource DefaultCornerRadius}"
                        IsVisible="{Binding !CanGoBack}"
                        ToolTip.Tip="快捷键: Ctrl+M">
                    <Border.Styles>
                        <Style Selector="Button.market-switch-btn">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        </Style>
                        <Style Selector="Button.market-switch-btn[IsPressed=true]">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="Button.market-switch-btn.active">
                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </Border.Styles>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="market-switch-btn"
                                Classes.active="{Binding IsAShareMarket}"
                                Command="{Binding SwitchMarketCommand}"
                                CommandParameter="{x:Static infra:MarketType.AShare}"
                                Padding="12,4"
                                CornerRadius="{StaticResource DefaultCornerRadius}"
                                BorderThickness="{StaticResource NoBorderThickness}"
                                AutomationProperties.Name="切换到A股市场">
                            <TextBlock Text="A股"
                                       FontSize="{StaticResource TinyFontSize}"
                                       FontWeight="SemiBold"/>
                        </Button>
                        <Button Classes="market-switch-btn"
                                Classes.active="{Binding IsCryptoMarket}"
                                Command="{Binding SwitchMarketCommand}"
                                CommandParameter="{x:Static infra:MarketType.Crypto}"
                                Padding="12,4"
                                CornerRadius="{StaticResource DefaultCornerRadius}"
                                BorderThickness="{StaticResource NoBorderThickness}"
                                AutomationProperties.Name="切换到虚拟币市场">
                            <TextBlock Text="虚拟币"
                                       FontSize="{StaticResource TinyFontSize}"
                                       FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧内容区域 -->
        <ContentControl Grid.Column="1"
                        Grid.Row="1"
                        Content="{Binding CurrentPage}"
                        ContentTemplate="{StaticResource ViewLocator}"/>
    </Grid>

</Window>
