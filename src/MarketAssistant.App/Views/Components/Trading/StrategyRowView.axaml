<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:converters="using:MarketAssistant.Converters"
             xmlns:models="using:MarketAssistant.Trading.Models"
             mc:Ignorable="d" d:DesignWidth="600"
             x:Class="MarketAssistant.Views.Components.Trading.StrategyRowView"
             x:Name="Root"
             x:DataType="models:TradingStrategy">

    <!-- 策略行：策略配置页、实时监控页与策略执行历史窗口共用同一份标记。
         DataContext 即 TradingStrategy；操作按钮由宿主页经 Actions 注入，
         因此行内命令仍可用 $parent[ItemsControl] 绑定到宿主 ViewModel。 -->
    <UserControl.Resources>
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
        <converters:PriceTextConverter x:Key="PriceTextConverter"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceVariantBrush}"
            BorderThickness="{StaticResource NoBorderThickness}"
            CornerRadius="{StaticResource TinyCornerRadius}"
            Padding="{StaticResource SmallCardPadding}"
            Margin="{StaticResource TinyBottomMargin}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource DefaultSpacing}">

            <StackPanel Grid.Column="0" Spacing="{StaticResource TinySpacing}">
                <!-- 标识：符号 + 类型 + 状态（运行中绿、已暂停橙、失败红、已完成中性） -->
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                    <TextBlock Text="{Binding Symbol}"
                               FontSize="{StaticResource BodySmFontSize}"
                               FontWeight="{DynamicResource WeightTitle}"
                               VerticalAlignment="Center"/>
                    <controls:StatusTag Text="{Binding Type, Converter={StaticResource EnumDescriptionConverter}}"
                                        Classes="info"/>
                    <controls:StatusTag Text="{Binding Status, Converter={StaticResource EnumDescriptionConverter}}"
                                        Classes.success="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:StrategyStatus.Active}}"
                                        Classes.warning="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:StrategyStatus.Paused}}"
                                        Classes.danger="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:StrategyStatus.Failed}}"/>
                </StackPanel>

                <!-- 参数明细：方向 / 触发价（AI 信号等无固定触发价的策略隐藏）/ 数量 / 已执行 -->
                <WrapPanel Classes="meta">
                    <TextBlock Text="{Binding Side, Converter={StaticResource EnumDescriptionConverter}}"/>
                    <TextBlock IsVisible="{Binding HasTriggerPrice}">
                        <Run Text=" · 触发价 "/><Run Text="{Binding TriggerPrice, Converter={StaticResource PriceTextConverter}}"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text=" · "/><Run Text="{Binding QuantityLabel}"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text=" · "/><Run Text="{Binding ExecutionCountText}"/>
                    </TextBlock>
                </WrapPanel>
            </StackPanel>

            <!-- 操作区：由宿主页经 Actions 注入，只读场景留空。用 ElementName 绕开行级 DataContext。 -->
            <ContentPresenter Grid.Column="1"
                              Content="{Binding #Root.Actions}"
                              IsVisible="{Binding #Root.Actions, Converter={x:Static ObjectConverters.IsNotNull}}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</UserControl>
