<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
             x:Class="MarketAssistant.Views.Components.ProgressDisplayView"
             x:Name="Root">

    <UserControl.Styles>
        <!-- 脉动动画样式 -->
        <Style Selector="Ellipse.Pulse">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.8"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- 旋转动画样式 -->
        <Style Selector="Path.Spin">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="{StaticResource DefaultBorderThickness}"
            CornerRadius="{StaticResource DefaultCornerRadius}"
            Padding="{StaticResource ProgressDialogPadding}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="{StaticResource ProgressDialogWidth}">
        
        <StackPanel Spacing="{StaticResource DefaultIconSize}">
            
            <!-- 标题 -->
            <TextBlock Text="🤖 AI 分析中..."
                       FontSize="{StaticResource LargeFontSize}"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource PrimaryBrush}"/>

            <!-- 进度指示器区域 -->
            <StackPanel Spacing="{StaticResource LargeSpacing}" HorizontalAlignment="Center">
                
                <!-- 圆形脉动指示器 -->
                <Grid Width="{StaticResource ProgressCircleSize}" 
                      Height="{StaticResource ProgressCircleSize}"
                      HorizontalAlignment="Center">
                    
                    <!-- 外圆 - 脉动效果 -->
                    <Ellipse Width="{StaticResource ProgressCircleSize}" 
                             Height="{StaticResource ProgressCircleSize}"
                             Fill="{StaticResource PrimaryBrush}"
                             Opacity="0.1"
                             Classes="Pulse"/>
                    
                    <!-- 旋转的 Loading 图标 -->
                    <Path Classes="Spin"
                          Width="{StaticResource MediumIconSize}" Height="{StaticResource MediumIconSize}"
                          Data="M16,4 A12,12 0 1,1 4,16"
                          Stroke="{StaticResource PrimaryBrush}"
                          StrokeThickness="4"
                          StrokeLineCap="Round"
                          RenderTransformOrigin="50%,50%"/>
                </Grid>
            </StackPanel>

            <!-- 进度条 -->
            <StackPanel Spacing="{StaticResource TinySpacing}">
                <ProgressBar Value="{Binding #Root.ProgressPercent}" 
                             Maximum="100" 
                             Height="{StaticResource ProgressBarHeight}" 
                             CornerRadius="{StaticResource TinyCornerRadius}"
                             Foreground="{StaticResource PrimaryBrush}"
                             Background="{DynamicResource SurfaceVariantBrush}"
                             Width="{StaticResource ProgressBarWidth}"/>
                <TextBlock Text="{Binding #Root.ProgressPercent, StringFormat='{}{0}%'}"
                           FontSize="{StaticResource SmallFontSize}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- 阶段说明 -->
            <StackPanel Spacing="{StaticResource SmallSpacing}">
                <TextBlock Text="{Binding #Root.AnalysisStage}"
                           FontSize="{StaticResource LabelFontSize}"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- 失败分析师提示 -->
            <Border Background="{DynamicResource DangerPanelBackgroundBrush}"
                    CornerRadius="{StaticResource SmallCornerRadius}"
                    Padding="{StaticResource CompactCardPadding}"
                    IsVisible="{Binding #Root.FailedAnalystsInfo, 
                        Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding #Root.FailedAnalystsInfo}"
                           FontSize="{StaticResource SmallFontSize}"
                           Foreground="{DynamicResource DangerPanelTextBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- 取消按钮 + 提示信息 -->
            <StackPanel Spacing="{StaticResource SmallSpacing}">
                <Button Content="取消分析"
                        Command="{Binding #Root.CancelCommand}"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        FontSize="{StaticResource SmallFontSize}"
                        Padding="{StaticResource CompactCardPadding}"/>

                <Border Background="{DynamicResource PageBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource DefaultBorderThickness}"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="{StaticResource DefaultCardPadding}">
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Spacing="{StaticResource SmallSpacing}">
                        <TextBlock Text="💡"
                                   FontSize="{StaticResource LabelFontSize}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="分析过程可能需要 1-3 分钟，请耐心等待"
                                   FontSize="{StaticResource SmallFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
