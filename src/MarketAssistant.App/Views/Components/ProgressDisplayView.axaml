<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MarketAssistant.ViewModels"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="360"
             x:Class="MarketAssistant.Views.Components.ProgressDisplayView"
             x:Name="Root">

    <UserControl.Styles>
        <!-- 步骤条：未激活 -->
        <Style Selector="Border.phaseStep">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource TinyCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource ChipPadding}"/>
        </Style>
        <Style Selector="Border.phaseStep TextBlock">
            <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <!-- 步骤条：当前阶段高亮 -->
        <Style Selector="Border.phaseStep.active">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.phaseStep.active TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextOnEmphasisBrush}"/>
            <Setter Property="FontWeight" Value="{DynamicResource WeightEmphasis}"/>
        </Style>
        <!-- 步骤条：已完成。用强调浅底 + 强调色文字，不用 AccentHover 实底
             （蓝字压深蓝底，对比度不足且与"当前"阶段抢注意力） -->
        <Style Selector="Border.phaseStep.done">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        </Style>
        <Style Selector="Border.phaseStep.done TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <!-- 步骤间连接线 -->
        <Style Selector="Border.phaseLink">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="Margin" Value="{StaticResource SmallHorizontalMargin}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style Selector="Border.phaseLink.done">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>
        <!-- 分析师状态行 -->
        <Style Selector="Border.analystRow">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource TinyCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource CompactButtonPadding}"/>
            <Setter Property="Margin" Value="{StaticResource TinyVerticalMargin}"/>
        </Style>
    </UserControl.Styles>
    
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderThickness="{StaticResource NoBorderThickness}"
            CornerRadius="{StaticResource DefaultCornerRadius}"
            Padding="{StaticResource ProgressDialogPadding}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="{StaticResource ProgressDialogWidth}">
        
        <StackPanel Spacing="{StaticResource DefaultSpacing}">

            <!-- 标题 + 标的：等待期间始终能看到分析的是哪只标的 -->
            <StackPanel HorizontalAlignment="Center"
                        Spacing="{StaticResource TinySpacing}">
                <TextBlock Text="AI 分析中..."
                           FontSize="{StaticResource TitleFontSize}"
                           FontWeight="{DynamicResource WeightTitle}"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="{Binding #Root.SubjectText}"
                           FontSize="{StaticResource BodySmFontSize}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsVisible="{Binding #Root.SubjectText,
                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>

            <!-- 流程步骤条：准备 → 分析 → 聚合 → 报告 → 完成 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border x:Name="PhaseStep0" Classes="phaseStep"><TextBlock Text="准备"/></Border>
                <Border x:Name="PhaseLink0" Classes="phaseLink"/>
                <Border x:Name="PhaseStep1" Classes="phaseStep"><TextBlock Text="分析"/></Border>
                <Border x:Name="PhaseLink1" Classes="phaseLink"/>
                <Border x:Name="PhaseStep2" Classes="phaseStep"><TextBlock Text="聚合"/></Border>
                <Border x:Name="PhaseLink2" Classes="phaseLink"/>
                <Border x:Name="PhaseStep3" Classes="phaseStep"><TextBlock Text="报告"/></Border>
                <Border x:Name="PhaseLink3" Classes="phaseLink"/>
                <Border x:Name="PhaseStep4" Classes="phaseStep"><TextBlock Text="完成"/></Border>
            </StackPanel>

            <!-- 大号百分比 + 进度条 -->
            <StackPanel Spacing="{StaticResource SmallSpacing}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding #Root.ProgressPercent}"
                               FontSize="{StaticResource DisplayFontSize}"
                               FontWeight="{DynamicResource WeightNumber}"
                               FontFamily="{StaticResource DataFontFamily}"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="%"
                               FontSize="{StaticResource BodySmFontSize}"
                               FontWeight="{DynamicResource WeightNumber}"
                               Margin="{StaticResource TinyLeftMargin}"
                               VerticalAlignment="Bottom"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <ProgressBar Value="{Binding #Root.ProgressPercent}"
                             Maximum="100"
                             Height="{StaticResource ProgressBarHeight}"
                             CornerRadius="{StaticResource TinyCornerRadius}"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{DynamicResource SurfaceVariantBrush}"/>
            </StackPanel>

            <!-- 阶段说明 -->
            <TextBlock Text="{Binding #Root.AnalysisStage}"
                       FontSize="{StaticResource BodySmFontSize}"
                       FontWeight="{DynamicResource WeightEmphasis}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <!-- 逐分析师状态行：状态由左侧圆点表达，不再叠一个 ✓/✗ 字形 -->
            <ItemsControl ItemsSource="{Binding #Root.AnalystRunItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AnalystRunItemViewModel">
                        <Border Classes="analystRow">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Grid Grid.Column="0" Width="{StaticResource IndicatorSize}" Height="{StaticResource IndicatorSize}" VerticalAlignment="Center">
                                    <!-- 运行中：呼吸点 -->
                                    <Ellipse Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}"
                                             Fill="{StaticResource AccentBrush}"
                                             Classes="PulseDot"
                                             IsVisible="{Binding IsRunning}"/>
                                    <!-- 等待：静默灰点 -->
                                    <Ellipse Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}"
                                             Fill="{DynamicResource TextSecondaryBrush}"
                                             Opacity="0.4"
                                             IsVisible="{Binding IsPending}"/>
                                    <!-- 完成：绿点 -->
                                    <Ellipse Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}"
                                             Fill="{DynamicResource SuccessBrush}"
                                             IsVisible="{Binding IsCompleted}"/>
                                    <!-- 失败：红点 -->
                                    <Ellipse Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}"
                                             Fill="{DynamicResource ErrorBrush}"
                                             IsVisible="{Binding IsFailed}"/>
                                </Grid>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           Margin="{StaticResource SmallLeftMargin}"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding TokensText}"
                                           VerticalAlignment="Center"
                                           Margin="{StaticResource SmallRightMargin}"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           FontFamily="{StaticResource DataFontFamily}"
                                           ToolTip.Tip="该分析师累计 Token 用量"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           IsVisible="{Binding HasTokenUsage}"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding ElapsedText}"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           FontFamily="{StaticResource DataFontFamily}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 运行级 Token 用量摘要 -->
            <StackPanel Spacing="{StaticResource TinySpacing}"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding #Root.UsageSummaryText,
                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding #Root.UsageSummaryText}"
                           FontSize="{StaticResource CaptionFontSize}"
                           FontWeight="{DynamicResource WeightTitle}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding #Root.UsageDetailText}"
                           FontSize="{StaticResource CaptionFontSize}"
                           FontFamily="{StaticResource DataFontFamily}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- 失败分析师提示 -->
            <controls:StatusBanner Severity="Danger"
                                   Message="{Binding #Root.FailedAnalystsInfo}"
                                   IsVisible="{Binding #Root.FailedAnalystsInfo,
                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- 取消按钮：次要操作，不用强调色（强调色此刻是进度本身） -->
            <Button Content="取消分析"
                    Classes="btn-secondary btn-sm"
                    Command="{Binding #Root.CancelCommand}"
                    HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
