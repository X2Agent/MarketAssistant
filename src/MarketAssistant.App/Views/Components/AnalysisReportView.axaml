<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:models="using:MarketAssistant.Models"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:converts="using:MarketAssistant.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Components.AnalysisReportView"
             x:DataType="vm:AnalysisReportViewModel">

    <UserControl.Resources>
        <converts:ScoreToColorConverter x:Key="ScoreToColorConverter"/>
        <x:Double x:Key="ReportScoreFontSize">48</x:Double>
        <x:Double x:Key="ReportLineHeight">24</x:Double>
        <x:Double x:Key="ReportWideLineHeight">26</x:Double>
        <x:Double x:Key="ReportBarHeight">6</x:Double>
        <x:Double x:Key="ReportMiniBarHeight">4</x:Double>
        <CornerRadius x:Key="ReportBarCornerRadius">3</CornerRadius>
        <CornerRadius x:Key="ReportMiniBarCornerRadius">2</CornerRadius>
        <Thickness x:Key="LeftAccentBorderThickness">4,0,0,0</Thickness>
        <Thickness x:Key="ReportHeaderPadding">24,8</Thickness>
        <Thickness x:Key="ReportTagPadding">12,4</Thickness>
        <Thickness x:Key="ReportNoticePadding">12,8</Thickness>
        <Thickness x:Key="ReportBadgePadding">8,4</Thickness>
        <Thickness x:Key="ReportHeroMargin">0,0,0,16</Thickness>
        <Thickness x:Key="ReportMetricMargin">0,0,16,0</Thickness>
        <Thickness x:Key="ReportGridItemMargin">0,0,8,16</Thickness>
        <Thickness x:Key="ReportDividerMargin">8,0,0,16</Thickness>
        <Thickness x:Key="ReportChipMargin">0,0,4,4</Thickness>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 卡片标题样式 -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="{StaticResource MediumFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="{StaticResource SmallBottomMargin}"/>
        </Style>
        
        <!-- 标签样式 -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="{StaticResource SmallFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        
        <!-- 值样式 -->
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="{StaticResource SectionTitleFontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="{StaticResource TinyTopMargin}"/>
        </Style>
        
        <!-- 列表项样式 -->
        <Style Selector="TextBlock.list-item">
            <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="{StaticResource TinyMargin}"/>
        </Style>

        <!-- 卡片阴影样式 -->
        <Style Selector="controls|CardView /template/ Border">
            <Setter Property="BoxShadow" Value="{StaticResource CardBoxShadow}"/>
        </Style>

        <!-- 分析块样式 -->
        <Style Selector="Border.analysis-block">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource DefaultCardPadding}"/>
            <Setter Property="BorderThickness" Value="4,0,0,0"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- 主要内容区域 -->
        <ScrollViewer IsVisible="{Binding IsReportVisible}" Padding="{StaticResource SmallMargin}">
            <StackPanel Margin="{StaticResource DefaultMargin}" Spacing="{StaticResource LargeSpacing}">
                
                <!-- 1. 核心仪表盘 (Hero Section) -->
                <controls:CardView>
                    <Grid ColumnDefinitions="2*,3*" ColumnSpacing="{StaticResource LargeSpacing}">
                        <!-- 左侧：评级与分数 -->
                        <Grid Grid.Column="0" RowDefinitions="Auto,Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 投资评级徽章 -->
                            <Border Grid.Row="0" 
                                    Background="{StaticResource PrimaryBrush}" 
                                    CornerRadius="{StaticResource LargeCornerRadius}"
                                    Padding="{StaticResource ReportHeaderPadding}"
                                    HorizontalAlignment="Center"
                                    Margin="{StaticResource ReportHeroMargin}">
                                <TextBlock Text="{Binding InvestmentRating}" 
                                           FontSize="{StaticResource ExtraLargeFontSize}" 
                                           FontWeight="Bold" 
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            
                            <!-- 综合评分 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{StaticResource SmallSpacing}">
                                <TextBlock Text="{Binding OverallScore, StringFormat='{}{0:F1}'}" 
                                           FontSize="{StaticResource ReportScoreFontSize}" 
                                           FontWeight="Heavy" 
                                           Foreground="{Binding OverallScore, Converter={StaticResource ScoreToColorConverter}}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="/10" FontSize="{StaticResource SectionTitleFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="综合评分" FontSize="{StaticResource SmallFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 右侧：关键指标列表 -->
                        <StackPanel Grid.Column="1" Spacing="{StaticResource DefaultSpacing}" VerticalAlignment="Center">
                            
                            <!-- 第一行：目标价格与风险等级 -->
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- 目标价格 -->
                                <StackPanel Grid.Column="0" Margin="{StaticResource ReportMetricMargin}">
                                    <TextBlock Text="目标价格" Classes="label"/>
                                    <TextBlock Text="{Binding TargetPrice}" 
                                               Classes="value" 
                                               FontSize="{StaticResource LabelFontSize}"
                                               TextWrapping="Wrap"
                                               LineHeight="{StaticResource DefaultLineHeight}"/>
                                </StackPanel>

                                <!-- 风险等级 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="风险等级" Classes="label" HorizontalAlignment="Center"/>
                                    <Border Background="{DynamicResource SurfaceVariantBrush}" 
                                            CornerRadius="{StaticResource TinyCornerRadius}" 
                                            Padding="{StaticResource ReportTagPadding}" 
                                            Margin="{StaticResource TinyTopMargin}">
                                        <TextBlock Text="{Binding RiskLevel}" 
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource ErrorBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- 分割线 -->
                            <Border Height="{StaticResource DividerHeight}" Background="{DynamicResource BorderBrush}" Opacity="0.5"/>

                            <!-- 价格预期 -->
                            <StackPanel>
                                <TextBlock Text="价格预期" Classes="label"/>
                                <TextBlock Text="{Binding PriceChangeExpectation}" 
                                           Classes="value" 
                                           FontSize="{StaticResource BodyFontSize}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>

                            <!-- 投资期限 -->
                            <StackPanel>
                                <TextBlock Text="投资期限" Classes="label"/>
                                <TextBlock Text="{Binding TimeHorizon}" 
                                           Classes="value" 
                                           FontSize="{StaticResource BodyFontSize}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </controls:CardView>

                <!-- 2. 维度评分与操作建议 -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource LargeSpacing}">
                    <!-- 维度评分 (Skill Bars) -->
                    <controls:CardView Grid.Column="0">
                        <StackPanel Spacing="{StaticResource DefaultSpacing}">
                            <TextBlock Text="📊 维度评分" Classes="section-title"/>
                            <ItemsControl ItemsSource="{Binding DimensionScores}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScoreItem">
                                        <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource BottomMargin}">
                                            <Grid ColumnDefinitions="*,Auto" Margin="{StaticResource TinyBottomMargin}">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding FormattedScore}" 
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Score, Converter={StaticResource ScoreToColorConverter}}"/>
                                            </Grid>
                                            <ProgressBar Grid.Row="1" 
                                                         Value="{Binding Score}" 
                                                         Maximum="10" 
                                                         Height="{StaticResource ReportBarHeight}" 
                                                         CornerRadius="{StaticResource ReportBarCornerRadius}"
                                                         Foreground="{Binding Score, Converter={StaticResource ScoreToColorConverter}}"
                                                         Background="{DynamicResource SurfaceVariantBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </controls:CardView>

                    <!-- 操作建议 (Step List) -->
                    <controls:CardView Grid.Column="1">
                        <StackPanel Spacing="{StaticResource DefaultSpacing}">
                            <TextBlock Text="📋 操作建议" Classes="section-title"/>
                            <ItemsControl ItemsSource="{Binding OperationSuggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="Auto,*" Margin="{StaticResource BottomMargin}">
                                            <Border Grid.Column="0" 
                                                    Width="{StaticResource DefaultIconSize}" Height="{StaticResource DefaultIconSize}" 
                                                    CornerRadius="{StaticResource DefaultCornerRadius}" 
                                                    Background="{StaticResource PrimaryLightBrush}"
                                                    Margin="{StaticResource RightMargin}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="✓" 
                                                           Foreground="White" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"
                                                           FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding .}" 
                                                       TextWrapping="Wrap" 
                                                       LineHeight="{StaticResource DefaultLineHeight}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </controls:CardView>
                </Grid>

                <!-- 3. 投资亮点与风险因素 (SWOT Style) -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource LargeSpacing}">
                    <!-- 亮点 -->
                    <controls:CardView Grid.Column="0">
                        <StackPanel Spacing="{StaticResource DefaultSpacing}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                                <TextBlock Text="💡" FontSize="{StaticResource LargeFontSize}"/>
                                <TextBlock Text="投资亮点" Classes="section-title" Margin="0"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding InvestmentHighlights}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="{DynamicResource SuccessPanelBackgroundBrush}" 
                                                CornerRadius="{StaticResource SmallCornerRadius}" 
                                                Padding="{StaticResource ReportNoticePadding}" 
                                                Margin="{StaticResource SmallBottomMargin}"
                                                BorderBrush="{DynamicResource SuccessPanelBorderBrush}"
                                                BorderThickness="{StaticResource DefaultBorderThickness}">
                                            <TextBlock Text="{Binding .}" 
                                                       TextWrapping="Wrap" 
                                                       Foreground="{DynamicResource SuccessPanelTextBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </controls:CardView>

                    <!-- 风险 -->
                    <controls:CardView Grid.Column="1">
                        <StackPanel Spacing="{StaticResource DefaultSpacing}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                                <TextBlock Text="⚠️" FontSize="{StaticResource LargeFontSize}"/>
                                <TextBlock Text="风险因素" Classes="section-title" Margin="0"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding RiskFactors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="{DynamicResource DangerPanelBackgroundBrush}" 
                                                CornerRadius="{StaticResource SmallCornerRadius}" 
                                                Padding="{StaticResource ReportNoticePadding}" 
                                                Margin="{StaticResource SmallBottomMargin}"
                                                BorderBrush="{DynamicResource DangerPanelBorderBrush}"
                                                BorderThickness="{StaticResource DefaultBorderThickness}">
                                            <TextBlock Text="{Binding .}" 
                                                       TextWrapping="Wrap" 
                                                       Foreground="{DynamicResource DangerPanelTextBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </controls:CardView>
                </Grid>

                <!-- 4. 深度分析 (Narrative) -->
                <controls:CardView>
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*">
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                                   Text="深度分析报告" Classes="section-title" 
                                   Margin="{StaticResource ReportHeroMargin}"/>
                        
                        <!-- 共识与分歧 -->
                        <!-- 核心共识 -->
                        <Border Grid.Row="1" Grid.Column="0" 
                                Classes="analysis-block"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                Margin="{StaticResource ReportGridItemMargin}"
                                IsVisible="{Binding HasConsensusAnalysis}">
                            <StackPanel Spacing="{StaticResource SmallSpacing}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                                    <TextBlock Text="🤝" FontSize="{StaticResource SubTitleFontSize}"/>
                                    <TextBlock Text="核心共识" FontWeight="Bold" FontSize="{StaticResource SectionTitleFontSize}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ConsensusAnalysis}" 
                                           TextWrapping="Wrap" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           LineHeight="{StaticResource ReportLineHeight}"/>
                            </StackPanel>
                        </Border>

                        <!-- 主要分歧 -->
                        <Border Grid.Row="1" Grid.Column="1" 
                                Classes="analysis-block"
                                BorderBrush="{StaticResource WarningBrush}"
                                Margin="{StaticResource ReportDividerMargin}"
                                IsVisible="{Binding HasDisagreementAnalysis}">
                            <StackPanel Spacing="{StaticResource SmallSpacing}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                                    <TextBlock Text="⚖️" FontSize="{StaticResource SubTitleFontSize}"/>
                                    <TextBlock Text="主要分歧" FontWeight="Bold" FontSize="{StaticResource SectionTitleFontSize}" Foreground="{DynamicResource WarningPanelTextBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DisagreementAnalysis}" 
                                           TextWrapping="Wrap" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           LineHeight="{StaticResource ReportLineHeight}"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- 综合总结 -->
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                Classes="analysis-block"
                                BorderBrush="{StaticResource PrimaryDarkBrush}"
                                Background="{DynamicResource SelectedBackgroundBrush}">
                            <StackPanel Spacing="{StaticResource SmallSpacing}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                                    <TextBlock Text="📝" FontSize="{StaticResource SubTitleFontSize}"/>
                                    <TextBlock Text="协调分析师综述" FontWeight="Bold" FontSize="{StaticResource SectionTitleFontSize}" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CoordinatorSummary}" 
                                           TextWrapping="Wrap" 
                                           LineHeight="{StaticResource ReportWideLineHeight}"
                                           FontSize="{StaticResource BodyFontSize}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </controls:CardView>
                <!-- 5. 分析质量评估 -->
                <controls:CardView IsVisible="{Binding HasQualityMetrics}">
                    <StackPanel Spacing="{StaticResource DefaultSpacing}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="🔍" FontSize="{StaticResource LargeFontSize}"/>
                            <TextBlock Text="分析质量评估" Classes="section-title" Margin="0"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource LargeSpacing}">
                            <!-- 数据完整度 -->
                            <StackPanel Grid.Column="0" Spacing="{StaticResource TinySpacing}">
                                <TextBlock Text="数据完整度" Classes="label"/>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                                    <TextBlock Text="{Binding DataCompletenessPercent, StringFormat='{}{0}%'}" 
                                               Classes="value" FontSize="{StaticResource SectionTitleFontSize}"/>
                                </StackPanel>
                                <ProgressBar Value="{Binding DataCompletenessPercent}" 
                                             Maximum="100" Height="{StaticResource ReportMiniBarHeight}" CornerRadius="{StaticResource ReportMiniBarCornerRadius}"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             Background="{DynamicResource SurfaceVariantBrush}"/>
                            </StackPanel>

                            <!-- 分析师一致性 -->
                            <StackPanel Grid.Column="1" Spacing="{StaticResource TinySpacing}">
                                <TextBlock Text="分析师一致性" Classes="label"/>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                                    <TextBlock Text="{Binding AnalystConsensusPercent, StringFormat='{}{0}%'}" 
                                               Classes="value" FontSize="{StaticResource SectionTitleFontSize}"/>
                                </StackPanel>
                                <ProgressBar Value="{Binding AnalystConsensusPercent}" 
                                             Maximum="100" Height="{StaticResource ReportMiniBarHeight}" CornerRadius="{StaticResource ReportMiniBarCornerRadius}"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             Background="{DynamicResource SurfaceVariantBrush}"/>
                            </StackPanel>

                            <!-- 综合质量等级 -->
                            <StackPanel Grid.Column="2" Spacing="{StaticResource TinySpacing}">
                                <TextBlock Text="综合质量" Classes="label"/>
                                <Border Background="{DynamicResource SurfaceVariantBrush}" 
                                        CornerRadius="{StaticResource TinyCornerRadius}" Padding="{StaticResource ReportBadgePadding}" HorizontalAlignment="Left"
                                        Margin="{StaticResource TinyTopMargin}">
                                    <TextBlock Text="{Binding QualityLevelText}" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 缺失数据维度 -->
                        <StackPanel IsVisible="{Binding MissingDataDimensions.Count}" Spacing="{StaticResource TinySpacing}">
                            <TextBlock Text="缺失数据维度" Classes="label"/>
                            <ItemsControl ItemsSource="{Binding MissingDataDimensions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="{StaticResource WarningLightBrush}"
                                                CornerRadius="{StaticResource TinyCornerRadius}" Padding="{StaticResource ReportBadgePadding}" Margin="{StaticResource ReportChipMargin}">
                                            <TextBlock Text="{Binding .}" 
                                                       FontSize="{StaticResource SmallFontSize}"
                                                       Foreground="{StaticResource WarningDeepTextBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 局限性说明 -->
                        <Border Background="{DynamicResource PageBackgroundBrush}"
                                CornerRadius="{StaticResource SmallCornerRadius}"
                                Padding="{StaticResource CompactCardPadding}"
                                IsVisible="{Binding LimitationsNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                                <TextBlock Text="⚠️" FontSize="{StaticResource LabelFontSize}" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding LimitationsNote}" 
                                           TextWrapping="Wrap"
                                           FontSize="{StaticResource SmallFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </controls:CardView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
