<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Components.AnalysisReportView"
             x:DataType="vm:AnalysisReportViewModel">

    <UserControl.Resources>
        <Thickness x:Key="ReportHeroMargin">0,0,0,16</Thickness>
        <Thickness x:Key="ReportMetricMargin">0,0,16,0</Thickness>
        <Thickness x:Key="ReportTagPadding">12,4</Thickness>
        <Thickness x:Key="ReportNoticePadding">12,8</Thickness>
        <Thickness x:Key="ReportBadgePadding">8,4</Thickness>
        <Thickness x:Key="ReportHeroPadding">24,8</Thickness>
        <Thickness x:Key="ReportChipMargin">0,0,4,4</Thickness>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 报告内的小节标题：比 card-title 低一级，用于同一卡片内的分区 -->
        <Style Selector="TextBlock.subsection-title">
            <Setter Property="FontSize" Value="{StaticResource BodySmFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource WeightTitle}"/>
            <Setter Property="Margin" Value="{StaticResource SmallBottomMargin}"/>
        </Style>

        <!-- 标签样式 -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <!-- 值样式：数值用等宽档，语义色不参与——层级靠字重与字号 -->
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource WeightNumber}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="{StaticResource TinyTopMargin}"/>
        </Style>

        <!-- 评级徽章：语义浅底 + 同色文字（与涨跌标签同几何）。
             中性评级不套语义色——中性不是"数据语义"，用中性色块表达。 -->
        <Style Selector="Border.ratingBadge">
            <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource ReportHeroPadding}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="{StaticResource ReportHeroMargin}"/>
        </Style>
        <Style Selector="Border.ratingBadge.tonePositive">
            <Setter Property="Background" Value="{StaticResource BullishTagBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.ratingBadge.tonePositive TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BullishBrush}"/>
        </Style>
        <Style Selector="Border.ratingBadge.toneNegative">
            <Setter Property="Background" Value="{StaticResource BearishTagBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.ratingBadge.toneNegative TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BearishBrush}"/>
        </Style>
        <Style Selector="Border.ratingBadge.toneNeutral">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
        </Style>
        <Style Selector="Border.ratingBadge.toneNeutral TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Border.ratingBadge TextBlock">
            <Setter Property="FontSize" Value="{StaticResource DisplayFontSize}"/>
            <Setter Property="LineHeight" Value="{StaticResource DisplayLineHeight}"/>
            <Setter Property="FontWeight" Value="{DynamicResource WeightTitle}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- 分析块：v3 无描边，靠表面色阶分区 -->
        <Style Selector="Border.analysis-block">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource DefaultCardPadding}"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <ScrollViewer IsVisible="{Binding IsReportVisible}" Padding="{StaticResource PagePadding}">
            <StackPanel Spacing="{StaticResource SectionSpacing}">

                <!-- 1. 核心仪表盘 (Hero Section) -->
                <controls:CardView>
                    <StackPanel Spacing="{StaticResource LargeSpacing}">

                        <!-- 标的信息行：解决"报告看完不知道是哪只票、什么时候生成的" -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{StaticResource SmallSpacing}"
                                    IsVisible="{Binding HasReportHeader}">
                            <TextBlock Text="{Binding AssetName}"
                                       FontSize="{StaticResource BodyFontSize}"
                                       FontWeight="{DynamicResource WeightTitle}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasAssetName}"/>
                            <Border Background="{DynamicResource SurfaceVariantBrush}"
                                    CornerRadius="{StaticResource TinyCornerRadius}"
                                    Padding="{StaticResource ReportTagPadding}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding StockSymbol}"
                                           Classes="caption"
                                           FontFamily="{StaticResource DataFontFamily}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding ReportCreatedAtText}"
                                       Classes="caption"
                                       FontFamily="{StaticResource DataFontFamily}"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="报告生成时间"/>
                        </StackPanel>

                        <controls:PageGrid ColumnSpacing="{StaticResource GridGutter}">
                            <!-- 左侧：评级与分数。评级承担唯一的数据语义色，分数只靠字号与字重 -->
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="4"
                                        Spacing="{StaticResource DefaultSpacing}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Classes="ratingBadge"
                                        Classes.tonePositive="{Binding IsRatingPositive}"
                                        Classes.toneNegative="{Binding IsRatingNegative}"
                                        Classes.toneNeutral="{Binding IsRatingNeutral}">
                                    <TextBlock Text="{Binding InvestmentRating}"/>
                                </Border>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="{StaticResource SmallSpacing}">
                                    <TextBlock Text="{Binding OverallScore, StringFormat='{}{0:F1}'}"
                                               FontSize="{StaticResource DisplayFontSize}"
                                               LineHeight="{StaticResource DisplayLineHeight}"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontWeight="{DynamicResource WeightNumber}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="/10"
                                                   Classes="body-sm"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="综合评分"
                                                   Classes="caption"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- 右侧：关键指标 -->
                            <Grid Grid.Column="4" Grid.ColumnSpan="8"
                                  ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="{StaticResource LargeSpacing}"
                                  RowSpacing="{StaticResource DefaultSpacing}"
                                  VerticalAlignment="Center">

                                <!-- 目标价格 -->
                                <StackPanel Grid.Row="0" Grid.Column="0"
                                            Margin="{StaticResource ReportMetricMargin}"
                                            IsVisible="{Binding HasTargetPrice}">
                                    <TextBlock Text="目标价格" Classes="label"/>
                                    <TextBlock Text="{Binding TargetPrice}"
                                               Classes="value"
                                               TextWrapping="Wrap"
                                               LineHeight="{StaticResource BodySmLineHeight}"/>
                                </StackPanel>

                                <!-- 风险等级 -->
                                <StackPanel Grid.Row="0" Grid.Column="1" IsVisible="{Binding HasRiskLevel}">
                                    <TextBlock Text="风险等级" Classes="label"/>
                                    <Border Background="{DynamicResource SurfaceVariantBrush}"
                                            HorizontalAlignment="Left"
                                            CornerRadius="{StaticResource TinyCornerRadius}"
                                            Padding="{StaticResource ReportTagPadding}"
                                            Margin="{StaticResource TinyTopMargin}">
                                        <TextBlock Text="{Binding RiskLevel}"
                                                   FontWeight="{DynamicResource WeightTitle}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- 置信度：此前有值却未展示 -->
                                <StackPanel Grid.Row="1" Grid.Column="0"
                                            Margin="{StaticResource ReportMetricMargin}"
                                            IsVisible="{Binding HasConfidence}">
                                    <TextBlock Text="置信度" Classes="label"/>
                                    <TextBlock Text="{Binding ConfidenceText}"
                                               Classes="value"
                                               FontFamily="{StaticResource DataFontFamily}"/>
                                </StackPanel>

                                <!-- 投资期限 -->
                                <StackPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding HasTimeHorizon}">
                                    <TextBlock Text="投资期限" Classes="label"/>
                                    <TextBlock Text="{Binding TimeHorizon}"
                                               Classes="value"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- 价格预期 -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                            IsVisible="{Binding HasPriceChangeExpectation}">
                                    <TextBlock Text="价格预期" Classes="label"/>
                                    <TextBlock Text="{Binding PriceChangeExpectation}"
                                               Classes="value"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </controls:PageGrid>
                    </StackPanel>
                </controls:CardView>

                <!-- 本次分析的模型调用量（Token 用量） -->
                <Border IsVisible="{Binding HasTokenUsage}"
                        Background="{DynamicResource SurfaceVariantBrush}"
                        CornerRadius="{StaticResource DefaultCornerRadius}"
                        Padding="{StaticResource ReportNoticePadding}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SmallSpacing}">
                        <svg:Svg Grid.Column="0"
                                 Path="/Assets/Images/icon_bolt.svg"
                                 Width="{StaticResource SmallIconSize}"
                                 Height="{StaticResource SmallIconSize}"
                                 VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TokenUsageSummary}"
                                       FontSize="{StaticResource CaptionFontSize}"
                                       FontWeight="{DynamicResource WeightTitle}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding TokenUsageDetail}"
                                       FontSize="{StaticResource CaptionFontSize}"
                                       FontFamily="{StaticResource DataFontFamily}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource HoverBackgroundBrush}"
                                CornerRadius="{StaticResource TinyCornerRadius}"
                                Padding="{StaticResource ReportBadgePadding}"
                                IsVisible="{Binding TokenUsageIsEstimated}">
                            <TextBlock Text="估算值"
                                       FontSize="{StaticResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. 维度评分与操作建议 -->
                <controls:PageGrid ColumnSpacing="{StaticResource GridGutter}">
                    <!-- 维度评分 (Skill Bars) -->
                    <controls:CardView Grid.Column="0" Grid.ColumnSpan="6">
                        <StackPanel Spacing="{StaticResource DefaultSpacing}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                                <svg:Svg Path="/Assets/Images/icon_chart.svg"
                                         Width="{StaticResource DefaultIconSize}"
                                         Height="{StaticResource DefaultIconSize}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="维度评分" Classes="card-title"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding DimensionScores}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScoreItem">
                                        <Grid RowDefinitions="Auto,Auto" Margin="{StaticResource BottomMargin}">
                                            <Grid ColumnDefinitions="*,Auto" Margin="{StaticResource TinyBottomMargin}">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="{DynamicResource WeightTitle}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FormattedScore}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontWeight="{DynamicResource WeightNumber}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Grid>
                                            <ProgressBar Grid.Row="1"
                                                         Value="{Binding Score}"
                                                         Maximum="10"
                                                         Height="{StaticResource ProgressBarHeight}"
                                                         CornerRadius="{StaticResource TinyCornerRadius}"
                                                         Foreground="{StaticResource AccentBrush}"
                                                         Background="{DynamicResource SurfaceVariantBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </controls:CardView>

                    <!-- 操作建议 (Step List) -->
                    <controls:CardView Grid.Column="6" Grid.ColumnSpan="6">
                        <StackPanel Spacing="{StaticResource DefaultSpacing}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                                <svg:Svg Path="/Assets/Images/icon_clipboard.svg"
                                         Width="{StaticResource DefaultIconSize}"
                                         Height="{StaticResource DefaultIconSize}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="操作建议" Classes="card-title"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding OperationSuggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="Auto,*" Margin="{StaticResource BottomMargin}">
                                            <Border Grid.Column="0"
                                                    Width="{StaticResource DefaultIconSize}"
                                                    Height="{StaticResource DefaultIconSize}"
                                                    CornerRadius="{StaticResource DefaultCornerRadius}"
                                                    Background="{DynamicResource AccentSubtleBrush}"
                                                    Margin="{StaticResource RightMargin}"
                                                    VerticalAlignment="Top">
                                                <PathIcon Data="{StaticResource CheckIcon}"
                                                          Foreground="{StaticResource AccentBrush}"
                                                          Width="{StaticResource TinyIconSize}"
                                                          Height="{StaticResource TinyIconSize}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding .}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="{StaticResource BodySmLineHeight}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </controls:CardView>
                </controls:PageGrid>

                <!-- 3. 投资亮点与风险因素 (SWOT Style) -->
                <controls:PageGrid ColumnSpacing="{StaticResource GridGutter}">
                    <!-- 亮点 -->
                    <controls:CardView Grid.Column="0" Grid.ColumnSpan="6">
                        <StackPanel Spacing="{StaticResource DefaultSpacing}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                                <svg:Svg Path="/Assets/Images/icon_bulb.svg"
                                         Width="{StaticResource TitleFontSize}"
                                         Height="{StaticResource TitleFontSize}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="投资亮点" Classes="card-title" Margin="{StaticResource NoMargin}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding InvestmentHighlights}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="{DynamicResource SuccessPanelBackgroundBrush}"
                                                CornerRadius="{StaticResource SmallCornerRadius}"
                                                Padding="{StaticResource ReportNoticePadding}"
                                                Margin="{StaticResource SmallBottomMargin}"
                                                BorderThickness="{StaticResource NoBorderThickness}">
                                            <TextBlock Text="{Binding .}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SuccessPanelTextBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </controls:CardView>

                    <!-- 风险 -->
                    <controls:CardView Grid.Column="6" Grid.ColumnSpan="6">
                        <StackPanel Spacing="{StaticResource DefaultSpacing}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                                <svg:Svg Path="/Assets/Images/icon_danger.svg"
                                         Width="{StaticResource TitleFontSize}"
                                         Height="{StaticResource TitleFontSize}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="风险因素" Classes="card-title" Margin="{StaticResource NoMargin}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding RiskFactors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="{DynamicResource DangerPanelBackgroundBrush}"
                                                CornerRadius="{StaticResource SmallCornerRadius}"
                                                Padding="{StaticResource ReportNoticePadding}"
                                                Margin="{StaticResource SmallBottomMargin}"
                                                BorderThickness="{StaticResource NoBorderThickness}">
                                            <TextBlock Text="{Binding .}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource DangerPanelTextBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </controls:CardView>
                </controls:PageGrid>

                <!-- 4. 深度分析 (Narrative) -->
                <controls:CardView>
                    <StackPanel Spacing="{StaticResource DefaultSpacing}">
                        <TextBlock Text="深度分析报告" Classes="card-title"/>

                        <controls:PageGrid ColumnSpacing="{StaticResource GridGutter}"
                                           RowSpacing="{StaticResource GridGutter}"
                                           RowDefinitions="Auto,Auto">
                            <!-- 核心共识 -->
                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6"
                                    Classes="analysis-block"
                                    IsVisible="{Binding HasConsensusAnalysis}">
                                <StackPanel Spacing="{StaticResource SmallSpacing}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                                        <svg:Svg Path="/Assets/Images/icon_users.svg"
                                                 Width="{StaticResource BodyFontSize}"
                                                 Height="{StaticResource BodyFontSize}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="核心共识"
                                                   FontWeight="{DynamicResource WeightTitle}"
                                                   FontSize="{StaticResource BodyFontSize}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ConsensusAnalysis}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               LineHeight="{StaticResource BodyLineHeight}"/>
                                </StackPanel>
                            </Border>

                            <!-- 主要分歧 -->
                            <Border Grid.Row="0" Grid.Column="6" Grid.ColumnSpan="6"
                                    Classes="analysis-block"
                                    IsVisible="{Binding HasDisagreementAnalysis}">
                                <StackPanel Spacing="{StaticResource SmallSpacing}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                                        <svg:Svg Path="/Assets/Images/icon_scale.svg"
                                                 Width="{StaticResource BodyFontSize}"
                                                 Height="{StaticResource BodyFontSize}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="主要分歧"
                                                   FontWeight="{DynamicResource WeightTitle}"
                                                   FontSize="{StaticResource BodyFontSize}"
                                                   Foreground="{DynamicResource WarningPanelTextBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DisagreementAnalysis}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               LineHeight="{StaticResource BodyLineHeight}"/>
                                </StackPanel>
                            </Border>

                            <!-- 综合总结：强调色浅底标记"这是结论"，不是"这是选中项" -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="12"
                                    Classes="analysis-block"
                                    Background="{DynamicResource AccentSubtleBrush}">
                                <StackPanel Spacing="{StaticResource SmallSpacing}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                                        <svg:Svg Path="/Assets/Images/icon_edit.svg"
                                                 Width="{StaticResource BodyFontSize}"
                                                 Height="{StaticResource BodyFontSize}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="协调分析师综述"
                                                   FontWeight="{DynamicResource WeightTitle}"
                                                   FontSize="{StaticResource BodyFontSize}"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CoordinatorSummary}"
                                               TextWrapping="Wrap"
                                               LineHeight="{StaticResource BodyLineHeight}"
                                               FontSize="{StaticResource BodyFontSize}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </controls:PageGrid>
                    </StackPanel>
                </controls:CardView>

                <!-- 5. 分析质量评估 -->
                <controls:CardView IsVisible="{Binding HasQualityMetrics}">
                    <StackPanel Spacing="{StaticResource DefaultSpacing}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                            <svg:Svg Path="/Assets/Images/icon_magnifier.svg"
                                     Width="{StaticResource TitleFontSize}"
                                     Height="{StaticResource TitleFontSize}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="分析质量评估" Classes="card-title" Margin="{StaticResource NoMargin}"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource LargeSpacing}">
                            <!-- 数据完整度 -->
                            <StackPanel Grid.Column="0" Spacing="{StaticResource TinySpacing}">
                                <TextBlock Text="数据完整度" Classes="label"/>
                                <TextBlock Text="{Binding DataCompletenessPercent, StringFormat='{}{0}%'}"
                                           Classes="value"
                                           FontFamily="{StaticResource DataFontFamily}"/>
                                <ProgressBar Value="{Binding DataCompletenessPercent}"
                                             Maximum="100"
                                             Height="{StaticResource ProgressBarHeight}"
                                             CornerRadius="{StaticResource TinyCornerRadius}"
                                             Foreground="{StaticResource AccentBrush}"
                                             Background="{DynamicResource SurfaceVariantBrush}"/>
                            </StackPanel>

                            <!-- 分析师一致性 -->
                            <StackPanel Grid.Column="1" Spacing="{StaticResource TinySpacing}">
                                <TextBlock Text="分析师一致性" Classes="label"/>
                                <TextBlock Text="{Binding AnalystConsensusPercent, StringFormat='{}{0}%'}"
                                           Classes="value"
                                           FontFamily="{StaticResource DataFontFamily}"/>
                                <ProgressBar Value="{Binding AnalystConsensusPercent}"
                                             Maximum="100"
                                             Height="{StaticResource ProgressBarHeight}"
                                             CornerRadius="{StaticResource TinyCornerRadius}"
                                             Foreground="{StaticResource AccentBrush}"
                                             Background="{DynamicResource SurfaceVariantBrush}"/>
                            </StackPanel>

                            <!-- 综合质量等级 -->
                            <StackPanel Grid.Column="2" Spacing="{StaticResource TinySpacing}">
                                <TextBlock Text="综合质量" Classes="label"/>
                                <Border Background="{DynamicResource SurfaceVariantBrush}"
                                        CornerRadius="{StaticResource TinyCornerRadius}"
                                        Padding="{StaticResource ReportBadgePadding}"
                                        HorizontalAlignment="Left"
                                        Margin="{StaticResource TinyTopMargin}">
                                    <TextBlock Text="{Binding QualityLevelText}"
                                               FontWeight="{DynamicResource WeightTitle}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 缺失数据维度 -->
                        <StackPanel IsVisible="{Binding HasMissingDataDimensions}"
                                    Spacing="{StaticResource TinySpacing}">
                            <TextBlock Text="缺失数据维度" Classes="label"/>
                            <ItemsControl ItemsSource="{Binding MissingDataDimensions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="{DynamicResource WarningPanelBackgroundBrush}"
                                                CornerRadius="{StaticResource TinyCornerRadius}"
                                                Padding="{StaticResource ReportBadgePadding}"
                                                Margin="{StaticResource ReportChipMargin}">
                                            <TextBlock Text="{Binding .}"
                                                       FontSize="{StaticResource CaptionFontSize}"
                                                       Foreground="{DynamicResource WarningPanelTextBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 局限性说明 -->
                        <Border Background="{DynamicResource PageBackgroundBrush}"
                                CornerRadius="{StaticResource SmallCornerRadius}"
                                Padding="{StaticResource CompactCardPadding}"
                                IsVisible="{Binding LimitationsNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                                <svg:Svg Path="/Assets/Images/icon_warning.svg"
                                         Width="{StaticResource BodySmFontSize}"
                                         Height="{StaticResource BodySmFontSize}"
                                         VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding LimitationsNote}"
                                           TextWrapping="Wrap"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </controls:CardView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
