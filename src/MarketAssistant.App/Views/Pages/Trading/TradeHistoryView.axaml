<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels.Trading"
             xmlns:models="using:MarketAssistant.Trading.Models"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.Trading.TradeHistoryView"
             x:DataType="vm:TradeHistoryViewModel">

    <UserControl.Resources>
        <x:Double x:Key="FilterComboWidth">220</x:Double>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- 筛选工具栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource DefaultBorderThickness}"
                CornerRadius="{StaticResource SmallCornerRadius}"
                Padding="{StaticResource SmallPadding}"
                Margin="{StaticResource SmallBottomMargin}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding FilterSymbol}"
                         PlaceholderText="按交易对筛选（如 BTCUSDT）"
                         Width="{StaticResource FilterComboWidth}"/>
                <Button Grid.Column="1"
                        Content="筛选"
                        Command="{Binding FilterCommand}"
                        Classes="btn-primary"
                        Margin="{StaticResource SmallLeftMargin}"/>
                <Button Grid.Column="2"
                        Content="清除"
                        Command="{Binding ClearFilterCommand}"
                        Margin="{StaticResource TinyLeftMargin}"/>
                <TextBlock Grid.Column="4"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{StaticResource SmallFontSize}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="今日: {0}笔 | 盈亏: {1:F2} USDT">
                            <Binding Path="TodayStats.TradeCount"/>
                            <Binding Path="TodayStats.TotalPnl"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 记录列表 -->
        <Panel Grid.Row="1">
            <!-- 首屏骨架：5 行记录占位 -->
            <StackPanel Spacing="{StaticResource TinySpacing}"
                        IsVisible="{Binding IsInitialLoading}">
                <Border Classes="skeleton skeleton-row" Height="88"/>
                <Border Classes="skeleton skeleton-row" Height="88"/>
                <Border Classes="skeleton skeleton-row" Height="88"/>
                <Border Classes="skeleton skeleton-row" Height="88"/>
                <Border Classes="skeleton skeleton-row" Height="88"/>
            </StackPanel>

            <ScrollViewer IsVisible="{Binding !IsInitialLoading}">
                <ItemsControl ItemsSource="{Binding Records}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:TradeRecord">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    CornerRadius="{StaticResource SmallCornerRadius}"
                                    Padding="{StaticResource DefaultCardPadding}"
                                    Margin="{StaticResource TinyBottomMargin}">
                                <StackPanel Spacing="{StaticResource TinySpacing}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                    Spacing="{StaticResource SmallSpacing}">
                                            <TextBlock Text="{Binding Symbol}"
                                                       FontWeight="Bold"
                                                       FontSize="{StaticResource SectionTitleFontSize}"/>
                                            <Border CornerRadius="{StaticResource TinyCornerRadius}"
                                                    Padding="{StaticResource TagPadding}">
                                                <TextBlock Text="{Binding Side}"
                                                           FontSize="{StaticResource SmallFontSize}"/>
                                            </Border>
                                            <Border CornerRadius="{StaticResource TinyCornerRadius}"
                                                    Padding="{StaticResource TagPadding}">
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="{StaticResource SmallFontSize}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource SmallFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:yyyy-MM-dd HH:mm:ss}">
                                                    <Binding Path="CreatedAt"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>

                                    <TextBlock FontSize="{StaticResource SmallFontSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="请求: {0:F6} | 成交: {1:F6} @ {2:F4} | 手续费: {3:F6} {4}">
                                                <Binding Path="RequestedQty"/>
                                                <Binding Path="ExecutedQty"/>
                                                <Binding Path="ExecutedPrice"/>
                                                <Binding Path="Commission"/>
                                                <Binding Path="CommissionAsset"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <!-- AI 推理展开 -->
                                    <Expander Header="AI 决策推理"
                                              IsVisible="{Binding AIReasoning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                              Padding="{StaticResource NoPadding}">
                                        <TextBlock Text="{Binding AIReasoning}"
                                                   TextWrapping="Wrap"
                                                   FontSize="{StaticResource SmallFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="{StaticResource SmallCardPadding}"/>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空态 / 失败态（含重试入口） -->
            <controls:StateOverlayView State="{Binding OverlayState}"
                                       Message="{Binding OverlayMessage}"
                                       RetryCommand="{Binding RetryCommand}"
                                       RetryText="重新加载"
                                       ShowLoading="False"/>
        </Panel>
    </Grid>
</UserControl>
