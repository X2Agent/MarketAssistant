<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels.Trading"
             xmlns:models="using:MarketAssistant.Trading.Models"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:trading="using:MarketAssistant.Views.Components.Trading"
             xmlns:converters="using:MarketAssistant.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.Trading.TradeHistoryView"
             x:DataType="vm:TradeHistoryViewModel">

    <UserControl.Resources>
        <converters:PriceChangeColorConverter x:Key="PnlColorConverter"/>
        <!-- 交易对筛选框宽度：比输入框默认宽度窄，避免挤压右侧统计摘要 -->
        <x:Double x:Key="FilterSymbolWidth">220</x:Double>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- 页签内标题：与其余两个页签同一结构（card-title + caption）。
             记录按当前交易环境隔离，且包含已取消 / 失败的订单，副标题据实说明范围 -->
        <StackPanel Grid.Row="0" Spacing="{StaticResource TinySpacing}">
            <TextBlock Classes="card-title" Text="交易历史"/>
            <TextBlock Classes="caption" Text="当前环境最近 100 条订单记录（含已取消与失败）· 可按交易对筛选"/>
        </StackPanel>

        <!-- 筛选工具栏：与其余页签同用 CardView（圆角 12），不再单独用 8 圆角的裸 Border -->
        <controls:CardView Grid.Row="1" Margin="{StaticResource DefaultVerticalMargin}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                  ColumnSpacing="{StaticResource SmallSpacing}"
                  VerticalAlignment="Center">
                <TextBox Grid.Column="0"
                         Text="{Binding FilterSymbol}"
                         PlaceholderText="交易对（如 BTCUSDT）"
                         Width="{StaticResource FilterSymbolWidth}"/>
                <Button Grid.Column="1"
                        Content="筛选"
                        Command="{Binding FilterCommand}"
                        Classes="btn-primary"/>
                <Button Grid.Column="2"
                        Content="清除"
                        Command="{Binding ClearFilterCommand}"
                        Classes="btn-secondary"/>

                <!-- 今日摘要：数值用 num-sm，标签用 caption，与监控页指标一致 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="{StaticResource SectionSpacing}"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                        <TextBlock Classes="caption" Text="今日成交" VerticalAlignment="Center"/>
                        <TextBlock Classes="num" Text="{Binding TodayStats.TradeCount}" VerticalAlignment="Center"/>
                        <TextBlock Classes="caption" Text="笔" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                        <TextBlock Classes="caption" Text="今日盈亏" VerticalAlignment="Center"/>
                        <TextBlock Classes="num"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding TodayStats.TotalPnl, Converter={StaticResource PnlColorConverter}}"
                                   Text="{Binding TodayStats.TotalPnl, StringFormat={}{0:+0.00;-0.00;0.00}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </controls:CardView>

        <!-- 记录列表 -->
        <Panel Grid.Row="2">
            <!-- 首屏骨架：5 条记录卡。头部 14 / 明细 12，两段字号不同。 -->
            <controls:SkeletonList Count="5"
                                   Spacing="{StaticResource TinySpacing}"
                                   IsVisible="{Binding IsInitialLoading}">
                <controls:SkeletonList.ItemTemplate>
                    <DataTemplate>
                        <controls:SkeletonCard Variant="Row">
                            <StackPanel Spacing="{StaticResource TinySpacing}">
                                <controls:SkeletonLines Row="BodySm" LineWidths="96"/>
                                <controls:SkeletonLines Row="Caption" LineWidths="320"/>
                            </StackPanel>
                        </controls:SkeletonCard>
                    </DataTemplate>
                </controls:SkeletonList.ItemTemplate>
            </controls:SkeletonList>

            <ScrollViewer IsVisible="{Binding !IsInitialLoading}">
                <ItemsControl ItemsSource="{Binding Records}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:TradeRecord">
                            <trading:TradeRecordRowView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空态 / 失败态（含重试入口） -->
            <controls:StateOverlayView State="{Binding OverlayState}"
                                       Message="{Binding OverlayMessage}"
                                       RetryCommand="{Binding RetryCommand}"
                                       RetryText="重新加载"
                                       ShowLoading="False"/>
        </Panel>
    </Grid>
</UserControl>
