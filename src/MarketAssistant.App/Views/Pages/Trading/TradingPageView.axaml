<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels.Trading"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:trading="using:MarketAssistant.Views.Pages.Trading"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.Trading.TradingPageView"
             x:DataType="vm:TradingPageViewModel">

    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="{StaticResource SmallSpacing}">
                <Border IsVisible="{Binding IsTestnetTradingMode}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource SmallCornerRadius}"
                    Padding="{StaticResource SmallPadding}">
                <StackPanel Spacing="{StaticResource TinySpacing}">
                    <TextBlock Text="Binance Spot Testnet 已启用"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Text="{Binding TradingModeDescription}"
                               FontSize="{StaticResource SmallFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Tab 按钮组 -->
            <Border Background="{DynamicResource SurfaceVariantBrush}"
                    CornerRadius="{StaticResource SmallCornerRadius}"
                    Padding="{StaticResource TinyPadding}"
                    Margin="{StaticResource SmallBottomMargin}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource DefaultSpacing}">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0">
                        <Button Content="交易配置"
                                Classes="period-button"
                                Classes.selected="{Binding IsConfigTabSelected}"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="0"/>
                        <Button Content="交易监控"
                                Classes="period-button"
                                Classes.selected="{Binding IsMonitorTabSelected}"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="1"/>
                        <Button Content="交易历史"
                                Classes="period-button"
                                Classes.selected="{Binding IsHistoryTabSelected}"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="2"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentTradingModeText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="{StaticResource SmallFontSize}"
                               FontWeight="Medium"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Tab 内容区域 -->
        <Panel Grid.Row="1">
            <!-- 交易配置：策略配置（左）+ API 密钥（右）-->
            <Grid IsVisible="{Binding $parent[UserControl].((vm:TradingPageViewModel)DataContext).IsConfigTabSelected}"
                  ColumnDefinitions="*,400"
                  ColumnSpacing="{StaticResource DefaultSpacing}">
                <trading:StrategyConfigView Grid.Column="0"
                                            DataContext="{Binding StrategyConfig}"/>
                <trading:ApiKeyConfigView Grid.Column="1"
                                         DataContext="{Binding ApiKeyConfig}"/>
            </Grid>

            <trading:TradeMonitorView DataContext="{Binding TradeMonitor}"
                                      IsVisible="{Binding $parent[UserControl].((vm:TradingPageViewModel)DataContext).IsMonitorTabSelected}"/>
            <trading:TradeHistoryView DataContext="{Binding TradeHistory}"
                                      IsVisible="{Binding $parent[UserControl].((vm:TradingPageViewModel)DataContext).IsHistoryTabSelected}"/>
        </Panel>
    </Grid>
</UserControl>
