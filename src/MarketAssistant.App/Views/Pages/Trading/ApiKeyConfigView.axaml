<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels.Trading"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:converters="using:MarketAssistant.Converters"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="MarketAssistant.Views.Pages.Trading.ApiKeyConfigView"
             x:DataType="vm:ApiKeyConfigViewModel">

    <UserControl.Resources>
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
    </UserControl.Resources>

    <!-- 本视图只嵌在交易页的「API 密钥设置」手风琴里：手风琴标题已经说明了这一块是什么，
         所以这里不再重复页面标题，直接给三组内容；外层页面本身可滚动，也不再套一层 ScrollViewer -->
    <StackPanel Spacing="{StaticResource DefaultSpacing}">

        <!-- 交易模式选择 -->
        <controls:CardView>
            <controls:CardView.Header>
                <TextBlock Text="交易模式" Classes="card-title"/>
            </controls:CardView.Header>
            <StackPanel Spacing="{StaticResource SmallSpacing}">
                <ComboBox ItemsSource="{Binding TradingModes}"
                          SelectedItem="{Binding SelectedMode}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding ModeDescription}"
                           Classes="caption"
                           TextWrapping="Wrap"/>
                <!-- 本页唯一主操作是「保存密钥」；切换模式是次要操作 -->
                <Button Content="应用此模式"
                        Command="{Binding ApplyModeCommand}"
                        Classes="btn-secondary"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </controls:CardView>

        <!-- 实盘警告 -->
        <controls:StatusBanner Severity="Danger"
                               Message="实盘模式将使用真实资金进行交易。请确认 API Key 已在 binance.com 配置正确的权限（仅开启现货/合约交易，不要开启提现权限）。"
                               IsVisible="{Binding IsLiveMode}"/>

        <!-- 当前所选模式的密钥表单 -->
        <controls:CardView>
            <controls:CardView.Header>
                <TextBlock Text="API 密钥" Classes="card-title"/>
            </controls:CardView.Header>
            <StackPanel Spacing="{StaticResource DefaultSpacing}">
                <StackPanel Spacing="{StaticResource TinySpacing}">
                    <TextBlock Text="API Key" Classes="form-label"/>
                    <TextBox Text="{Binding ApiKey}"
                             PlaceholderText="请输入 API Key"
                             PasswordChar="●"/>
                </StackPanel>
                <StackPanel Spacing="{StaticResource TinySpacing}">
                    <TextBlock Text="Secret Key" Classes="form-label"/>
                    <TextBox Text="{Binding SecretKey}"
                             PlaceholderText="请输入 Secret Key"
                             PasswordChar="●"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                    <Button Content="保存密钥"
                            Command="{Binding SaveCommand}"
                            Classes="btn-primary"/>
                    <Button Content="清除密钥"
                            Command="{Binding ClearCommand}"
                            Classes="btn-danger"/>
                </StackPanel>
                <TextBlock Text="密钥使用 AES-GCM 加密存储，独立于应用设置，仅保存在本地、不会上传。"
                           Classes="form-hint"/>
            </StackPanel>
        </controls:CardView>

        <!-- 各模式配置状态 -->
        <controls:CardView>
            <controls:CardView.Header>
                <TextBlock Text="各模式密钥状态" Classes="card-title"/>
            </controls:CardView.Header>
            <ItemsControl ItemsSource="{Binding CredentialStatuses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CredentialStatus">
                        <Grid ColumnDefinitions="*,Auto" Margin="{StaticResource TinyVerticalMargin}">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DisplayName}"
                                       VerticalAlignment="Center"/>
                            <controls:StatusTag Grid.Column="1" Text="已配置" Classes="success"
                                                IsVisible="{Binding IsConfigured}"/>
                            <controls:StatusTag Grid.Column="1" Text="未配置"
                                                IsVisible="{Binding !IsConfigured}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </controls:CardView>

    </StackPanel>
</UserControl>
