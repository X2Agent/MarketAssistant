<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:settings="using:MarketAssistant.Applications.Settings"
             xmlns:mcp="using:MarketAssistant.Services.Mcp"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:converts="using:MarketAssistant.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.MCPConfigPageView"
             x:DataType="vm:MCPConfigPageViewModel">

    <UserControl.Resources>
        <converts:RadioButtonEqualityConverter x:Key="RadioButtonEqualityConverter"/>
        <converts:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
        <GridLength x:Key="ServerListWidth">280</GridLength>
        <Thickness x:Key="ChipPadding">4,0</Thickness>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:MCPConfigPageViewModel/>
    </Design.DataContext>

    <!-- 单层两列 Grid：左栏服务器列表 / 右栏编辑表单（页头已移除，标题由左侧导航承担） -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 窄窗保护：左栏 240、右栏最小 320，合计 560 在 768px 窗口（减 48 页面边距）内可容纳 -->
            <ColumnDefinition Width="{StaticResource ServerListWidth}" MinWidth="200"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <!-- 左侧服务器列表 -->
        <Border Grid.Column="0" 
                Background="{DynamicResource ItemBackgroundBrush}"
                BorderThickness="{StaticResource NoBorderThickness}">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- 顶部操作区：左栏整体白底贯穿，不再用整条色带切分（SurfaceVariant 的通栏用法会与页面底色 #F5F7FA 混淆，看起来像白板被挖了洞） -->
                <Border Grid.Row="0" 
                        Padding="{StaticResource PagePadding}" 
                        Background="Transparent">
                    <Button Content="添加服务器" 
                            Command="{Binding AddServerCommand}" 
                            Classes="btn-primary"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                </Border>

                <!-- 服务器列表 -->
                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding ServerConfigs}"
                             SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="{StaticResource NoBorderThickness}"
                             Padding="{StaticResource NoPadding}"
                             Margin="{StaticResource SmallPadding}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="MCP 服务器列表">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <!-- 服务器卡片表面：必须写成样式而不是 Border 上的局部属性，
                                 否则局部 Background 的优先级会盖住下面 hover / 选中 的样式。 -->
                            <Style Selector="Border.serverCard">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}"/>
                                <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}"/>
                                <Setter Property="Padding" Value="{StaticResource DefaultCardPadding}"/>
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
                                    </Transitions>
                                </Setter>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover Border.serverCard">
                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Style>
                            <!-- 选中态：加深底色 + AccentRing 阴影环（与 mode-card 同一语义），不描边 -->
                            <Style Selector="ListBoxItem:selected Border.serverCard">
                                <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                                <Setter Property="BoxShadow" Value="{StaticResource AccentRing}"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="settings:MCPServerConfig">
                                    <Border Classes="serverCard"
                                            Margin="{StaticResource TinyBottomMargin}">

                                        <StackPanel Spacing="{StaticResource TinySpacing}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontWeight="{DynamicResource WeightTitle}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- 行内启用开关：外层 Border 吃掉点击并转发命令，
                                                     否则点开关会选中 ListBoxItem（那会打开编辑表单）。
                                                     Background=Transparent 是必需的：无底色的 Border 不能稳定命中测试。 -->
                                                <Border Grid.Column="1"
                                                        Background="Transparent"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand"
                                                        PointerPressed="OnServerTogglePointerPressed">
                                                    <ToggleSwitch Width="48"
                                                                  IsHitTestVisible="False"
                                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                  ToolTip.Tip="启用 / 停用该服务器"/>
                                                </Border>
                                            </Grid>
                                            
                                            <TextBlock Text="{Binding Description}" 
                                                       FontSize="{StaticResource CaptionFontSize}" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2"/>
                                            
                                            <Border Background="{DynamicResource SurfaceVariantBrush}"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="{StaticResource TinyCornerRadius}"
                                                    Padding="{StaticResource ChipPadding}">
                                                <TextBlock Text="{Binding TransportType}" 
                                                           FontSize="{StaticResource CaptionFontSize}" 
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                        <!-- 空视图 -->
                        <StackPanel IsVisible="{Binding !ServerConfigs.Count}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="{StaticResource SmallSpacing}"
                                    Margin="{StaticResource LogoTopMargin}">
                            <TextBlock Text="暂无服务器配置" 
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="点击上方按钮添加" 
                                       FontSize="{StaticResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                </Grid>

                <!-- 工具审计：MCP 工具加载 / 白名单过滤事件（内存态，刷新重取）。
                     不用通栏色带：外层透明 + 内嵌次级表面块，左栏白底才贯穿到底 -->
                <Border Grid.Row="2"
                        Padding="{StaticResource DefaultPadding}"
                        Background="Transparent">
                    <Border Background="{DynamicResource SurfaceVariantBrush}"
                            CornerRadius="{StaticResource SmallCornerRadius}"
                            Padding="{StaticResource DefaultCardPadding}">
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="工具审计"
                                           FontSize="{StaticResource BodySmFontSize}"
                                           FontWeight="{DynamicResource WeightTitle}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Command="{Binding RefreshAuditCommand}"
                                        Content="刷新"
                                        Background="Transparent"
                                        Foreground="{StaticResource AccentBrush}"
                                        FontSize="{StaticResource CaptionFontSize}"
                                        Padding="{StaticResource ChipPadding}"/>
                            </Grid>
                            <TextBlock IsVisible="{Binding HasNoAuditEntries}"
                                       Text="暂无审计记录。工具在会话中加载后在此显示。"
                                       TextWrapping="Wrap"
                                       FontSize="{StaticResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextDisabledBrush}"/>
                            <ItemsControl ItemsSource="{Binding AuditEntries}"
                                          IsVisible="{Binding HasAuditEntries}"
                                          MaxHeight="180">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="{StaticResource TinySpacing}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="mcp:McpToolAuditEntry">
                                        <StackPanel Spacing="0">
                                            <TextBlock TextWrapping="NoWrap"
                                                       FontSize="{StaticResource CaptionFontSize}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                                <Run Text="{Binding EventType, Converter={StaticResource EnumDescriptionConverter}}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding ServerName}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding ToolName}"/>
                                            </TextBlock>
                                            <TextBlock TextWrapping="NoWrap"
                                                       FontSize="{StaticResource CaptionFontSize}"
                                                       Foreground="{DynamicResource TextDisabledBrush}">
                                                <Run Text="{Binding Category}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Timestamp, StringFormat='{}{0:MM-dd HH:mm}'}"/>
                                                <Run Text=" UTC"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧配置详情 -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto">
            <!-- 编辑表单区域 -->
            <ScrollViewer Grid.Row="0" Padding="{StaticResource PagePadding}">
                <StackPanel IsVisible="{Binding IsEditing}" Spacing="{StaticResource LargeSpacing}">
                    <!-- 基本信息 -->
                    <controls:CardView Header="基本信息" Padding="{StaticResource CardPadding}">
                        <StackPanel Spacing="{StaticResource DefaultSpacing}">
                            <!-- 服务器名称 -->
                            <StackPanel Spacing="{StaticResource TinySpacing}">
                                <TextBlock Classes="form-label">
                                    <Run Text="*" Foreground="{DynamicResource ErrorBrush}"/>
                                    <Run Text="名称"/>
                                </TextBlock>
                                <TextBox Text="{Binding Name}" 
                                         PlaceholderText="请输入服务器名称"
                                         />
                                <TextBlock Text="{Binding NameError}"
                                           IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource ErrorBrush}"/>
                            </StackPanel>

                            <!-- 服务器描述 -->
                            <StackPanel Spacing="{StaticResource TinySpacing}">
                                <TextBlock Text="描述" Classes="form-label"/>
                                <TextBox Text="{Binding Description}" 
                                         PlaceholderText="请输入服务器描述"
                                         Height="{StaticResource TextAreaHeight}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         />
                            </StackPanel>

                            <!-- 服务器类型 -->
                            <StackPanel Spacing="{StaticResource TinySpacing}">
                                <TextBlock Classes="form-label">
                                    <Run Text="*" Foreground="{DynamicResource ErrorBrush}"/>
                                    <Run Text="类型"/>
                                </TextBlock>
                                <WrapPanel Orientation="Horizontal">
                                    <RadioButton GroupName="transportType"
                                                 Margin="{StaticResource SmallRightMargin}"
                                                 Content="标准输入/输出(stdio)"
                                                 IsChecked="{Binding TransportType, Converter={StaticResource RadioButtonEqualityConverter}, ConverterParameter=stdio}"/>
                                    <RadioButton GroupName="transportType"
                                                 Margin="{StaticResource SmallRightMargin}"
                                                 Content="服务器发送事件(sse)"
                                                 IsChecked="{Binding TransportType, Converter={StaticResource RadioButtonEqualityConverter}, ConverterParameter=sse}"/>
                                    <RadioButton GroupName="transportType" 
                                                 Content="可流式传输的HTTP(streamableHttp)"
                                                 IsChecked="{Binding TransportType, Converter={StaticResource RadioButtonEqualityConverter}, ConverterParameter=streamableHttp}"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- 命令/URL配置（stdio 为命令，sse/streamableHttp 为 URL，占位提示随类型切换） -->
                            <StackPanel Spacing="{StaticResource TinySpacing}">
                                <TextBlock Classes="form-label">
                                    <Run Text="*" Foreground="{DynamicResource ErrorBrush}"/>
                                    <Run Text="命令 / URL"/>
                                </TextBlock>
                                <TextBox Text="{Binding Command}" PlaceholderText="{Binding CommandPlaceholder}"/>
                                <TextBlock Text="{Binding CommandHint}" 
                                           FontSize="{StaticResource CaptionFontSize}" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CommandError}"
                                           IsVisible="{Binding CommandError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           FontSize="{StaticResource CaptionFontSize}" 
                                           Foreground="{DynamicResource ErrorBrush}"/>
                            </StackPanel>

                            <!-- 参数配置 (仅stdio) -->
                            <StackPanel Spacing="{StaticResource TinySpacing}" IsVisible="{Binding IsStdio}">
                                <TextBlock Text="参数" Classes="form-label"/>
                                <TextBox Text="{Binding Arguments}" 
                                         PlaceholderText="请输入命令参数，如-y @modelcontextprotocol/server-github"
                                         Height="{StaticResource ModeSelectionHeight}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"/>
                                <TextBlock Text="提示：多个参数请用空格分隔" 
                                           FontSize="{StaticResource CaptionFontSize}" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- 环境变量配置 (仅stdio) -->
                            <StackPanel Spacing="{StaticResource TinySpacing}" IsVisible="{Binding IsStdio}">
                                <TextBlock Text="环境变量" Classes="form-label"/>
                                <TextBox Text="{Binding EnvironmentVariablesText}"
                                         PlaceholderText="KEY1=value1&#10;KEY2=value2"
                                         Height="{StaticResource CompactTextAreaHeight}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"/>
                                <TextBlock Text="每行一个环境变量，格式为KEY=value" 
                                           FontSize="{StaticResource CaptionFontSize}" 
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- 工具白名单 -->
                            <StackPanel Spacing="{StaticResource TinySpacing}">
                                <CheckBox IsChecked="{Binding AllowAllTools}"
                                          Content="允许全部工具（高危：跳过白名单，仅在完全信任该服务器时开启）"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="加载工具列表"
                                            Command="{Binding LoadToolsCommand}"
                                            Classes="btn-secondary"
                                            Margin="{StaticResource TinyRightMargin}"
                                            IsEnabled="{Binding !AllowAllTools}"/>
                                    <TextBlock Text="空白名单默认不向 Agent 暴露任何工具"
                                               FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding ToolItems}"
                                              IsEnabled="{Binding !AllowAllTools}"
                                              MaxHeight="220">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="{StaticResource TinyVerticalMargin}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Name}" FontWeight="{DynamicResource WeightTitle}"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="{StaticResource CaptionFontSize}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="420"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </controls:CardView>
                </StackPanel>
            </ScrollViewer>

            <!-- 操作按钮区域 (固定在底部)：与左栏「工具审计」同一套语言——内嵌次级表面块，不用通栏色带 -->
            <Border Grid.Row="1"
                    IsVisible="{Binding IsEditing}"
                    Background="Transparent"
                    Padding="{StaticResource DefaultPadding}">
                <Border Background="{DynamicResource SurfaceVariantBrush}"
                        CornerRadius="{StaticResource SmallCornerRadius}"
                        Padding="{StaticResource DefaultCardPadding}">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- 测试状态显示 -->
                        <StackPanel Grid.Column="0" 
                                    Orientation="Horizontal" 
                                    Spacing="{StaticResource SmallSpacing}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsTesting}">
                            <ProgressBar IsIndeterminate="True" 
                                         Width="{StaticResource ProgressBarWidth}" 
                                         Height="{StaticResource TinySpacing}"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TestStatus}" 
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Column="0"
                                   Text="{Binding TestStatus}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !IsTesting}"
                                   Classes.test-success="{Binding IsTestStatusSuccessful}"
                                   Classes.test-warning="{Binding IsTestStatusWarning}"
                                   Classes.test-failed="{Binding IsTestStatusFailed}">
                            <TextBlock.Styles>
                                <Style Selector="TextBlock.test-success">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </Style>
                                <Style Selector="TextBlock.test-warning">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </Style>
                                <Style Selector="TextBlock.test-failed">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                </Style>
                            </TextBlock.Styles>
                        </TextBlock>
                        
                        <!-- 按钮组 -->
                        <WrapPanel Grid.Column="1"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Right">
                            <Button Content="取消" 
                                    Command="{Binding CancelEditCommand}"
                                    Classes="btn-secondary"
                                    MinWidth="{StaticResource MediumButtonMinWidth}"
                                    Margin="{StaticResource TinyLeftMargin}"/>
                            
                            <Button Content="删除" 
                                    Command="{Binding DeleteServerCommand}"
                                    Classes="btn-danger"
                                    MinWidth="{StaticResource MediumButtonMinWidth}"
                                    Margin="{StaticResource TinyLeftMargin}"
                                    IsVisible="{Binding SelectedConfig, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            
                            <Button Content="测试连接" 
                                    Command="{Binding TestConnectionCommand}"
                                    IsEnabled="{Binding !IsTesting}"
                                    Classes="btn-secondary"
                                    MinWidth="{StaticResource MediumButtonMinWidth}"
                                    Margin="{StaticResource TinyLeftMargin}"/>
                            
                            <Button Content="保存" 
                                    Command="{Binding SaveServerCommand}"
                                    IsEnabled="{Binding !IsTesting}"
                                    Classes="btn-primary"
                                    MinWidth="{StaticResource MediumButtonMinWidth}"
                                    Margin="{StaticResource TinyLeftMargin}"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- 未选择服务器时的提示：必须有不透明底，否则会与下方表单内容叠印 -->
            <Border Grid.Row="0" Grid.RowSpan="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    IsVisible="{Binding IsEditing, Converter={x:Static BoolConverters.Not}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource LargeSpacing}">
                <TextBlock Text="请选择或添加MCP服务器" 
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{StaticResource BodyFontSize}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="在左侧列表中选择一个服务器进行编辑，或点击“添加服务器”创建新配置"
                           Classes="caption"
                           HorizontalAlignment="Center"/>
            </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

