<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:telegrams="using:MarketAssistant.Applications.Telegrams"
             xmlns:assets="using:MarketAssistant.Applications.Assets.Models"
             xmlns:converts="using:MarketAssistant.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.HomePageView"
             x:DataType="vm:HomePageViewModel">

    <UserControl.Resources>
        <converts:PriceChangeColorConverter x:Key="PriceChangeColorConverter"/>
    </UserControl.Resources>

    <!-- 热门资产卡片瓦片 / 最近查看条目样式 -->
    <UserControl.Styles>
        <!-- 最近查看条目：无卡片效果，仅悬停高亮 -->
        <Style Selector="Border.recent-chip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource TinyCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource SmallCardPadding}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.recent-chip:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0">

        <!-- 顶部搜索区域 -->
        <controls:CardView Margin="{StaticResource BottomMargin}">
            <Grid ColumnDefinitions="*,Auto">
                <!-- 搜索输入框 + 结果弹层。
                     不使用 AutoCompleteBox：其内部文本同步机制会在输入法组合期间
                     异步改写文本，导致拼音提交时出现重复字符串。 -->
                <Panel Grid.Column="0">
                    <TextBox x:Name="StockSearchBox"
                             PlaceholderText="输入资产代码或名称"
                             Text="{Binding Search.SearchQuery, Mode=TwoWay}"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="{StaticResource SectionTitleFontSize}"
                             Padding="{StaticResource SmallCardPadding}"
                             KeyDown="StockSearchBox_KeyDown"/>
                    <Popup x:Name="SearchResultsPopup"
                           PlacementTarget="{Binding #StockSearchBox}"
                           Placement="Bottom"
                           IsLightDismissEnabled="True"
                           IsOpen="{Binding Search.IsSearchResultVisible, Mode=TwoWay}">
                        <Border Width="{Binding #StockSearchBox.Bounds.Width}"
                                MaxHeight="{StaticResource DropDownMaxHeight}"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource SmallCornerRadius}"
                                ClipToBounds="True">
                            <ListBox x:Name="SearchResultsList"
                                     ItemsSource="{Binding Search.SearchResults}"
                                     SelectionMode="Single"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="assets:AssetItem">
                                        <StackPanel Margin="{StaticResource TinyMargin}"
                                                   Background="Transparent"
                                                   Cursor="Hand"
                                                   PointerPressed="SearchResultItem_PointerPressed"
                                                   Tag="{Binding .}">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontWeight="SemiBold"
                                                       FontSize="{StaticResource LabelFontSize}"/>
                                            <TextBlock Text="{Binding Code}" 
                                                       FontSize="{StaticResource SmallFontSize}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Panel>
                
                <!-- 搜索加载指示器 -->
                <Border Grid.Column="1"
                       IsVisible="{Binding Search.IsSearching}"
                       Background="{DynamicResource CardBackgroundBrush}"
                       CornerRadius="{StaticResource DefaultCornerRadius}"
                       Padding="{StaticResource SmallCardPadding}"
                       VerticalAlignment="Center"
                       Margin="{StaticResource SmallLeftMargin}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                        <!-- 搜索图标 -->
                        <svg:Svg Path="/Assets/Images/search_icon.svg"
                                Width="{StaticResource TinyIconSize}"
                                Height="{StaticResource TinyIconSize}"
                                VerticalAlignment="Center"/>

                        <!-- 三点波浪动画 -->
                        <controls:LoadingDots DotSize="{StaticResource DotIconSize}" DotSpacing="{StaticResource TinySpacing}" />
                    </StackPanel>
                </Border>
            </Grid>
        </controls:CardView>

        <!-- 最近查看：紧凑单行条（无卡片，高度随内容自适应，超出横向滚动，悬停显示滚动条） -->
        <StackPanel Orientation="Horizontal"
                    Spacing="{StaticResource DefaultSpacing}"
                    IsVisible="{Binding RecentAssets.RecentAssets.Count}"
                    Margin="{StaticResource BottomMargin}">
            <TextBlock Text="最近查看"
                       FontSize="{StaticResource SmallFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <ScrollViewer Classes="recent-scroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          AllowAutoHide="False">
                <ScrollViewer.Styles>
                    <!-- 滚动条默认隐藏，悬停时淡入 -->
                    <Style Selector="ScrollViewer.recent-scroller /template/ ScrollBar">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="ScrollViewer.recent-scroller:pointerover /template/ ScrollBar">
                        <Setter Property="Opacity" Value="1"/>
                    </Style>
                </ScrollViewer.Styles>
                <ItemsControl ItemsSource="{Binding RecentAssets.RecentAssets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="assets:AssetItem">
                            <Border Classes="recent-chip"
                                    Margin="{StaticResource SmallRightMargin}"
                                    Tapped="RecentStockCard_Tapped"
                                    KeyDown="RecentStockCard_KeyDown"
                                    Focusable="True"
                                    AutomationProperties.Name="{Binding Name}"
                                    Tag="{Binding .}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="{StaticResource TinySpacing}"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource LabelFontSize}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentPrice}"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontSize="{StaticResource SmallFontSize}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding CurrentPrice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}}"/>
                                    <TextBlock Text="{Binding ChangePercentage}"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontSize="{StaticResource SmallFontSize}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding ChangePercentage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
      </StackPanel>

        <!-- 两列布局（对齐原型 Bento Grid 层级）：热门资产 | 7*24快讯 -->
        <Grid Grid.Row="1"
              ColumnDefinitions="3*,2*">
            
            <!-- 上排右列：7*24小时新闻快讯 -->
            <controls:CardView Grid.Column="1" Grid.Row="0">
                <controls:CardView.Header>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="7*24小时快讯"
                                   FontSize="{StaticResource SectionTitleFontSize}" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding News.TelegraphRefreshCountdown}"
                                   FontSize="{StaticResource SmallFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource SmallLeftMargin}"/>
                    </Grid>
                </controls:CardView.Header>
                
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding News.Telegraphs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource SmallSpacing}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="telegrams:Telegram">
                                <Border Classes="news-card"
                                        Tapped="NewsCard_Tapped"
                                        KeyDown="NewsCard_KeyDown"
                                        Focusable="True"
                                        AutomationProperties.Name="{Binding Title}"
                                        Tag="{Binding .}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <!-- 左侧内容 -->
                                        <StackPanel Grid.Column="0" Spacing="{StaticResource TinySpacing}">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="{StaticResource LabelFontSize}" 
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Content}"
                                                       FontSize="{StaticResource SmallFontSize}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxLines="3"/>
                                            
                                            <!-- 关联标的标签 -->
                                            <ItemsControl ItemsSource="{Binding Symbols}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Background="{DynamicResource SurfaceVariantBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="{StaticResource DefaultBorderThickness}"
                                                                CornerRadius="{StaticResource TinyCornerRadius}"
                                                                Padding="{StaticResource TinyPadding}"
                                                                Margin="{StaticResource TinyMargin}">
                                                            <TextBlock Text="{Binding .}"
                                                                       FontSize="{StaticResource SmallFontSize}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        
                                        <!-- 右侧时间 -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Time}"
                                                   FontSize="{StaticResource LabelFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="{StaticResource SmallLeftMargin}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </controls:CardView>
            
            <!-- 左列：热门资产（撑满列高，与右侧快讯对齐） -->
            <controls:CardView Grid.Column="0"
                               Margin="{StaticResource SmallRightMargin}">
                <controls:CardView.Header>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="热门资产"
                                   FontSize="{StaticResource SectionTitleFontSize}" 
                                   FontWeight="SemiBold"/>
                        <svg:Svg Grid.Column="1"
                                 Path="/Assets/Images/trending_icon.svg"
                                 Width="{StaticResource SmallIconSize}"
                                 Height="{StaticResource SmallIconSize}"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </controls:CardView.Header>
                
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding HotAssets.HotAssets}"
                                  VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- 恢复重构前写法：两列均分卡片宽度 -->
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="assets:HotAsset">
                                <!-- 卡片瓦片（恢复重构前写法）：名称/代码 | 价格/涨跌 | 热度/成交量 | 收藏 -->
                                <Border Classes="hot-stock-card"
                                        Margin="{StaticResource TinyMargin}"
                                        Padding="{StaticResource CompactCardPadding}"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        CornerRadius="{StaticResource DefaultCornerRadius}"
                                        Tapped="HotStockCard_Tapped"
                                        KeyDown="HotStockCard_KeyDown"
                                        Focusable="True"
                                        AutomationProperties.Name="{Binding Name}"
                                        Tag="{Binding .}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" Cursor="Hand">
                                        <!-- 左栏：名称与代码 -->
                                        <StackPanel Grid.Column="0" Spacing="{StaticResource SmallSpacing}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="{StaticResource BodyFontSize}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Code}"
                                                       FontFamily="{StaticResource DataFontFamily}"
                                                       FontSize="{StaticResource TinyFontSize}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- 右栏：价格/涨跌在上、指标在下，右对齐形成整齐数字列 -->
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource SmallSpacing}" VerticalAlignment="Center" Margin="{StaticResource TinyRightMargin}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding CurrentPrice}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontSize="{StaticResource BodyFontSize}"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}}"/>
                                                <TextBlock Text="{Binding ChangePercentage}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontSize="{StaticResource SmallFontSize}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding MetricLabel}"
                                                           FontSize="{StaticResource MiniFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding FormattedMetric}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontSize="{StaticResource MiniFontSize}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 收藏 -->
                                        <Button Grid.Column="2"
                                                Classes="favorite-button"
                                                Background="Transparent"
                                                Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).HotAssets.AddToFavoriteCommand}"
                                                CommandParameter="{Binding .}"
                                                Tapped="OnPreventTapped"
                                                Width="{StaticResource SmallIconSize}"
                                                Height="{StaticResource SmallIconSize}"
                                                Padding="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <svg:Svg Path="/Assets/Images/tab_favorites.svg"
                                                     Width="{StaticResource MiniIconSize}"
                                                     Height="{StaticResource MiniIconSize}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </controls:CardView>
            



        </Grid>
            </Grid>
</UserControl>