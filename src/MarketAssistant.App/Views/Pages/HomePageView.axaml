<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:homevm="using:MarketAssistant.ViewModels.Home"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:components="using:MarketAssistant.Views.Components"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             xmlns:telegrams="using:MarketAssistant.Applications.Telegrams"
             xmlns:assets="using:MarketAssistant.Applications.Assets.Models"
             xmlns:converts="using:MarketAssistant.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.HomePageView"
             x:DataType="vm:HomePageViewModel">

    <UserControl.Resources>
        <converts:PriceChangeColorConverter x:Key="PriceChangeColorConverter"/>
    </UserControl.Resources>

    <!-- 最近查看条目样式（热门资产卡片见 AssetCardView） -->
    <UserControl.Styles>
        <!-- 最近查看条目：无卡片效果，仅悬停高亮 -->
        <Style Selector="Border.recent-chip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{StaticResource TinyCornerRadius}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="{StaticResource SmallCardPadding}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.recent-chip:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        </Style>

        <!-- 快讯标题：略强调。必须用类样式：DataTemplate 里元素上本地写的 DynamicResource
             优先级低于 body-sm 类，写在元素上不生效 -->
        <Style Selector="TextBlock.news-title">
            <Setter Property="FontWeight" Value="{DynamicResource WeightEmphasis}"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,Auto,*">

      <!-- 第一行：行情条独占整行，各指数均分宽度 -->
      <components:IndexTickerBarView Grid.Row="0"
                                     Margin="{StaticResource BottomMargin}"
                                     DataContext="{Binding Tickers}"/>

      <!-- 第二行：搜索框占满整行 -->
      <Panel Grid.Row="1" Margin="{StaticResource BottomMargin}">
        <!-- 搜索输入框 + 结果弹层。
             查询词由 ViewModel 防抖搜索，结果在独立弹层展示，输入框文本只来自用户输入，
             因此不用 AutoCompleteBox（它选中候选项时会改写 Text）。 -->
        <TextBox x:Name="StockSearchBox"
                 Classes="search-input"
                 PlaceholderText="输入资产代码或名称"
                 Text="{Binding Search.SearchQuery, Mode=TwoWay}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 FontSize="{StaticResource BodyFontSize}"
                 KeyDown="StockSearchBox_KeyDown"/>
        <Popup x:Name="SearchResultsPopup"
               PlacementTarget="{Binding #StockSearchBox}"
               Placement="Bottom"
               IsLightDismissEnabled="True"
               IsOpen="{Binding Search.IsSearchResultVisible, Mode=TwoWay}">
          <Border Width="{Binding #StockSearchBox.Bounds.Width}"
                  MaxHeight="{StaticResource DropDownMaxHeight}"
                  Background="{DynamicResource CardBackgroundBrush}"
                  BorderThickness="{StaticResource NoBorderThickness}"
                  BoxShadow="{StaticResource ShadowOverlay}"
                  CornerRadius="{StaticResource SmallCornerRadius}"
                  ClipToBounds="True">
            <Panel>
              <ListBox x:Name="SearchResultsList"
                       ItemsSource="{Binding Search.SearchResults}"
                       SelectedItem="{Binding Search.SelectedResult, Mode=TwoWay}"
                       SelectionMode="Single"
                       Background="Transparent"
                       BorderThickness="{StaticResource NoBorderThickness}"
                       Padding="{StaticResource NoPadding}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="assets:AssetItem">
                    <StackPanel Margin="{StaticResource TinyMargin}"
                                Background="Transparent"
                                Cursor="Hand"
                                Tapped="SearchResultItem_Tapped">
                      <TextBlock Text="{Binding Name}" 
                                 FontWeight="{DynamicResource WeightTitle}"
                                 FontSize="{StaticResource BodySmFontSize}"/>
                      <TextBlock Text="{Binding Code}" 
                                 FontSize="{StaticResource CaptionFontSize}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <!-- 搜索失败提示：与"无匹配结果"区分（后者不弹层） -->
              <TextBlock Text="{Binding Search.SearchErrorMessage}"
                         IsVisible="{Binding Search.HasSearchError}"
                         Margin="{StaticResource SmallCardPadding}"
                         TextWrapping="Wrap"
                         FontSize="{StaticResource CaptionFontSize}"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Panel>
          </Border>
        </Popup>

        <!-- 搜索加载指示器：浮层定位于输入框右侧 -->
        <Border IsVisible="{Binding Search.IsSearching}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="{StaticResource SmallRightMargin}"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderThickness="{StaticResource NoBorderThickness}"
                CornerRadius="{StaticResource PillCornerRadius}"
                Padding="{StaticResource SmallPadding}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
            <!-- 搜索图标 -->
            <svg:Svg Path="/Assets/Images/icon_magnifier.svg"
                     Width="{StaticResource TinyIconSize}"
                     Height="{StaticResource TinyIconSize}"
                     VerticalAlignment="Center"/>

            <!-- 三点波浪动画 -->
            <controls:LoadingDots DotSize="{StaticResource DotIconSize}" DotSpacing="{StaticResource TinySpacing}" />
          </StackPanel>
        </Border>
      </Panel>

        <!-- 最近查看：独占一行（超出横向滚动，滚动条整体隐藏）。
             * 列约束宽度：水平 StackPanel 以无限宽测量子级，
             ScrollViewer 会按内容全宽排列并溢出，既无裁剪也无可滚动余量。 -->
      <Panel Grid.Row="2" Margin="{StaticResource BottomMargin}">
        <Grid ColumnDefinitions="Auto,*"
              VerticalAlignment="Center"
              IsVisible="{Binding RecentAssets.RecentAssets.Count}">
          <TextBlock Grid.Column="0"
                     Text="最近查看"
                     FontSize="{StaticResource CaptionFontSize}"
                     FontWeight="{DynamicResource WeightTitle}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     VerticalAlignment="Center"/>
          <!-- 滚动条整体隐藏：滚轮即可横向滚动，保持单行条的干净外观 -->
          <ScrollViewer Grid.Column="1"
                        x:Name="RecentScroller"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        Margin="{StaticResource SmallLeftMargin}">
            <Panel>
              <!-- 首屏骨架：与 recent-chip 同内边距（8）与行高（21），共 37 高 -->
              <controls:SkeletonList Count="3"
                                     Orientation="Horizontal"
                                     Spacing="{StaticResource SmallSpacing}"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding RecentAssets.IsInitialLoading}">
                <controls:SkeletonList.ItemTemplate>
                  <DataTemplate>
                    <controls:SkeletonCard Variant="Bare"
                                           Padding="{StaticResource SmallCardPadding}"
                                           Row="BodySm"
                                           LineWidths="72"/>
                  </DataTemplate>
                </controls:SkeletonList.ItemTemplate>
              </controls:SkeletonList>

              <ItemsControl ItemsSource="{Binding RecentAssets.RecentAssets}"
                            IsVisible="{Binding !RecentAssets.IsInitialLoading}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="assets:AssetItem">
                    <Border Classes="recent-chip"
                            Margin="{StaticResource SmallRightMargin}"
                            controls:Activation.Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).RecentAssets.SelectRecentAssetCommand}"
                            controls:Activation.CommandParameter="{Binding}"
                            Focusable="True"
                            AutomationProperties.Name="{Binding Name}">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="{StaticResource TinySpacing}"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="{StaticResource BodySmFontSize}"
                                   FontWeight="{DynamicResource WeightTitle}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentPrice}"
                                   FontFamily="{StaticResource DataFontFamily}"
                                   FontSize="{StaticResource CaptionFontSize}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding CurrentPrice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}}"/>
                        <TextBlock Text="{Binding ChangePercentage}"
                                   FontFamily="{StaticResource DataFontFamily}"
                                   FontSize="{StaticResource CaptionFontSize}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ChangePercentage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ScrollViewer>
        </Grid>

        <!-- 最近查看失败态：统一 StateOverlayView（AGENTS.md 强制约定），该条仅在本区块自身失败时出现 -->
        <controls:StateOverlayView State="{Binding RecentAssets.OverlayState}"
                                   Message="{Binding RecentAssets.OverlayMessage}"
                                   RetryCommand="{Binding RecentAssets.RetryCommand}"
                                   RetryText="重新加载"
                                   ShowLoading="False"/>
      </Panel>

      <!-- 两列布局：热门资产（7 列）| 7*24 快讯（5 列），走 12 列栅格基元统一 gutter -->
      <controls:PageGrid Grid.Row="3" ColumnSpacing="{StaticResource GridGutter}">
            
            <!-- 上排右列：7*24小时新闻快讯（每日简报为其 AI 解读入口，同属资讯域） -->
            <controls:CardView Grid.Column="7" Grid.ColumnSpan="5" Grid.Row="0">
                <controls:CardView.Header>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="7*24小时快讯"
                                   FontSize="{StaticResource BodyFontSize}" 
                                   FontWeight="{DynamicResource WeightTitle}"/>

                        <!-- 每日简报入口：与快讯同属资讯域（简报是快讯+自选的 AI 解读），
                             置于同一卡片标题栏语义自洽，也不占用首页黄金位置。
                             此处不承载加载态——简报的生成状态只在弹窗内呈现；
                             快讯的首次加载由下方骨架承担，标题栏是导航区，不放加载指示器。 -->
                        <Button Grid.Column="1"
                                Content="简报"
                                Classes="btn-secondary"
                                Command="{Binding Briefing.OpenBriefingWindowCommand}"
                                ToolTip.Tip="今日 AI 简报：要闻速览 + 自选异动归因"
                                Margin="{StaticResource SmallLeftMargin}"
                                VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding News.TelegraphRefreshCountdown}"
                                   FontSize="{StaticResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="{StaticResource SmallLeftMargin}"/>
                    </Grid>
                </controls:CardView.Header>
                
                <Panel>
                    <!-- 首屏骨架：3 条快讯。Repeat 独立于 Card：一个管"几个"，一个管"长什么样"。 -->
                    <controls:SkeletonList Count="3"
                                           Spacing="{StaticResource SmallSpacing}"
                                           IsVisible="{Binding News.IsAwaitingFirstNews}">
                        <controls:SkeletonList.ItemTemplate>
                            <DataTemplate>
                                <controls:SkeletonCard Variant="Row">
                                    <StackPanel Spacing="6">
                                        <controls:SkeletonLines Row="BodySm" LineWidths="220"/>
                                        <controls:SkeletonLines Row="Caption" LineWidths="*,260" Spacing="2"/>
                                        <controls:SkeletonLines Row="Caption" LineWidths="120" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </controls:SkeletonCard>
                            </DataTemplate>
                        </controls:SkeletonList.ItemTemplate>
                    </controls:SkeletonList>

                    <!-- 空态：已收到推送但无内容 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource SmallSpacing}"
                                IsVisible="{Binding News.IsNewsEmpty}">
                        <svg:Svg Path="/Assets/Images/empty_data.svg"
                                 Width="48"
                                 Height="48"
                                 HorizontalAlignment="Center"/>
                        <TextBlock Text="暂无快讯" Classes="form-label"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer IsVisible="{Binding !News.IsAwaitingFirstNews}">
                        <ItemsControl ItemsSource="{Binding News.Telegraphs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource SmallSpacing}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="telegrams:Telegram">
                                <Border Classes="news-card"
                                        controls:Activation.Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).News.OpenNewsCommand}"
                                        controls:Activation.CommandParameter="{Binding}"
                                        Focusable="True"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <!-- 左侧内容 -->
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock Text="{Binding Title}"
                                                       Classes="body-sm news-title"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Content}"
                                                       Classes="caption"
                                                       TextWrapping="Wrap"
                                                       MaxLines="3"/>
                                            
                                            <!-- 关联标的标签 -->
                                            <ItemsControl ItemsSource="{Binding Symbols}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Background="{DynamicResource SurfaceVariantBrush}"
                                                                BorderThickness="{StaticResource NoBorderThickness}"
                                                                CornerRadius="{StaticResource TinyCornerRadius}"
                                                                Padding="{StaticResource TagPadding}"
                                                                Margin="0,0,4,4">
                                                            <TextBlock Text="{Binding .}"
                                                                       Classes="caption"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        
                                        <!-- 右侧时间 -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Time}"
                                                   Classes="caption"
                                                   VerticalAlignment="Top"
                                                   Margin="{StaticResource SmallLeftMargin}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Panel>
            </controls:CardView>
            
        <!-- 左列：热门资产 -->
        <controls:CardView Grid.Column="0"
                           Grid.ColumnSpan="7"
                           Grid.Row="0">
                <controls:CardView.Header>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="热门资产"
                                   FontSize="{StaticResource BodyFontSize}" 
                                   FontWeight="{DynamicResource WeightTitle}"/>
                        <svg:Svg Grid.Column="1"
                                 Path="/Assets/Images/trending_icon.svg"
                                 Width="{StaticResource SmallIconSize}"
                                 Height="{StaticResource SmallIconSize}"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </controls:CardView.Header>
                
                <Panel>
                    <!-- 首屏骨架：两列瓦片。多列用 ItemsPanel 表达；
                         外层不加 Margin，与真实 ItemsControl 同构（边距只由每张卡的 SmallMargin 提供） -->
                    <controls:SkeletonList Count="6"
                                           VerticalAlignment="Top"
                                           IsVisible="{Binding HotAssets.IsInitialLoading}">
                        <controls:SkeletonList.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </controls:SkeletonList.ItemsPanel>
                        <controls:SkeletonList.ItemTemplate>
                            <DataTemplate>
                                <!-- 与真实热门卡同构（含名次与指标行），改卡片结构时同步改 AssetCardSkeleton -->
                                <controls:AssetCardSkeleton Variant="Tile"
                                                            HasRank="True"
                                                            HasMetric="True"
                                                            Margin="{StaticResource SmallMargin}"/>
                            </DataTemplate>
                        </controls:SkeletonList.ItemTemplate>
                    </controls:SkeletonList>

                    <ScrollViewer IsVisible="{Binding !HotAssets.IsInitialLoading}">
                        <ItemsControl ItemsSource="{Binding HotAssets.HotAssets}"
                                      VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- 恢复重构前写法：两列均分卡片宽度 -->
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="homevm:HotAssetItem">
                                <!-- 点击卡片进详情；右上角星标直接加入/取消自选（星标自己的点击不会冒泡成进详情，见 AssetCardView） -->
                                <controls:AssetCardView Variant="Tile"
                                                        Margin="{StaticResource SmallMargin}"
                                                        Title="{Binding Asset.Name}"
                                                        Code="{Binding Asset.Code}"
                                                        Price="{Binding Asset.CurrentPrice}"
                                                        ChangeText="{Binding Asset.ChangePercentage}"
                                                        MetricLabel="{Binding Asset.MetricLabel}"
                                                        MetricValue="{Binding Asset.MetricValue}"
                                                        RankText="{Binding RankText}"
                                                        controls:Activation.Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).HotAssets.SelectHotAssetCommand}"
                                                        controls:Activation.CommandParameter="{Binding}">
                                    <Button Classes="btn-icon-sm"
                                            ToolTip.Tip="{Binding FavoriteToolTip}"
                                            AutomationProperties.Name="{Binding FavoriteToolTip}"
                                            Command="{Binding $parent[UserControl].((vm:HomePageViewModel)DataContext).HotAssets.ToggleFavoriteCommand}"
                                            CommandParameter="{Binding}">
                                        <Panel>
                                            <svg:Svg Path="/Assets/Images/tab_favorites.svg"
                                                     Width="{StaticResource TinyIconSize}"
                                                     Height="{StaticResource TinyIconSize}"
                                                     IsVisible="{Binding !IsFavorite}"/>
                                            <svg:Svg Path="/Assets/Images/tab_favorites_on.svg"
                                                     Width="{StaticResource TinyIconSize}"
                                                     Height="{StaticResource TinyIconSize}"
                                                     IsVisible="{Binding IsFavorite}"/>
                                        </Panel>
                                    </Button>
                                </controls:AssetCardView>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                    <!-- 空态 / 失败态（含重试入口） -->
                    <controls:StateOverlayView State="{Binding HotAssets.OverlayState}"
                                               Message="{Binding HotAssets.OverlayMessage}"
                                               RetryCommand="{Binding HotAssets.RetryCommand}"
                                               RetryText="重新加载"
                                               ShowLoading="False"/>
                </Panel>
            </controls:CardView>

        </controls:PageGrid>
    </Grid>
</UserControl>
