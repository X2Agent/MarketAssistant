<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:controls="using:MarketAssistant.Views.Controls"
			 xmlns:components="using:MarketAssistant.Views.Components"
             xmlns:converts="using:MarketAssistant.Converters"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
             x:Class="MarketAssistant.Views.Pages.AssetPageView"
             x:DataType="vm:AssetPageViewModel">

    <Design.DataContext>
        <vm:AssetPageViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <converts:PriceChangeColorConverter x:Key="PriceChangeColorConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 右栏区块：卡片表面，无边框，靠表面色阶与页面区分 -->
        <Style Selector="Border.rightSection">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
        </Style>
        <!-- 右栏行情数据指标值 -->
        <Style Selector="TextBlock.metricValue">
            <Setter Property="FontFamily" Value="{StaticResource DataFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource BodySmFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource WeightNumber}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- 右栏区块标题 -->
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="{StaticResource BodySmFontSize}"/>
            <Setter Property="FontWeight" Value="{DynamicResource WeightTitle}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 盘口背景深度条 -->
        <Style Selector="ProgressBar.depthBar">
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="{StaticResource TinyCornerRadius}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- 右栏小号等宽数值 -->
        <Style Selector="TextBlock.cellValue">
            <Setter Property="FontFamily" Value="{StaticResource DataFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="TextBlock.cellLabel">
            <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,*">

        <!-- 资产基本信息卡片：单行布局——名称+代码、价格+涨跌、操作按钮；
             逐 bar 行情指标见 K 线图例，快照级指标见右栏「行情数据」 -->
        <controls:CardView Grid.Row="0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{StaticResource DefaultSpacing}">

                <!-- 名称与代码 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="{StaticResource SmallSpacing}"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding AssetName}"
                               Classes="title"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <Border Background="{DynamicResource SurfaceVariantBrush}"
                            CornerRadius="{StaticResource TinyCornerRadius}"
                            Padding="{StaticResource TagPadding}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding AssetCode}"
                                   FontFamily="{StaticResource DataFontFamily}"
                                   FontSize="{StaticResource CaptionFontSize}"
                                   FontWeight="{DynamicResource WeightNumber}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- 价格与涨跌（紧随名称代码，一行展示） -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="{StaticResource SmallSpacing}"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPriceText}"
                               FontFamily="{StaticResource DataFontFamily}"
                               FontSize="{StaticResource DisplayFontSize}"
                               FontWeight="{DynamicResource WeightNumber}"
                               Foreground="{Binding PriceChange, Converter={StaticResource PriceChangeColorConverter}}"
                               LineHeight="{StaticResource DisplayLineHeight}"
                               VerticalAlignment="Center"/>
                    <TextBlock FontSize="{StaticResource BodySmFontSize}"
                               FontWeight="{DynamicResource WeightNumber}"
                               FontFamily="{StaticResource DataFontFamily}"
                               Text="{Binding PriceChangeText}"
                               Foreground="{Binding PriceChange, Converter={StaticResource PriceChangeColorConverter}}"
                               VerticalAlignment="Center"/>
                    <TextBlock FontSize="{StaticResource BodySmFontSize}"
                               FontWeight="{DynamicResource WeightNumber}"
                               FontFamily="{StaticResource DataFontFamily}"
                               Text="{Binding PriceChangePercent, StringFormat={}({0:F2}%)}"
                               Foreground="{Binding PriceChange, Converter={StaticResource PriceChangeColorConverter}}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 数据时效说明：与标题同行，右侧让位给操作按钮 -->
                <TextBlock Grid.Column="2"
                           Classes="caption"
                           Text="行情延迟约 3 秒 · 数据仅供参考，不构成投资建议"
                           VerticalAlignment="Center"
                           Margin="{StaticResource SmallLeftMargin}"/>

                    <!-- 右侧：操作按钮组（紧随价格信息，不在卡片中间拉出空白） -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Spacing="{StaticResource SmallSpacing}"
                                VerticalAlignment="Center">
                        <!-- 加入/取消自选：点击后由代码后置播放收藏反馈（烟花 + 图标弹一下），
                             故这里不用 Command，改 Click —— 需要 await 命令完成才能判断"是否加进去了"。
                             Panel 只为叠加烟花层，尺寸跟随按钮。 -->
                        <Panel>
                            <Button x:Name="FavoriteButton"
                                    Classes="action-button"
                                    Click="FavoriteButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                                    <svg:Svg x:Name="FavoriteIcon"
                                             Path="/Assets/Images/tab_favorites.svg"
                                             Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FavoriteLabel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <controls:CelebrationBurst x:Name="FavoriteBurst"/>
                        </Panel>

                        <!-- 快捷交易（仅支持交易的市场可见，A 股隐藏） -->
                        <Button Classes="action-button"
                                Command="{Binding NavigateToTradingCommand}"
                                IsVisible="{Binding CanTrade}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                                <svg:Svg Path="/Assets/Images/icon_money.svg" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="快捷交易" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 价格预警 -->
                        <Button Classes="action-button"
                                Command="{Binding NavigateToAlertCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                                <svg:Svg Path="/Assets/Images/icon_warning.svg" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="价格预警" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- AI分析按钮 -->
                        <Button Classes="action-button"
                                Command="{Binding NavigateToAnalysisCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                                <svg:Svg Path="/Assets/Images/icon_ai.svg" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="AI分析" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
        </controls:CardView>

        <!-- 主图 + 右栏（行情数据 / 盘口，恒显） -->
        <Grid Grid.Row="1" Margin="{StaticResource TopMargin}" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource DefaultSpacing}">

            <!-- K线图表区域 -->
            <controls:CardView Grid.Column="0">
                <Grid RowDefinitions="Auto,*">

                    <!-- 图表控制区域 -->
                    <Grid Grid.Row="0"
                          Margin="{StaticResource BottomMargin}"
                          ColumnDefinitions="Auto,*,Auto">

                        <!-- 图例 -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource DefaultSpacing}"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ErrorBrush}"
                                        Width="{StaticResource IndicatorSize}"
                                        Height="{StaticResource IndicatorSize}"
                                        CornerRadius="{StaticResource TinyCornerRadius}" />
                                <TextBlock Text="上涨"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                                <Border Background="{StaticResource SuccessBrush}"
                                        Width="{StaticResource IndicatorSize}"
                                        Height="{StaticResource IndicatorSize}"
                                        CornerRadius="{StaticResource TinyCornerRadius}" />
                                <TextBlock Text="下跌"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 刷新中提示（已有内容时不闪骨架屏） -->
                            <TextBlock Text="正在刷新..."
                                       FontSize="{StaticResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding IsRefreshing}"/>
                        </StackPanel>

                        <!-- 时间周期按钮组、指标开关与刷新 -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource SmallSpacing}"
                                    VerticalAlignment="Center">
                            <!-- 指标开关：控制主图叠加（MA/BOLL）、副图（VOL/MACD/KDJ）与左上角图例显隐 -->
                            <Button Classes="action-button"
                                    ToolTip.Tip="指标显示开关">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                                    <svg:Svg Path="/Assets/Images/icon_ai.svg" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="指标" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Width="160" Spacing="{StaticResource SmallSpacing}">
                                            <TextBlock Text="主图指标"
                                                       Classes="sectionHeader"/>
                                            <CheckBox Content="均线 MA" IsChecked="{Binding IsMaVisible}"/>
                                            <CheckBox Content="BOLL" IsChecked="{Binding IsBollVisible}"/>
                                            <TextBlock Text="副图指标"
                                                       Classes="sectionHeader"/>
                                            <CheckBox Content="成交量 VOL" IsChecked="{Binding IsVolVisible}"/>
                                            <CheckBox Content="MACD" IsChecked="{Binding IsMacdVisible}"/>
                                            <CheckBox Content="KDJ" IsChecked="{Binding IsKdjVisible}"/>
                                            <TextBlock Text="图例"
                                                       Classes="sectionHeader"/>
                                            <CheckBox Content="左上角行情图例" IsChecked="{Binding IsLegendVisible}"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button Classes="action-button"
                                    Command="{Binding RefreshDataCommand}"
                                    ToolTip.Tip="刷新行情数据">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                                    <svg:Svg Path="/Assets/Images/icon_refresh.svg" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="刷新" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Background="{DynamicResource SurfaceVariantBrush}"
                                    CornerRadius="{StaticResource SmallCornerRadius}"
                                    Padding="{StaticResource TinyPadding}">
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <Button Content="分时"
                                            Classes="period-button"
                                            Classes.selected="{Binding IsMinuteSelected}"
                                            Command="{Binding ChangeKLineTypeCommand}"
                                            CommandParameter="minute" />

                                    <Button Content="日K"
                                            Classes="period-button"
                                            Classes.selected="{Binding IsDailySelected}"
                                            Command="{Binding ChangeKLineTypeCommand}"
                                            CommandParameter="daily" />

                                    <Button Content="周K"
                                            Classes="period-button"
                                            Classes.selected="{Binding IsWeeklySelected}"
                                            Command="{Binding ChangeKLineTypeCommand}"
                                            CommandParameter="weekly" />

                                    <Button Content="月K"
                                            Classes="period-button"
                                            Classes.selected="{Binding IsMonthlySelected}"
                                            Command="{Binding ChangeKLineTypeCommand}"
                                            CommandParameter="monthly" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 图表显示区域 -->
                    <Grid Grid.Row="1">
                        <!-- 骨架屏：仅首屏加载、且已持续超过 300ms 时出现（快数据源不闪）。
                             周期按钮在上一行常驻，这里不再重复占位——给已经存在的东西做占位只是噪声。
                             K 线一就绪即绑定层撤下，不会盖在新绘制出来的图表上。 -->
                        <controls:SkeletonCard Variant="Bare"
                                               Margin="{StaticResource DefaultMargin}"
                                               IsVisible="{Binding IsSkeletonVisible}">
                            <StackPanel Spacing="{StaticResource SmallSpacing}">
                                <controls:SkeletonLines Orientation="Horizontal"
                                                        Row="Caption"
                                                        LineCount="4"
                                                        LineWidth="120"
                                                        Spacing="{StaticResource SmallSpacing}"/>
                                <controls:SkeletonLines Row="BodySm"
                                                        LineCount="10"
                                                        LineWidths="*"
                                                        Spacing="{StaticResource SmallSpacing}"/>
                                <controls:SkeletonLines Row="Caption" LineWidths="160"/>
                            </StackPanel>
                        </controls:SkeletonCard>

                        <!-- K线图表 -->
                        <components:KLineChartView x:Name="WebChartView"
                                                   Data="{Binding KLineData}"
                                                   IsMaVisible="{Binding IsMaVisible}"
                                                   IsBollVisible="{Binding IsBollVisible}"
                                                   IsVolVisible="{Binding IsVolVisible}"
                                                   IsMacdVisible="{Binding IsMacdVisible}"
                                                   IsKdjVisible="{Binding IsKdjVisible}"
                                                   IsLegendVisible="{Binding IsLegendVisible}"
                                                   IsVisible="{Binding IsReady}" />

                        <!-- 空态 / 失败态（含重试入口） -->
                        <controls:StateOverlayView State="{Binding OverlayState}"
                                                   Message="{Binding OverlayMessage}"
                                                   RetryCommand="{Binding RetryCommand}"
                                                   RetryText="重新加载"
                                                   ShowLoading="False"
                                                   MinHeight="400"/>
                    </Grid>
                </Grid>
            </controls:CardView>

            <!-- 右侧面板：行情数据 / 盘口（恒显，不再折叠）。
                 用 MaxWidth 而非固定 Width：窄窗下让出空间给 K 线主栏 -->
            <ScrollViewer Grid.Column="1"
                          MinWidth="260" MaxWidth="360"
                          Margin="{StaticResource RightMargin}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource DefaultSpacing}">

                    <!-- 行情数据：快照级指标（换手率 / 量比 / 市盈率 / 市净率）。
                         开高低收、成交量、成交额、振幅等逐 bar 指标由 K 线图左上角图例展示；
                         ETF/基金等快照无指标数据源，整卡隐藏（SnapshotSectionVisible） -->
                    <Border Classes="rightSection" IsVisible="{Binding SnapshotSectionVisible}">
                        <StackPanel>
                            <TextBlock Classes="sectionHeader" Text="行情数据"/>

                            <!-- 骨架：6 组「标签 + 数值」两列指标。这里必须保留 Grid + WrapPanel：
                                 指标是网格布局而非线性行，用线性控件表达会丢掉列对齐。 -->
                            <WrapPanel IsVisible="{Binding SnapshotSkeletonVisible}"
                                       Margin="{StaticResource SmallTopMargin}">
                                <Grid Width="148" Margin="0,0,16,8" ColumnDefinitions="Auto,*">
                                    <controls:SkeletonLines Grid.Column="0" Row="Caption" LineCount="1" LineWidths="44"/>
                                    <controls:SkeletonLines Grid.Column="1" Row="Caption" LineCount="1" LineWidths="48"
                                                            HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Width="148" Margin="0,0,16,8" ColumnDefinitions="Auto,*">
                                    <controls:SkeletonLines Grid.Column="0" Row="Caption" LineCount="1" LineWidths="32"/>
                                    <controls:SkeletonLines Grid.Column="1" Row="Caption" LineCount="1" LineWidths="44"
                                                            HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Width="148" Margin="0,0,16,8" ColumnDefinitions="Auto,*">
                                    <controls:SkeletonLines Grid.Column="0" Row="Caption" LineCount="1" LineWidths="44"/>
                                    <controls:SkeletonLines Grid.Column="1" Row="Caption" LineCount="1" LineWidths="52"
                                                            HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Width="148" Margin="0,0,16,8" ColumnDefinitions="Auto,*">
                                    <controls:SkeletonLines Grid.Column="0" Row="Caption" LineCount="1" LineWidths="32"/>
                                    <controls:SkeletonLines Grid.Column="1" Row="Caption" LineCount="1" LineWidths="40"
                                                            HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Width="148" Margin="0,0,16,8" ColumnDefinitions="Auto,*">
                                    <controls:SkeletonLines Grid.Column="0" Row="Caption" LineCount="1" LineWidths="44"/>
                                    <controls:SkeletonLines Grid.Column="1" Row="Caption" LineCount="1" LineWidths="48"
                                                            HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Width="148" Margin="0,0,16,8" ColumnDefinitions="Auto,*">
                                    <controls:SkeletonLines Grid.Column="0" Row="Caption" LineCount="1" LineWidths="32"/>
                                    <controls:SkeletonLines Grid.Column="1" Row="Caption" LineCount="1" LineWidths="44"
                                                            HorizontalAlignment="Right"/>
                                </Grid>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="{StaticResource SmallSpacing}"
                                        Margin="{StaticResource SmallTopMargin}"
                                        IsVisible="{Binding SnapshotState.ShowHint}">
                                <TextBlock Text="{Binding SnapshotState.HintText}"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Content="重试"
                                        Classes="btn-ghost btn-sm"
                                        IsVisible="{Binding SnapshotState.IsFailed}"
                                        Command="{Binding RetrySectionCommand}"
                                        CommandParameter="Snapshot"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding MarketMetrics}"
                                          Margin="{StaticResource SmallTopMargin}"
                                          IsVisible="{Binding SnapshotState.HasData}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MarketMetricItem">
                                        <Grid Width="148" Margin="0,0,16,8" ColumnDefinitions="Auto,*" IsVisible="{Binding HasValue}">
                                            <TextBlock Grid.Column="0" Classes="cellLabel" Text="{Binding Label}"/>
                                            <TextBlock Grid.Column="1" Classes="metricValue" Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 盘口买卖档位（仅提供盘口数据的市场可见；币安十档，A 股数据源固定五档） -->
                    <Border Classes="rightSection" IsVisible="{Binding SupportsOrderBook}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="sectionHeader" Text="盘口"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding OrderBookSummaryText}"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 骨架：与真实盘口同构——表头 1 行 + 卖五档 + 中间价 + 买五档 + 占比条。
                                 每档 20 高、行间 2px，总高与数据到达后完全一致（五档市场也吻合）。 -->
                            <StackPanel Margin="{StaticResource SmallTopMargin}"
                                        IsVisible="{Binding OrderBookSkeletonVisible}">
                                <Grid ColumnDefinitions="34,*,56,60" Margin="0,0,0,2">
                                    <controls:SkeletonLines Grid.Column="0" Row="Caption" LineCount="1" LineWidths="20"/>
                                    <controls:SkeletonLines Grid.Column="1" Row="Caption" LineCount="1" LineWidths="48"
                                                            HorizontalAlignment="Right"/>
                                    <controls:SkeletonLines Grid.Column="2" Row="Caption" LineCount="1" LineWidths="36"
                                                            HorizontalAlignment="Right"/>
                                    <controls:SkeletonLines Grid.Column="3" Row="Caption" LineCount="1" LineWidths="42"
                                                            HorizontalAlignment="Right"/>
                                </Grid>
                                <!-- 五档：真实档位高 20 + 上下各 1px 行距；行高由 RowHeight 覆盖 -->
                                <controls:SkeletonLines Row="BodySm" RowHeight="20" LineCount="5"
                                                        Spacing="2" LineWidths="*"/>
                                <controls:SkeletonLines Row="BodySm" LineCount="1" LineWidths="72" Margin="0,4"/>
                                <controls:SkeletonLines Row="BodySm" RowHeight="20" LineCount="5"
                                                        Spacing="2" LineWidths="*"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                    <Border Grid.Column="0" Classes="skeleton" Height="6"
                                            CornerRadius="{StaticResource TinyCornerRadius}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                                    <controls:SkeletonLines Grid.Column="1" Row="Caption" LineCount="1" LineWidths="36"
                                                            VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                       Spacing="{StaticResource SmallSpacing}"
                                       Margin="{StaticResource SmallTopMargin}"
                                       IsVisible="{Binding OrderBookState.ShowHint}">
                                <TextBlock Text="{Binding OrderBookState.HintText}"
                                          FontSize="{StaticResource CaptionFontSize}"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          TextWrapping="Wrap"
                                          VerticalAlignment="Center"/>
                                <Button Content="重试"
                                       Classes="btn-ghost btn-sm"
                                       IsVisible="{Binding OrderBookState.IsFailed}"
                                       Command="{Binding RetrySectionCommand}"
                                       CommandParameter="OrderBook"/>
                            </StackPanel>

                            <StackPanel Margin="{StaticResource SmallTopMargin}"
                                        IsVisible="{Binding OrderBookState.HasData}">
                                <!-- 表头 -->
                                <Grid ColumnDefinitions="34,*,56,60" Margin="0,0,0,2">
                                    <TextBlock Grid.Column="0" Classes="cellLabel" Text="档位"/>
                                    <TextBlock Grid.Column="1" Classes="cellLabel" Text="价格" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Classes="cellLabel" Text="数量" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Classes="cellLabel" Text="金额" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- 卖盘：卖五 → 卖一 -->
                                <ItemsControl ItemsSource="{Binding Asks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OrderBookLevelItem">
                                            <Grid ColumnDefinitions="34,*,56,60" Height="20" Margin="0,1">
                                                <ProgressBar Grid.ColumnSpan="4"
                                                             Classes="depthBar"
                                                             Value="{Binding DepthPercent}"
                                                             Maximum="100"
                                                             Foreground="{Binding ToneValue, Converter={StaticResource PriceChangeColorConverter}, ConverterParameter=tag}"/>
                                                <TextBlock Grid.Column="0" Classes="cellLabel" Text="{Binding LevelLabel}"/>
                                                <TextBlock Grid.Column="1" Classes="cellValue"
                                                           Text="{Binding PriceText}"
                                                           Foreground="{Binding ToneValue, Converter={StaticResource PriceChangeColorConverter}}"/>
                                                <TextBlock Grid.Column="2" Classes="cellValue"
                                                           Text="{Binding QuantityText}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="3" Classes="cellValue"
                                                           Text="{Binding AmountText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 中间价 -->
                                <TextBlock Text="{Binding CurrentPriceText}"
                                           Margin="0,4"
                                           FontFamily="{StaticResource DataFontFamily}"
                                           FontSize="{StaticResource BodySmFontSize}"
                                           FontWeight="{DynamicResource WeightTitle}"
                                           Foreground="{Binding PriceChange, Converter={StaticResource PriceChangeColorConverter}}"/>

                                <!-- 买盘：买一 → 买五 -->
                                <ItemsControl ItemsSource="{Binding Bids}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:OrderBookLevelItem">
                                            <Grid ColumnDefinitions="34,*,56,60" Height="20" Margin="0,1">
                                                <ProgressBar Grid.ColumnSpan="4"
                                                             Classes="depthBar"
                                                             Value="{Binding DepthPercent}"
                                                             Maximum="100"
                                                             Foreground="{Binding ToneValue, Converter={StaticResource PriceChangeColorConverter}, ConverterParameter=tag}"/>
                                                <TextBlock Grid.Column="0" Classes="cellLabel" Text="{Binding LevelLabel}"/>
                                                <TextBlock Grid.Column="1" Classes="cellValue"
                                                           Text="{Binding PriceText}"
                                                           Foreground="{Binding ToneValue, Converter={StaticResource PriceChangeColorConverter}}"/>
                                                <TextBlock Grid.Column="2" Classes="cellValue"
                                                           Text="{Binding QuantityText}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="3" Classes="cellValue"
                                                           Text="{Binding AmountText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 买卖挂单占比 -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                    <ProgressBar Grid.Column="0"
                                                 Classes="depthBar"
                                                 Height="6"
                                                 Value="{Binding BidQuantityPercent}"
                                                 Maximum="100"
                                                 Foreground="{StaticResource BullishBrush}"
                                                 Background="{StaticResource BearishBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BidQuantityPercentText}"
                                               FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 无盘口的市场给出明确说明，避免误判为加载失败 -->
                    <Border Classes="rightSection"
                            IsVisible="{Binding !SupportsOrderBook}">
                        <StackPanel Spacing="{StaticResource TinySpacing}">
                            <TextBlock Classes="sectionHeader" Text="盘口"/>
                            <TextBlock Text="当前市场暂无盘口数据源，已展示行情数据。"
                                       FontSize="{StaticResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
