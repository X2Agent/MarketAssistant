<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:views="using:MarketAssistant.Views.Components"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:converts="using:MarketAssistant.Converters"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.AgentAnalysisPageView"
             x:DataType="vm:AgentAnalysisViewModel"
             x:Name="ParentPage">

    <!-- 报告工作区：报告区独占整宽，智能助手以遮罩抽屉叠在其上（不挤压主区） -->
    <Grid>
        <!-- 进度显示区域 - 仅在分析时显示 -->
        <views:ProgressDisplayView
            IsVisible="{Binding IsBusy}"
            AnalysisStage="{Binding AnalysisStage}"
            ProgressPercent="{Binding AnalysisProgressPercent}"
            AnalysisPhase="{Binding AnalysisPhase}"
            AnalystRunItems="{Binding AnalystRunItems}"
            UsageSummaryText="{Binding UsageSummaryText}"
            UsageDetailText="{Binding UsageDetailText}"
            FailedAnalystsInfo="{Binding FailedAnalystsInfo}"
            CancelCommand="{Binding CancelAnalysisCommand}"/>

        <!-- 分析完成后的内容区域 -->
        <Grid IsVisible="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}">
            <!-- 主研报区：独占整宽 -->
            <Grid ClipToBounds="True">
                <!-- 报告内容区域（仅在成功产出报告后展示） -->
                <Grid IsVisible="{Binding HasActiveReport}">
                    <!-- 智能分析报告区域 -->
                    <ContentControl Content="{Binding AnalysisReportViewModel}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:AnalysisReportViewModel">
                                <views:AnalysisReportView DataContext="{Binding}"/>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <!-- 水印控件 -->
                    <controls:WatermarkView 
                        Text="数据来源网络，仅供参考。投资有风险，入市需谨慎！" 
                        OpacityValue="0.15" 
                        Angle="-30" 
                        FontSize="{StaticResource DisplayFontSize}" 
                        HorizontalRepeatCount="2" 
                        VerticalRepeatCount="4" 
                        ZIndex="999" 
                        IsHitTestVisible="False"/>

                    <!-- 智能助手 FAB（抽屉打开时隐藏，避免叠在遮罩下仍被点击） -->
                    <Button Classes="btn-primary"
                            Margin="{StaticResource FABMargin}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            ZIndex="1000"
                            Width="{StaticResource FABSize}"
                            Height="{StaticResource FABSize}"
                            CornerRadius="{StaticResource FABCornerRadius}"
                            Padding="{StaticResource NoPadding}"
                            Command="{Binding ToggleChatSidebarCommand}"
                            IsVisible="{Binding !IsChatSidebarVisible}"
                            ToolTip.Tip="智能助手"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <svg:Svg Path="/Assets/Images/icon_chat.svg"
                                 Width="{StaticResource DefaultIconSize}"
                                 Height="{StaticResource DefaultIconSize}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- 报告区空态 / 失败态（含重新分析入口）：分析中由进度视图接管，有报告时由报告视图接管 -->
                <controls:StateOverlayView State="{Binding ReportOverlayState}"
                                           Message="{Binding ReportOverlayMessage}"
                                           RetryCommand="{Binding RetryAnalysisCommand}"
                                           RetryText="重新分析"
                                           ShowLoading="False"
                                           ZIndex="1"/>
            </Grid>

            <!-- 智能助手抽屉的遮罩：叠在报告之上，点击任意处收起。
                 遮罩只做视觉压低与命中拦截，抽屉本身在其右侧独立浮层。 -->
            <Border IsVisible="{Binding IsChatSidebarVisible}"
                    Background="{DynamicResource DarkOverlayBrush}"
                    ZIndex="1001"
                    Tapped="OnChatDrawerScrimTapped"/>

            <!-- 智能助手抽屉：贴右边缘浮出（无外边距，避免右侧留出无意义空隙），
                 主报告区宽度保持不变。圆角只保留左侧两角，右侧与窗口边齐平。
                 悬浮阴影（真正遮挡内容，符合 v3 阴影纪律层级 2）。 -->
            <Border IsVisible="{Binding IsChatSidebarVisible}"
                    HorizontalAlignment="Right"
                    Width="{StaticResource ChatDrawerWidth}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderThickness="{StaticResource NoBorderThickness}"
                    CornerRadius="{StaticResource ChatDrawerCornerRadius}"
                    BoxShadow="{StaticResource ShadowOverlay}"
                    ClipToBounds="True"
                    ZIndex="1002">
                <ContentControl Content="{Binding ChatSidebarViewModel}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:ChatSidebarViewModel">
                            <views:ChatSidebarView DataContext="{Binding}"
                                                  CloseCommand="{Binding #ParentPage.((vm:AgentAnalysisViewModel)DataContext).ToggleChatSidebarCommand}" />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
