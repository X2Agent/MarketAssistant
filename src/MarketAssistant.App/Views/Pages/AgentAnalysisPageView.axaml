<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:views="using:MarketAssistant.Views.Components"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:converts="using:MarketAssistant.Converters"
             xmlns:models="using:MarketAssistant.Services.Archive"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.AgentAnalysisPageView"
             x:DataType="vm:AgentAnalysisViewModel"
             x:Name="ParentPage">

    <UserControl.Resources>
        <x:Double x:Key="MenuFlyoutWidth">260</x:Double>
        <x:Double x:Key="HistoryListMaxHeight">240</x:Double>
    </UserControl.Resources>

    <!-- 遮罩式布局：主内容全宽，侧边栏作为浮层叠加在右侧 -->
    <Panel>
        <!-- 主内容区域 -->
        <Grid ClipToBounds="True">
            <!-- 进度显示区域 - 仅在分析时显示 -->
            <views:ProgressDisplayView 
                IsVisible="{Binding IsBusy}"
                AnalysisStage="{Binding AnalysisStage}"
                ProgressPercent="{Binding AnalysisProgressPercent}"
                FailedAnalystsInfo="{Binding FailedAnalystsInfo}"
                CancelCommand="{Binding CancelAnalysisCommand}"/>

            <!-- 分析完成后的内容区域 -->
            <Grid IsVisible="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}"
                  RowDefinitions="Auto,*">

                <!-- 顶部工具栏：包含更多操作菜单按钮 -->
                <Border Grid.Row="0"
                        Height="48"
                        Background="Transparent"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="{StaticResource BottomBorderThickness}"
                        Padding="8,0">
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="{StaticResource SmallIconButtonSize}"
                            Height="{StaticResource SmallIconButtonSize}"
                            CornerRadius="{StaticResource SmallCornerRadius}"
                            Background="Transparent"
                            BorderThickness="{StaticResource NoBorderThickness}"
                            Padding="0"
                            FontSize="{StaticResource LargeFontSize}"
                            Content="⋮"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="更多操作">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource PressedBackgroundBrush}"/>
                            </Style>
                        </Button.Styles>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Width="{StaticResource MenuFlyoutWidth}">
                                    <StackPanel>
                                        <StackPanel.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Transitions">
                                                    <Transitions>
                                                        <BrushTransition Property="Background" Duration="0:0:0.15"/>
                                                    </Transitions>
                                                </Setter>
                                            </Style>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </Style>
                                            <Style Selector="Button:disabled">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </Style>
                                        </StackPanel.Styles>

                                        <!-- 导出报告 -->
                                        <Button HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="{StaticResource NoBorderThickness}"
                                                Padding="{StaticResource CompactCardPadding}"
                                                Margin="{StaticResource TinyBottomMargin}"
                                                Command="{Binding ExportReportCommand}"
                                                IsEnabled="{Binding CanExportReport}">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource DefaultSpacing}">
                                                <svg:Svg Path="/Assets/Images/icon_document.svg"
                                                         Width="{StaticResource LabelFontSize}"
                                                         Height="{StaticResource LabelFontSize}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="导出 Markdown 报告" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- 分隔线 -->
                                        <Border Height="{StaticResource DividerHeight}"
                                                Background="{DynamicResource DividerBrush}"
                                                Margin="{StaticResource TinyVerticalMargin}"
                                                IsVisible="{Binding HasReportHistory}"/>

                                        <!-- 历史报告标题 -->
                                        <TextBlock Text="历史报告"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource SmallFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="8,4,8,4"
                                                   IsVisible="{Binding HasReportHistory}"/>

                                        <!-- 历史报告列表（可滚动） -->
                                        <ScrollViewer MaxHeight="{StaticResource HistoryListMaxHeight}"
                                                      IsVisible="{Binding HasReportHistory}"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ReportHistory}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ReportSummary">
                                                        <Button HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Background="Transparent"
                                                                BorderThickness="{StaticResource NoBorderThickness}"
                                                                Padding="8,4"
                                                                Margin="{StaticResource TinyBottomMargin}"
                                                                Command="{Binding $parent[ItemsControl].((vm:AgentAnalysisViewModel)DataContext).LoadHistoryReportCommand}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Spacing="{StaticResource CompactSpacing}">
                                                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                                           FontSize="{StaticResource SmallFontSize}"
                                                                           FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding ScoreTrendText}"
                                                                           FontSize="{StaticResource TinyFontSize}"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding KeyScoreChangeText}"
                                                                           FontSize="{StaticResource TinyFontSize}"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- 无历史报告占位 -->
                                        <TextBlock Text="暂无历史报告"
                                                   FontSize="{StaticResource SmallFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,12"
                                                   IsVisible="{Binding !HasReportHistory}"/>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Border>

                <!-- 报告内容区域（仅在成功产出报告后展示） -->
                <Grid Grid.Row="1"
                      IsVisible="{Binding HasActiveReport}">
                    <!-- 智能分析报告区域 -->
                    <ContentControl Content="{Binding AnalysisReportViewModel}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:AnalysisReportViewModel">
                                <views:AnalysisReportView DataContext="{Binding}"/>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <!-- 水印控件 -->
                    <controls:WatermarkView 
                        Text="数据来源网络，仅供参考。投资有风险，入市需谨慎！" 
                        OpacityValue="0.15" 
                        Angle="-30" 
                        FontSize="{StaticResource ExtraLargeFontSize}" 
                        HorizontalRepeatCount="2" 
                        VerticalRepeatCount="4" 
                        ZIndex="999" 
                        IsHitTestVisible="False"/>

                    <!-- 智能对话 FAB -->
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            ZIndex="1000"
                            Width="{StaticResource FABSize}"
                            Height="{StaticResource FABSize}"
                            CornerRadius="{StaticResource FABCornerRadius}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="{StaticResource TextOnEmphasisBrush}"
                            BorderThickness="{StaticResource NoBorderThickness}"
                            Padding="0"
                            Command="{Binding ToggleChatSidebarCommand}"
                            ToolTip.Tip="智能对话"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <svg:Svg Path="/Assets/Images/icon_chat.svg"
                                 Width="24" Height="24"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>

                <!-- 分析未完成状态：分析失败或取消且无报告可展示时出现 -->
                <Border Grid.Row="1"
                        IsVisible="{Binding !HasActiveReport}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="{StaticResource DefaultBorderThickness}"
                        CornerRadius="{StaticResource DefaultCornerRadius}"
                        Padding="{StaticResource DefaultCardPadding}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="{StaticResource ProgressDialogWidth}">
                    <StackPanel Spacing="{StaticResource DefaultSpacing}">
                        <svg:Svg Path="/Assets/Images/icon_warning.svg"
                                 Width="28" Height="28"
                                 HorizontalAlignment="Center"/>

                        <TextBlock Text="分析未完成"
                                   FontSize="{StaticResource LargeFontSize}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock Text="{Binding AnalysisFailureMessage}"
                                   FontSize="{StaticResource SmallFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding AnalysisFailureMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <Button Content="重新分析"
                                Command="{Binding RetryAnalysisCommand}"
                                HorizontalAlignment="Center"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="{StaticResource TextOnEmphasisBrush}"
                                BorderThickness="{StaticResource NoBorderThickness}"
                                CornerRadius="{StaticResource SmallCornerRadius}"
                                Padding="{StaticResource CompactCardPadding}">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                </Style>
                                <Style Selector="Button:pressed /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 半透明遮罩层：点击可关闭侧边栏 -->
        <Border Background="{DynamicResource DarkOverlayBrush}"
                IsVisible="{Binding IsChatSidebarVisible}"
                ZIndex="1500"
                Focusable="False"
                Tapped="OnOverlayTapped"/>

        <!-- 聊天侧边栏（浮层，右对齐） -->
        <Border IsVisible="{Binding IsChatSidebarVisible}"
                HorizontalAlignment="Right"
                Width="{StaticResource SidebarDefaultWidth}"
                MaxWidth="{StaticResource SidebarMaxWidth}"
                ZIndex="2000"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource LeftBorderThickness}"
                BoxShadow="{StaticResource SidebarBoxShadow}">
            <ContentControl Content="{Binding ChatSidebarViewModel}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:ChatSidebarViewModel">
                        <views:ChatSidebarView DataContext="{Binding}"
                                              CloseCommand="{Binding #ParentPage.((vm:AgentAnalysisViewModel)DataContext).ToggleChatSidebarCommand}" />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
    </Panel>
</UserControl>
