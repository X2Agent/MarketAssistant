<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:models="using:MarketAssistant.Applications.InvestmentSelection.Models"
             xmlns:converts="using:MarketAssistant.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.AssetSelectionPageView"
             x:DataType="vm:AssetSelectionPageViewModel"
             x:Name="Root">

    <Design.DataContext>
        <vm:AssetSelectionPageViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <converts:NullableValueConverter x:Key="NullableValueConverter"/>
        <converts:NullableVisibilityConverter x:Key="NullableVisibilityConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- 加载指示器（优化后的覆盖层） -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="{DynamicResource DarkOverlayBrush}"
                IsVisible="{Binding IsBusy}"
                ZIndex="1000">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="{StaticResource LargeCornerRadius}"
                    Padding="{StaticResource ProgressDialogPadding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="{StaticResource InputAreaMinWidth}"
                    MaxWidth="{StaticResource InputAreaMaxWidth}"
                    BoxShadow="{StaticResource ElevatedBoxShadow}">
                <StackPanel Spacing="{StaticResource LargeSpacing}">
                    <!-- 加载动画区域 - 复用统一的三点脉冲动画组件 -->
                    <controls:LoadingDots/>
                    
                    <!-- 文本信息 -->
                    <StackPanel Spacing="{StaticResource SmallSpacing}">
                        <TextBlock Text="正在分析中" 
                                   FontSize="{StaticResource LargeFontSize}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LoadingText}"
                                   FontSize="{StaticResource LabelFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="{StaticResource MessageMaxWidth}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="{StaticResource PagePadding}" Spacing="{StaticResource LargeSpacing}">
                
                <!-- 页面标题 -->
                <TextBlock Text="{Binding PageTitle}" 
                           FontSize="{StaticResource TitleFontSize}"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="{StaticResource TinyBottomMargin}"/>

            <!-- 智能选股输入区域 -->
            <controls:CardView>
                <StackPanel Spacing="{StaticResource DefaultSpacing}">
                    <!-- 选股模式选择器 -->
                    <TextBlock Text="{Binding ModeLabel}" 
                               FontSize="{StaticResource SectionTitleFontSize}" 
                               FontWeight="Bold"/>
                    
                    <!-- 验证提示消息 -->
                    <Border Background="{StaticResource WarningLightBrush}"
                            BorderBrush="{StaticResource WarningBorderBrush}"
                            BorderThickness="{StaticResource DefaultBorderThickness}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource DefaultCardPadding}"
                            IsVisible="{Binding HasValidationMessage}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="ℹ️" 
                                       FontSize="{StaticResource SectionTitleFontSize}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ValidationMessage}"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{StaticResource WarningTextBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <ItemsControl ItemsSource="{Binding SelectionModes}" Height="{StaticResource ModeSelectionHeight}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SelectionModeItem">
                                <Border Classes.mode-card="True"
                                        Classes.selected="{Binding IsSelected}"
                                        MinWidth="{StaticResource ButtonMinWidth}"
                                        Focusable="True"
                                        KeyDown="OnCardKeyDown"
                                        AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Spacing="{StaticResource TinySpacing}">
                                        <TextBlock Text="{Binding Icon}" 
                                                   FontSize="{StaticResource LargeFontSize}" 
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" 
                                                   FontSize="{StaticResource SmallFontSize}" 
                                                   FontWeight="Bold"
                                                   Classes="mode-name"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- 统一输入框 -->
                    <TextBox Text="{Binding CurrentInputContent}"
                             PlaceholderText="{Binding CurrentPlaceholder}"
                             Height="{StaticResource CompactTextAreaHeight}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsVisible="{Binding IsInputAreaVisible}"/>
                    
                    <!-- 操作按钮 -->
                    <StackPanel Orientation="Horizontal" 
                                Spacing="{StaticResource SmallSpacing}"
                                IsVisible="{Binding IsInputAreaVisible}">
                        <Button Content="{Binding CurrentButtonText}"
                                Command="{Binding ExecuteAnalysisCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                HorizontalAlignment="Stretch"
                                Padding="{StaticResource PagePadding}"
                                MinWidth="{StaticResource ButtonMinWidth}"/>
                        <Button Content="清除"
                                Command="{Binding ClearContentCommand}"
                                Padding="{StaticResource PagePadding}"
                                MinWidth="{StaticResource SmallButtonMinWidth}"/>
                    </StackPanel>
                </StackPanel>
            </controls:CardView>

            <!-- 快速选股策略 -->
            <controls:CardView IsVisible="{Binding IsQuickStrategyAreaVisible}">
                <StackPanel Spacing="{StaticResource DefaultSpacing}">
                    <TextBlock Text="{Binding QuickStrategyTitle}" 
                               FontSize="{StaticResource SectionTitleFontSize}" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding QuickStrategyDescription}" 
                               FontSize="{StaticResource SmallFontSize}" 
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <ItemsControl ItemsSource="{Binding QuickStrategies}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:QuickSelectionStrategyInfo">
                                <Border Classes="strategy-card"
                                        Margin="{StaticResource SmallMargin}"
                                        Focusable="True"
                                        KeyDown="OnCardKeyDown"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <!-- 图标 -->
                                        <Border Grid.Column="0"
                                                Width="{StaticResource LargeIconSize}" 
                                                Height="{StaticResource LargeIconSize}"
                                                CornerRadius="{StaticResource SmallCornerRadius}"
                                                Background="{DynamicResource SurfaceVariantBrush}"
                                                Margin="{StaticResource RightMargin}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}"
                                                       FontSize="{StaticResource TitleFontSize}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- 文本内容 -->
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="{StaticResource LabelFontSize}" 
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Description}" 
                                                       FontSize="{StaticResource SmallFontSize}" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:CardView>
            
            <!-- 选股结果显示区域 -->
            <controls:CardView IsVisible="{Binding HasResult}">
                <StackPanel Spacing="{StaticResource DefaultSpacing}">
                    <TextBlock Text="{Binding ResultTitle}" 
                               FontSize="{StaticResource SubTitleFontSize}" 
                               FontWeight="Bold"/>
                    
                    <!-- AI 置信度显示 -->
                    <Border Background="{StaticResource InfoBackgroundAltBrush}"
                            BorderBrush="{StaticResource InfoBorderBrush}"
                            BorderThickness="{StaticResource ThickBorderThickness}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" 
                                        Orientation="Horizontal" 
                                        Spacing="{StaticResource SmallSpacing}"
                                        VerticalAlignment="Center">
                                <TextBlock Text="🤖" 
                                           FontSize="{StaticResource LargeFontSize}"/>
                                <TextBlock Text="AI 置信度" 
                                           FontSize="{StaticResource MediumFontSize}" 
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <ProgressBar Grid.Column="1"
                                         Value="{Binding SelectionResult.ConfidenceScore}"
                                         Maximum="100"
                                         Height="{StaticResource ProgressBarHeight}"
                                         Margin="{StaticResource HorizontalMargin}"
                                         CornerRadius="{StaticResource TinyCornerRadius}"
                                         VerticalAlignment="Center"/>
                            
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SelectionResult.ConfidenceScore, StringFormat={}{0:F1}%}"
                                       FontSize="{StaticResource LargeFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource InfoBorderBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- 分析摘要 -->
                    <Border Background="{DynamicResource ItemBackgroundBrush}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}">
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="📋 分析摘要" 
                                       FontSize="{StaticResource MediumFontSize}" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectionResult.AnalysisSummary}"
                                       FontSize="{StaticResource LabelFontSize}"
                                       TextWrapping="Wrap"
                                       LineHeight="{StaticResource DefaultLineHeight}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 市场环境分析 -->
                    <Border Background="{DynamicResource ItemBackgroundBrush}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}">
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="📊 市场环境分析" 
                                       FontSize="{StaticResource MediumFontSize}" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectionResult.MarketEnvironmentAnalysis}"
                                       FontSize="{StaticResource LabelFontSize}"
                                       TextWrapping="Wrap"
                                       LineHeight="{StaticResource DefaultLineHeight}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 投资建议 -->
                    <Border Background="{StaticResource InfoLightBrush}"
                            BorderBrush="{StaticResource InfoBorderBrush}"
                            BorderThickness="{StaticResource ThickBorderThickness}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}">
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="💡 投资建议" 
                                       FontSize="{StaticResource MediumFontSize}" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource InfoTextBrush}"/>
                            <TextBlock Text="{Binding SelectionResult.InvestmentAdvice}"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{StaticResource InfoTextDarkBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="{StaticResource DefaultLineHeight}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- 推荐股票列表 -->
                    <TextBlock Text="{Binding RecommendationTitle}" 
                               FontSize="{StaticResource SectionTitleFontSize}" 
                               FontWeight="Bold" 
                               Margin="{StaticResource SmallTopMargin}"/>
                    
                    <ItemsControl ItemsSource="{Binding RecommendedStocks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource SmallSpacing}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:InvestmentRecommendation">
                                    <Border Background="{DynamicResource ItemBackgroundBrush}"
                                            CornerRadius="{StaticResource MediumCornerRadius}"
                                            Padding="{StaticResource DefaultCardPadding}"
                                            BoxShadow="{StaticResource CardBoxShadow}">
                                        <StackPanel Spacing="{StaticResource SmallSpacing}">

                                            <!-- 头部：股票信息 + 标签 + 评分 + 操作按钮 -->
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                <!-- 名称（主标题） -->
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding Name}" 
                                                           FontSize="{StaticResource SubTitleFontSize}" 
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- 右侧：评分 + 按钮 -->
                                                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                            Spacing="{StaticResource TinySpacing}"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <Border Background="{StaticResource PrimaryBrush}"
                                                            CornerRadius="{StaticResource CardCornerRadius}"
                                                            Padding="{StaticResource CompactCardPadding}"
                                                            HorizontalAlignment="Right">
                                                        <StackPanel Spacing="{StaticResource CompactSpacing}">
                                                            <TextBlock Text="{Binding RecommendationScore, StringFormat={}{0}分}"
                                                                       FontSize="{StaticResource MediumFontSize}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource WarningBorderBrush}"
                                                                       HorizontalAlignment="Center"/>
                                                            <TextBlock Text="推荐评分"
                                                                       FontSize="{StaticResource MiniFontSize}"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" 
                                                                Spacing="{StaticResource TinySpacing}"
                                                                HorizontalAlignment="Right">
                                                        <Button Content="查看详情" 
                                                                Command="{Binding #Root.DataContext.ViewStockDetailCommand}"
                                                                CommandParameter="{Binding}"
                                                                Padding="{StaticResource TagPadding}"
                                                                FontSize="{StaticResource TinyFontSize}"
                                                                CornerRadius="{StaticResource TinyCornerRadius}"/>
                                                        <Button Content="加入自选" 
                                                                Command="{Binding #Root.DataContext.AddToFavoritesCommand}"
                                                                CommandParameter="{Binding}"
                                                                Padding="{StaticResource TagPadding}"
                                                                FontSize="{StaticResource TinyFontSize}"
                                                                CornerRadius="{StaticResource TinyCornerRadius}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 代码 + 仓位/期限/风险 同一行 -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                                                            Spacing="{StaticResource TinySpacing}"
                                                            VerticalAlignment="Center"
                                                            Margin="{StaticResource TinyTopMargin}">
                                                    <TextBlock Text="{Binding Symbol}" 
                                                               FontSize="{StaticResource BodyFontSize}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Background="{StaticResource WarningLightBrush}"
                                                            BorderBrush="{StaticResource WarningBorderBrush}"
                                                            BorderThickness="{StaticResource DefaultBorderThickness}"
                                                            CornerRadius="{StaticResource TinyCornerRadius}"
                                                            Padding="{StaticResource TagPadding}"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding RecommendedPosition, Converter={StaticResource NullableVisibilityConverter}}">
                                                        <TextBlock FontSize="{StaticResource TinyFontSize}" Foreground="{StaticResource WarningTextBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="仓位 {0:F0}%">
                                                                    <Binding Path="RecommendedPosition"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Background="{StaticResource InfoLightBrush}"
                                                            BorderBrush="{StaticResource InfoBorderBrush}"
                                                            BorderThickness="{StaticResource DefaultBorderThickness}"
                                                            CornerRadius="{StaticResource TinyCornerRadius}"
                                                            Padding="{StaticResource TagPadding}"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding RecommendedHoldingPeriod, Converter={StaticResource NullableVisibilityConverter}}">
                                                        <TextBlock FontSize="{StaticResource TinyFontSize}" Foreground="{StaticResource InfoTextBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="期限 {0}天">
                                                                    <Binding Path="RecommendedHoldingPeriod"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Background="{StaticResource DangerLightBrush}"
                                                            BorderBrush="{StaticResource DangerBorderBrush}"
                                                            BorderThickness="{StaticResource DefaultBorderThickness}"
                                                            CornerRadius="{StaticResource TinyCornerRadius}"
                                                            Padding="{StaticResource TagPadding}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RiskLevel, StringFormat='{}风险 {0}'}"
                                                                   FontSize="{StaticResource TinyFontSize}"
                                                                   Foreground="{StaticResource DangerTextBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                            
                                            <!-- 核心投资指标 -->
                                            <Grid ColumnDefinitions="*,*,*">
                                                <Border Grid.Column="0"
                                                        Background="{StaticResource SuccessLightBrush}"
                                                        CornerRadius="{StaticResource SmallCornerRadius}"
                                                        Padding="{StaticResource CompactCardPadding}"
                                                        Margin="{StaticResource TinyRightMargin}">
                                                    <StackPanel Spacing="{StaticResource CompactSpacing}">
                                                        <TextBlock Text="🎯 目标价"
                                                                   FontSize="{StaticResource TinyFontSize}"
                                                                   Foreground="{StaticResource SuccessTextBrush}"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding TargetPrice, Converter={StaticResource NullableValueConverter}, ConverterParameter={}{0:F2}元|待定}"
                                                                   FontSize="{StaticResource MediumFontSize}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource SuccessAccentBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource InfoBackgroundBrush}"
                                                        CornerRadius="{StaticResource SmallCornerRadius}"
                                                        Padding="{StaticResource CompactCardPadding}"
                                                        Margin="{StaticResource TinyHorizontalMargin}">
                                                    <StackPanel Spacing="{StaticResource CompactSpacing}">
                                                        <TextBlock Text="📈 预期收益"
                                                                   FontSize="{StaticResource TinyFontSize}"
                                                                   Foreground="{StaticResource InfoTextBrush}"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding ExpectedReturn, Converter={StaticResource NullableValueConverter}, ConverterParameter=+{0:F1}%|待定}"
                                                                   FontSize="{StaticResource MediumFontSize}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource InfoAccentBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2"
                                                        Background="{StaticResource DangerBackgroundBrush}"
                                                        CornerRadius="{StaticResource SmallCornerRadius}"
                                                        Padding="{StaticResource CompactCardPadding}"
                                                        Margin="{StaticResource TinyRightMargin}">
                                                    <StackPanel Spacing="{StaticResource CompactSpacing}">
                                                        <TextBlock Text="🛑 止损价"
                                                                   FontSize="{StaticResource TinyFontSize}"
                                                                   Foreground="{StaticResource DangerTextBrush}"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding StopLoss, Converter={StaticResource NullableValueConverter}, ConverterParameter={}{0:F2}元|待定}"
                                                                   FontSize="{StaticResource MediumFontSize}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource DangerAccentBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            
                                            <!-- 推荐理由 -->
                                            <Border Background="{StaticResource WarningBackgroundBrush}"
                                                    BorderBrush="{StaticResource WarningBorderBrush}"
                                                    BorderThickness="{StaticResource DefaultBorderThickness}"
                                                    CornerRadius="{StaticResource SmallCornerRadius}"
                                                    Padding="{StaticResource CompactCardPadding}">
                                                <StackPanel Spacing="{StaticResource TinySpacing}">
                                                    <TextBlock Text="💡 推荐理由"
                                                               FontSize="{StaticResource SmallFontSize}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource WarningAccentBrush}"/>
                                                    <TextBlock Text="{Binding Reason}"
                                                               FontSize="{StaticResource BodyFontSize}"
                                                               TextWrapping="Wrap"
                                                               LineHeight="{StaticResource CompactLineHeight}"
                                                               Foreground="{StaticResource WarningTextDarkBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    
                    <!-- 风险提示 -->
                    <Border Background="{StaticResource WarningBackgroundAltBrush}"
                            BorderBrush="{StaticResource WarningBorderAltBrush}"
                            BorderThickness="{StaticResource ThickBorderThickness}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}"
                            Margin="{StaticResource SmallTopMargin}"
                            IsVisible="{Binding HasRiskWarnings}">
                        <StackPanel Spacing="{StaticResource DefaultSpacing}">
                            <TextBlock Text="⚠️ 风险提示" 
                                       FontSize="{StaticResource SubTitleFontSize}" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource WarningAccentBrush}"/>
                            <TextBlock Text="{Binding FormattedRiskWarnings}"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{StaticResource WarningTextBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="{StaticResource DefaultLineHeight}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:CardView>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
