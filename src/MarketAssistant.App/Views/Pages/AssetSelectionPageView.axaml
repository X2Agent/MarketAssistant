<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:models="using:MarketAssistant.Applications.InvestmentSelection.Models"
             xmlns:converts="using:MarketAssistant.Converters"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.AssetSelectionPageView"
             x:DataType="vm:AssetSelectionPageViewModel"
             x:Name="Root">

    <Design.DataContext>
        <vm:AssetSelectionPageViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <converts:NullableValueConverter x:Key="NullableValueConverter"/>
        <converts:NullableVisibilityConverter x:Key="NullableVisibilityConverter"/>
    </UserControl.Resources>

    <!-- 快捷策略/推荐卡片等局部样式（对齐原型 q-card / rst-card）
         v3：无边框。hover 只加深表面色阶，选中态用 AccentRing 阴影环，
         不能再用 BorderBrush 换色——DefaultBorderThickness 已归零，换色不可见。 -->
    <UserControl.Styles>
        <Style Selector="Border.q-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource DefaultCardPadding}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.q-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.q-card:focus-visible">
            <Setter Property="BoxShadow" Value="{StaticResource FocusRing}"/>
        </Style>
        <Style Selector="Border.rst-card">
            <Setter Property="Background" Value="{DynamicResource ItemBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{StaticResource MediumCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource DefaultCardPadding}"/>
        </Style>
        <Style Selector="Border.score-badge">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.meta-pill">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource TinyCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource TinyPadding}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <!-- 根用 Panel 叠放：两个 ScrollViewer（内容 / 骨架）互斥显示，
         分析中遮罩排在最后，天然浮在最上层，无需 RowSpan + ZIndex。 -->
    <Panel Background="{DynamicResource PageBackgroundBrush}">
        <ScrollViewer IsVisible="{Binding !IsInitialLoading}">
            <StackPanel Margin="{StaticResource PagePadding}" Spacing="{StaticResource LargeSpacing}">
                <!-- 选币模式：等宽三卡（图标 + 名称 + 描述，对齐原型 mode-card） -->
                <ItemsControl ItemsSource="{Binding SelectionModes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SelectionModeItem">
                            <Border Classes.mode-card="True"
                                    Classes.selected="{Binding IsSelected}"
                                    Margin="{StaticResource TinyMargin}"
                                    Focusable="True"
                                    KeyDown="OnCardKeyDown"
                                    AutomationProperties.Name="{Binding Name}">
                                <StackPanel Spacing="{StaticResource TinySpacing}" HorizontalAlignment="Center">
                                    <svg:Svg Path="{Binding IconPath}"
                                             Width="{StaticResource DefaultIconSize}"
                                             Height="{StaticResource DefaultIconSize}"
                                             HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource BodySmFontSize}"
                                               FontWeight="{DynamicResource WeightTitle}"
                                               Classes="mode-name"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="{StaticResource CaptionFontSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 验证提示消息：语义底 + 语义字，无描边 -->
                <Border Background="{DynamicResource WarningPanelBackgroundBrush}"
                        BorderThickness="{StaticResource NoBorderThickness}"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="{StaticResource DefaultCardPadding}"
                        IsVisible="{Binding HasValidationMessage}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                        <svg:Svg Path="/Assets/Images/icon_warning.svg"
                                 Width="{StaticResource TinyIconSize}"
                                 Height="{StaticResource TinyIconSize}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Classes="body-sm"
                                   Foreground="{DynamicResource WarningPanelTextBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 需求输入区：输入框在上，操作按钮在下 -->
                <StackPanel Spacing="{StaticResource SmallSpacing}" IsVisible="{Binding IsInputAreaVisible}">
                    <TextBox Text="{Binding CurrentInputContent}"
                             PlaceholderText="{Binding CurrentPlaceholder}"
                             Height="64"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}" HorizontalAlignment="Right">
                        <Button Content="{Binding CurrentButtonText}"
                                Command="{Binding ExecuteAnalysisCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                Classes="btn-primary"
                                MinWidth="{StaticResource MediumButtonMinWidth}"/>
                        <Button Content="清除"
                                Command="{Binding ClearContentCommand}"
                                MinWidth="{StaticResource SmallButtonMinWidth}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 快捷策略（对齐原型 quick-grid 宫格，点击直接执行；仅快速策略模式显示） -->
                <StackPanel Spacing="{StaticResource SmallSpacing}"
                            IsVisible="{Binding IsQuickStrategyAreaVisible}">
                    <TextBlock Text="{Binding QuickStrategyTitle}"
                               FontSize="{StaticResource BodySmFontSize}"
                               FontWeight="{DynamicResource WeightTitle}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding QuickStrategies}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:QuickSelectionStrategyInfo">
                                <Border Classes="q-card"
                                        Margin="{StaticResource SmallCardGridMargin}"
                                        Focusable="True"
                                        KeyDown="OnCardKeyDown"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SmallSpacing}">
                                        <!-- 图标：左侧垂直居中 -->
                                        <Border Grid.Column="0"
                                                Width="30"
                                                Height="30"
                                                CornerRadius="{StaticResource SmallCornerRadius}"
                                                Background="{DynamicResource SurfaceVariantBrush}"
                                                VerticalAlignment="Center">
                                            <svg:Svg Path="{Binding IconPath}"
                                                     Width="{StaticResource TinyIconSize}"
                                                     Height="{StaticResource TinyIconSize}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="{StaticResource BodySmFontSize}"
                                                       FontWeight="{DynamicResource WeightTitle}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="{StaticResource CaptionFontSize}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <!-- 选币结果（对齐原型 aiResults） -->
                <StackPanel Spacing="{StaticResource LargeSpacing}" IsVisible="{Binding HasResult}">
                    <!-- 摘要行：匹配数量 · 置信度 + 进度条 + 清除 -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                            <TextBlock Text="匹配" Classes="form-label"/>
                            <TextBlock Text="{Binding RecommendedStocks.Count}"
                                       FontSize="{StaticResource BodySmFontSize}"
                                       FontWeight="{DynamicResource WeightTitle}"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="只标的 · AI 置信度" Classes="form-label"/>
                            <TextBlock Text="{Binding SelectionResult.ConfidenceScore, StringFormat={}{0:F0}%}"
                                       FontSize="{StaticResource BodySmFontSize}"
                                       FontWeight="{DynamicResource WeightTitle}"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <ProgressBar Grid.Column="1"
                                     Value="{Binding SelectionResult.ConfidenceScore}"
                                     Maximum="100"
                                     Height="6"
                                     Margin="{StaticResource HorizontalMargin}"
                                     CornerRadius="{StaticResource TinyCornerRadius}"
                                     VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="清除"
                                Command="{Binding ClearContentCommand}"
                                MinWidth="{StaticResource SmallButtonMinWidth}"/>
                    </Grid>

                    <!-- 推荐列表（对齐原型 rst-card） -->
                    <ItemsControl ItemsSource="{Binding RecommendedStocks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource DefaultSpacing}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:InvestmentRecommendation">
                                <Border Classes="rst-card">
                                    <StackPanel Spacing="{StaticResource SmallSpacing}">
                                        <!-- 头部：名称/代码 | 评分徽标 -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="{StaticResource CompactSpacing}">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="{StaticResource BodySmFontSize}"
                                                           FontWeight="{DynamicResource WeightTitle}"/>
                                                <TextBlock Text="{Binding Symbol}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontSize="{StaticResource CaptionFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Classes="score-badge">
                                                <TextBlock Text="{Binding RecommendationScore, StringFormat={}{0:F0}}"
                                                           FontSize="{StaticResource BodySmFontSize}"
                                                           FontWeight="{DynamicResource WeightTitle}"
                                                           Foreground="{StaticResource TextOnEmphasisBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- 匹配理由 -->
                                        <TextBlock Text="{Binding Reason}"
                                                   FontSize="{StaticResource BodySmFontSize}"
                                                   LineHeight="{StaticResource CaptionLineHeight}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <!-- 关键指标：目标价 | 预期收益 | 止损价（对齐原型 rst-dcell） -->
                                        <Grid ColumnDefinitions="*,*,*">
                                            <StackPanel Grid.Column="0" Spacing="{StaticResource CompactSpacing}">
                                                <TextBlock Text="目标价"
                                                           FontSize="{StaticResource CaptionFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding TargetPrice, Converter={StaticResource NullableValueConverter}, ConverterParameter={}{0:F2}|待定}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontSize="{StaticResource BodySmFontSize}"
                                                           FontWeight="{DynamicResource WeightTitle}"
                                                           Foreground="{StaticResource BullishBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="{StaticResource CompactSpacing}">
                                                <TextBlock Text="预期收益"
                                                           FontSize="{StaticResource CaptionFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding ExpectedReturn, Converter={StaticResource NullableValueConverter}, ConverterParameter=+{0:F1}%|待定}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontSize="{StaticResource BodySmFontSize}"
                                                           FontWeight="{DynamicResource WeightTitle}"
                                                           Foreground="{StaticResource BullishBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="{StaticResource CompactSpacing}">
                                                <TextBlock Text="止损价"
                                                           FontSize="{StaticResource CaptionFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding StopLoss, Converter={StaticResource NullableValueConverter}, ConverterParameter={}{0:F2}|待定}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontSize="{StaticResource BodySmFontSize}"
                                                           FontWeight="{DynamicResource WeightTitle}"
                                                           Foreground="{StaticResource BearishBrush}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 底部：风险等级 / 持有期 / 仓位胶囊 -->
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                                            <Border Classes="meta-pill">
                                                <TextBlock Text="{Binding RiskLevel}"
                                                           FontSize="{StaticResource CaptionFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Classes="meta-pill"
                                                    IsVisible="{Binding RecommendedHoldingPeriod, Converter={StaticResource NullableVisibilityConverter}}">
                                                <TextBlock Text="{Binding RecommendedHoldingPeriod, StringFormat=建议持有 {0} 天}"
                                                           FontSize="{StaticResource CaptionFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Classes="meta-pill"
                                                    IsVisible="{Binding RecommendedPosition, Converter={StaticResource NullableVisibilityConverter}}">
                                                <TextBlock Text="{Binding RecommendedPosition, StringFormat=建议仓位 {0}%}"
                                                           FontSize="{StaticResource CaptionFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 分析摘要 -->
                    <Border Background="{DynamicResource ItemBackgroundBrush}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}">
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="分析摘要"
                                       FontSize="{StaticResource BodySmFontSize}"
                                       FontWeight="{DynamicResource WeightTitle}"/>
                            <TextBlock Text="{Binding SelectionResult.AnalysisSummary}"
                                       FontSize="{StaticResource BodySmFontSize}"
                                       TextWrapping="Wrap"
                                       LineHeight="{StaticResource BodySmLineHeight}"/>
                        </StackPanel>
                    </Border>

                    <!-- 市场环境分析 -->
                    <Border Background="{DynamicResource ItemBackgroundBrush}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}">
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="市场环境分析"
                                       FontSize="{StaticResource BodySmFontSize}"
                                       FontWeight="{DynamicResource WeightTitle}"/>
                            <TextBlock Text="{Binding SelectionResult.MarketEnvironmentAnalysis}"
                                       FontSize="{StaticResource BodySmFontSize}"
                                       TextWrapping="Wrap"
                                       LineHeight="{StaticResource BodySmLineHeight}"/>
                        </StackPanel>
                    </Border>

                    <!-- 投资建议：v3 语义面板只靠低透明度色块分层，不描边 -->
                    <Border Background="{DynamicResource InfoPanelBackgroundBrush}"
                            BorderThickness="{StaticResource NoBorderThickness}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}">
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="投资建议"
                                       FontSize="{StaticResource BodySmFontSize}"
                                       FontWeight="{DynamicResource WeightTitle}"
                                       Foreground="{DynamicResource InfoPanelTextBrush}"/>
                            <TextBlock Text="{Binding SelectionResult.InvestmentAdvice}"
                                       FontSize="{StaticResource BodySmFontSize}"
                                       Foreground="{DynamicResource InfoPanelTextBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="{StaticResource BodySmLineHeight}"/>
                        </StackPanel>
                    </Border>

                    <!-- 风险提示（对齐原型 warn-strip）：v3 无描边 -->
                    <Border Background="{DynamicResource WarningBackgroundAltBrush}"
                            BorderThickness="{StaticResource NoBorderThickness}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}"
                            IsVisible="{Binding HasRiskWarnings}">
                        <TextBlock Text="{Binding FormattedRiskWarnings}"
                                   FontSize="{StaticResource BodySmFontSize}"
                                   Foreground="{DynamicResource WarningPanelTextBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="{StaticResource BodySmLineHeight}"/>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 首屏骨架：三模式卡 + 输入区 + 结果列表行。
             三张模式卡是 mode-card 的结构克隆（同 20 内边距、同
             「图标 24 / 名称 21 / 描述 2 行 36」+ 4 间距）；结果行是 rst-card 的克隆
             （同 16 内边距 + 头部两行 + 三列指标）。 -->
        <ScrollViewer IsVisible="{Binding IsInitialLoading}">
            <StackPanel Margin="{StaticResource PagePadding}" Spacing="{StaticResource LargeSpacing}">
                <!-- 三模式卡：三列网格 + 图标占位 -->
                <controls:SkeletonList Count="3">
                    <controls:SkeletonList.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </controls:SkeletonList.ItemsPanel>
                    <controls:SkeletonList.ItemTemplate>
                        <DataTemplate>
                            <!-- 与真实 mode-card 对齐：白卡表面 + 20 内边距（Variant=Tile 默认是
                                 次级表面 16 内边距，这里按真实卡片覆写） -->
                            <controls:SkeletonCard Variant="Tile"
                                                   Background="{DynamicResource CardBackgroundBrush}"
                                                   Padding="{StaticResource CardPadding}"
                                                   Margin="{StaticResource TinyMargin}"
                                                   HorizontalContentAlignment="Center">
                                <StackPanel Spacing="{StaticResource TinySpacing}" HorizontalAlignment="Center">
                                    <Border Classes="skeleton"
                                            Width="{StaticResource DefaultIconSize}"
                                            Height="{StaticResource DefaultIconSize}"
                                            CornerRadius="{StaticResource SmallCornerRadius}"/>
                                    <controls:SkeletonLines Row="BodySm" LineWidths="72" Margin="0,4,0,0"/>
                                    <controls:SkeletonLines Row="Caption" LineWidths="128,96" Spacing="0"/>
                                </StackPanel>
                            </controls:SkeletonCard>
                        </DataTemplate>
                    </controls:SkeletonList.ItemTemplate>
                </controls:SkeletonList>

                <!-- 输入区：占位高度与真实 TextBox(64) + 按钮行(36) + 8 间距一致 -->
                <StackPanel Spacing="{StaticResource SmallSpacing}">
                    <Border Classes="skeleton"
                            Height="64"
                            CornerRadius="{StaticResource SmallCornerRadius}"/>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}"
                                HorizontalAlignment="Right">
                        <Border Classes="skeleton" Width="{StaticResource MediumButtonMinWidth}"
                                Height="{StaticResource ButtonHeight}"
                                CornerRadius="{StaticResource SmallCornerRadius}"/>
                        <Border Classes="skeleton" Width="{StaticResource SmallButtonMinWidth}"
                                Height="{StaticResource ButtonHeight}"
                                CornerRadius="{StaticResource SmallCornerRadius}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 结果列表：三条 rst-card 克隆。含评分徽标与三列指标。 -->
                <controls:SkeletonList Count="3" Spacing="{StaticResource DefaultSpacing}">
                    <controls:SkeletonList.ItemTemplate>
                        <DataTemplate>
                            <controls:SkeletonCard Variant="Row"
                                                   CornerRadius="{StaticResource MediumCornerRadius}">
                                <StackPanel Spacing="{StaticResource SmallSpacing}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <controls:SkeletonLines Grid.Column="0" Row="BodySm" LineWidths="96"/>
                                        <controls:SkeletonLines Grid.Column="0" Row="Caption" LineWidths="64"
                                                                VerticalAlignment="Bottom"/>
                                        <Border Grid.Column="1" Classes="skeleton"
                                                Width="36" Height="36"
                                                CornerRadius="{StaticResource SmallCornerRadius}"/>
                                    </Grid>
                                    <controls:SkeletonLines Row="Caption" LineWidths="*"/>
                                    <Grid ColumnDefinitions="*,*,*">
                                        <controls:SkeletonLines Grid.Column="0" Row="BodySm" LineCount="2" LineWidths="40,56"/>
                                        <controls:SkeletonLines Grid.Column="1" Row="BodySm" LineCount="2" LineWidths="48,52"/>
                                        <controls:SkeletonLines Grid.Column="2" Row="BodySm" LineCount="2" LineWidths="40,56"/>
                                    </Grid>
                                    <controls:SkeletonLines Row="Caption" LineWidths="160"/>
                                </StackPanel>
                            </controls:SkeletonCard>
                        </DataTemplate>
                    </controls:SkeletonList.ItemTemplate>
                </controls:SkeletonList>
            </StackPanel>
        </ScrollViewer>

        <!-- 失败态（含重试入口）；空态由页面内各分区自行提示 -->
        <controls:StateOverlayView State="{Binding OverlayState}"
                                   Message="{Binding OverlayMessage}"
                                   RetryCommand="{Binding RetryCommand}"
                                   RetryText="重新加载"
                                   ShowLoading="False"/>

        <!-- 分析中遮罩：放最后即置顶；任务进行中语义，不用加载态浮层 -->
        <Border Background="{DynamicResource DarkOverlayBrush}"
                IsVisible="{Binding IsBusy}">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="{StaticResource DefaultCornerRadius}"
                    Padding="{StaticResource ProgressDialogPadding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="{StaticResource InputAreaMinWidth}"
                    MaxWidth="{StaticResource InputAreaMaxWidth}"
                    BoxShadow="{StaticResource ShadowModal}">
                <StackPanel Spacing="{StaticResource LargeSpacing}">
                    <controls:LoadingDots/>
                    <StackPanel Spacing="{StaticResource SmallSpacing}">
                        <TextBlock Text="正在分析中"
                                   FontSize="{StaticResource TitleFontSize}"
                                   FontWeight="{DynamicResource WeightTitle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LoadingText}" Classes="form-label"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="{StaticResource MessageMaxWidth}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
