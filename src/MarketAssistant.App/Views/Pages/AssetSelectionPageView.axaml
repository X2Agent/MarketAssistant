<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:models="using:MarketAssistant.Applications.InvestmentSelection.Models"
             xmlns:converts="using:MarketAssistant.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.AssetSelectionPageView"
             x:DataType="vm:AssetSelectionPageViewModel"
             x:Name="Root">

    <Design.DataContext>
        <vm:AssetSelectionPageViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <converts:NullableValueConverter x:Key="NullableValueConverter"/>
        <converts:NullableVisibilityConverter x:Key="NullableVisibilityConverter"/>
    </UserControl.Resources>

    <!-- 快捷策略/推荐卡片等局部样式（对齐原型 q-card / rst-card） -->
    <UserControl.Styles>
        <Style Selector="Border.q-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource DefaultCardPadding}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.q-card:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>
        <Style Selector="Border.rst-card">
            <Setter Property="Background" Value="{DynamicResource ItemBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{StaticResource MediumCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource DefaultCardPadding}"/>
        </Style>
        <Style Selector="Border.score-badge">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.meta-pill">
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource TinyCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource TinyPadding}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- 加载指示器（覆盖层） -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="{DynamicResource DarkOverlayBrush}"
                IsVisible="{Binding IsBusy}"
                ZIndex="1000">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="{StaticResource DefaultCornerRadius}"
                    Padding="{StaticResource ProgressDialogPadding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="{StaticResource InputAreaMinWidth}"
                    MaxWidth="{StaticResource InputAreaMaxWidth}"
                    BoxShadow="{StaticResource ElevatedBoxShadow}">
                <StackPanel Spacing="{StaticResource LargeSpacing}">
                    <controls:LoadingDots/>
                    <StackPanel Spacing="{StaticResource SmallSpacing}">
                        <TextBlock Text="正在分析中"
                                   FontSize="{StaticResource LargeFontSize}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LoadingText}"
                                   FontSize="{StaticResource LabelFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="{StaticResource MessageMaxWidth}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="{StaticResource PagePadding}" Spacing="{StaticResource LargeSpacing}">
                <!-- 页面标题已在顶栏显示，页面内不再重复 -->

                <!-- 选币模式：等宽三卡（图标 + 名称 + 描述，对齐原型 mode-card） -->
                <ItemsControl ItemsSource="{Binding SelectionModes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SelectionModeItem">
                            <Border Classes.mode-card="True"
                                    Classes.selected="{Binding IsSelected}"
                                    Margin="{StaticResource TinyRightMargin}"
                                    Focusable="True"
                                    KeyDown="OnCardKeyDown"
                                    AutomationProperties.Name="{Binding Name}">
                                <StackPanel Spacing="{StaticResource TinySpacing}" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="{StaticResource LargeFontSize}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource LabelFontSize}"
                                               FontWeight="SemiBold"
                                               Classes="mode-name"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="{StaticResource MiniFontSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 验证提示消息 -->
                <Border Background="{DynamicResource WarningPanelBackgroundBrush}"
                        BorderBrush="{DynamicResource WarningPanelBorderBrush}"
                        BorderThickness="{StaticResource DefaultBorderThickness}"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="{StaticResource DefaultCardPadding}"
                        IsVisible="{Binding HasValidationMessage}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}">
                        <TextBlock Text="ℹ️"
                                   FontSize="{StaticResource SectionTitleFontSize}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ValidationMessage}"
                                   FontSize="{StaticResource LabelFontSize}"
                                   Foreground="{DynamicResource WarningPanelTextBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 需求输入区：输入框在上，操作按钮在下 -->
                <StackPanel Spacing="{StaticResource SmallSpacing}" IsVisible="{Binding IsInputAreaVisible}">
                    <TextBox Text="{Binding CurrentInputContent}"
                             PlaceholderText="{Binding CurrentPlaceholder}"
                             Height="64"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SmallSpacing}" HorizontalAlignment="Right">
                        <Button Content="{Binding CurrentButtonText}"
                                Command="{Binding ExecuteAnalysisCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="{StaticResource TextOnEmphasisBrush}"
                                MinWidth="{StaticResource MediumButtonMinWidth}"/>
                        <Button Content="清除"
                                Command="{Binding ClearContentCommand}"
                                MinWidth="{StaticResource SmallButtonMinWidth}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 快捷策略（对齐原型 quick-grid 宫格，点击直接执行；仅快速策略模式显示） -->
                <StackPanel Spacing="{StaticResource SmallSpacing}"
                            IsVisible="{Binding IsQuickStrategyAreaVisible}">
                    <TextBlock Text="{Binding QuickStrategyTitle}"
                               FontSize="{StaticResource LabelFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding QuickStrategies}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:QuickSelectionStrategyInfo">
                                <Border Classes="q-card"
                                        Margin="0,0,8,8"
                                        Focusable="True"
                                        KeyDown="OnCardKeyDown"
                                        AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Spacing="{StaticResource SmallSpacing}">
                                        <Border Width="30"
                                                Height="30"
                                                CornerRadius="{StaticResource SmallCornerRadius}"
                                                Background="{DynamicResource SurfaceVariantBrush}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Icon}"
                                                       FontSize="{StaticResource LabelFontSize}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{StaticResource LabelFontSize}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="{StaticResource SmallFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <!-- 选币结果（对齐原型 aiResults） -->
                <StackPanel Spacing="{StaticResource LargeSpacing}" IsVisible="{Binding HasResult}">
                    <!-- 摘要行：匹配数量 · 置信度 + 进度条 + 清除 -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                            <TextBlock Text="匹配"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RecommendedStocks.Count}"
                                       FontSize="{StaticResource LabelFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="只标的 · AI 置信度"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SelectionResult.ConfidenceScore, StringFormat={}{0:F0}%}"
                                       FontSize="{StaticResource LabelFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                        <ProgressBar Grid.Column="1"
                                     Value="{Binding SelectionResult.ConfidenceScore}"
                                     Maximum="100"
                                     Height="6"
                                     Margin="{StaticResource HorizontalMargin}"
                                     CornerRadius="{StaticResource TinyCornerRadius}"
                                     VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="清除"
                                Command="{Binding ClearContentCommand}"
                                MinWidth="{StaticResource SmallButtonMinWidth}"/>
                    </Grid>

                    <!-- 推荐列表（对齐原型 rst-card） -->
                    <ItemsControl ItemsSource="{Binding RecommendedStocks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource DefaultSpacing}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:InvestmentRecommendation">
                                <Border Classes="rst-card">
                                    <StackPanel Spacing="{StaticResource SmallSpacing}">
                                        <!-- 头部：名称/代码 | 评分徽标 -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="{StaticResource CompactSpacing}">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="{StaticResource MediumFontSize}"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Symbol}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontSize="{StaticResource TinyFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Classes="score-badge">
                                                <TextBlock Text="{Binding RecommendationScore, StringFormat={}{0:F0}}"
                                                           FontSize="{StaticResource MediumFontSize}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextOnEmphasisBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- 匹配理由 -->
                                        <TextBlock Text="{Binding Reason}"
                                                   FontSize="{StaticResource LabelFontSize}"
                                                   LineHeight="{StaticResource CompactLineHeight}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <!-- 关键指标：目标价 | 预期收益 | 止损价（对齐原型 rst-dcell） -->
                                        <Grid ColumnDefinitions="*,*,*">
                                            <StackPanel Grid.Column="0" Spacing="{StaticResource CompactSpacing}">
                                                <TextBlock Text="目标价"
                                                           FontSize="{StaticResource MiniFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding TargetPrice, Converter={StaticResource NullableValueConverter}, ConverterParameter={}{0:F2}|待定}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontSize="{StaticResource LabelFontSize}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BullishBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="{StaticResource CompactSpacing}">
                                                <TextBlock Text="预期收益"
                                                           FontSize="{StaticResource MiniFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding ExpectedReturn, Converter={StaticResource NullableValueConverter}, ConverterParameter=+{0:F1}%|待定}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontSize="{StaticResource LabelFontSize}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BullishBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="{StaticResource CompactSpacing}">
                                                <TextBlock Text="止损价"
                                                           FontSize="{StaticResource MiniFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding StopLoss, Converter={StaticResource NullableValueConverter}, ConverterParameter={}{0:F2}|待定}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontSize="{StaticResource LabelFontSize}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BearishBrush}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 底部：风险等级 / 持有期 / 仓位胶囊 -->
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                                            <Border Classes="meta-pill">
                                                <TextBlock Text="{Binding RiskLevel}"
                                                           FontSize="{StaticResource MiniFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Classes="meta-pill"
                                                    IsVisible="{Binding RecommendedHoldingPeriod, Converter={StaticResource NullableVisibilityConverter}}">
                                                <TextBlock Text="{Binding RecommendedHoldingPeriod, StringFormat=建议持有 {0} 天}"
                                                           FontSize="{StaticResource MiniFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Classes="meta-pill"
                                                    IsVisible="{Binding RecommendedPosition, Converter={StaticResource NullableVisibilityConverter}}">
                                                <TextBlock Text="{Binding RecommendedPosition, StringFormat=建议仓位 {0}%}"
                                                           FontSize="{StaticResource MiniFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 分析摘要 -->
                    <Border Background="{DynamicResource ItemBackgroundBrush}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}">
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="分析摘要"
                                       FontSize="{StaticResource MediumFontSize}"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectionResult.AnalysisSummary}"
                                       FontSize="{StaticResource LabelFontSize}"
                                       TextWrapping="Wrap"
                                       LineHeight="{StaticResource DefaultLineHeight}"/>
                        </StackPanel>
                    </Border>

                    <!-- 市场环境分析 -->
                    <Border Background="{DynamicResource ItemBackgroundBrush}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}">
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="市场环境分析"
                                       FontSize="{StaticResource MediumFontSize}"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectionResult.MarketEnvironmentAnalysis}"
                                       FontSize="{StaticResource LabelFontSize}"
                                       TextWrapping="Wrap"
                                       LineHeight="{StaticResource DefaultLineHeight}"/>
                        </StackPanel>
                    </Border>

                    <!-- 投资建议 -->
                    <Border Background="{DynamicResource InfoPanelBackgroundBrush}"
                            BorderBrush="{DynamicResource InfoPanelBorderBrush}"
                            BorderThickness="{StaticResource ThickBorderThickness}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}">
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="投资建议"
                                       FontSize="{StaticResource MediumFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource InfoPanelTextBrush}"/>
                            <TextBlock Text="{Binding SelectionResult.InvestmentAdvice}"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource InfoPanelTextBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="{StaticResource DefaultLineHeight}"/>
                        </StackPanel>
                    </Border>

                    <!-- 风险提示（对齐原型 warn-strip） -->
                    <Border Background="{StaticResource WarningBackgroundAltBrush}"
                            BorderBrush="{StaticResource WarningBorderAltBrush}"
                            BorderThickness="{StaticResource ThickBorderThickness}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource CardPadding}"
                            IsVisible="{Binding HasRiskWarnings}">
                        <TextBlock Text="{Binding FormattedRiskWarnings}"
                                   FontSize="{StaticResource LabelFontSize}"
                                   Foreground="{DynamicResource WarningPanelTextBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="{StaticResource DefaultLineHeight}"/>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
