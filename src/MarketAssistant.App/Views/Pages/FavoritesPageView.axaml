<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:converts="using:MarketAssistant.Converters"
             xmlns:assets="using:MarketAssistant.Applications.Assets.Models"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.FavoritesPageView"
             x:DataType="vm:FavoritesPageViewModel">

    <UserControl.Resources>
        <converts:PriceChangeColorConverter x:Key="PriceChangeColorConverter"/>
        <converts:NullableVisibilityConverter x:Key="NullableVisibilityConverter"/>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:FavoritesPageViewModel/>
    </Design.DataContext>

    <!-- 收藏卡片（v3：无边框，靠表面色阶分层；hover 加深底色而非描边） -->
    <UserControl.Styles>
        <Style Selector="Border.fav-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
    <Style Selector="Border.fav-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
    </Style>
    <!-- 删除按钮全局默认透明且不接收点击（见 ButtonStyles），必须在这里让它在悬停或键盘聚焦时浮现。
         缺这条规则时卡片视图的删除入口完全不可用——只剩表格视图能删。
         键盘场景用 :focus-visible（与 q-card 一致），鼠标点击卡片不该让删除按钮一直停在那里。 -->
    <Style Selector="Border.fav-card:pointerover Button.delete-button">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>
    <Style Selector="Border.fav-card:focus-visible Button.delete-button">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
    </Style>
    </UserControl.Styles>

    <!-- 根用 Panel 叠放各状态，使空态/加载占位可撑满整页垂直居中 -->
    <Panel Background="{DynamicResource PageBackgroundBrush}">

        <!-- 首屏骨架：卡片视图占位。
             每张卡是 fav-card 的结构克隆：同宽（FavCardWidth）、同内边距、同 CardGridMargin，
             内部按同样的左右两栏排布，数据到达时高度零跳动。 -->
        <Grid IsVisible="{Binding IsInitialLoading}"
              RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Classes="skeleton skeleton-line-title"
                    Width="180"
                    HorizontalAlignment="Left"
                    Margin="{StaticResource PagePadding}"/>
            <Grid Grid.Row="1" Margin="{StaticResource PagePadding}">
                <!-- 与真实 WrapPanel 同构，窄窗口按相同卡宽和边距自动换行。 -->
                <controls:SkeletonList Count="6">
                    <controls:SkeletonList.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </controls:SkeletonList.ItemsPanel>
                    <controls:SkeletonList.ItemTemplate>
                        <DataTemplate>
                            <controls:SkeletonCard Variant="Card"
                                                   Width="{StaticResource FavCardWidth}"
                                                   Margin="{StaticResource CardGridMargin}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource DefaultSpacing}">
                                    <StackPanel Grid.Column="0"
                                                Spacing="{StaticResource TinySpacing}"
                                                VerticalAlignment="Center">
                                        <controls:SkeletonLines Row="Caption" LineWidths="52"/>
                                        <controls:SkeletonLines Row="BodySm" LineWidths="120"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Spacing="{StaticResource TinySpacing}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <controls:SkeletonLines Row="Title" LineWidths="110"/>
                                        <controls:SkeletonLines Row="Caption" LineWidths="48"/>
                                    </StackPanel>
                                </Grid>
                            </controls:SkeletonCard>
                        </DataTemplate>
                    </controls:SkeletonList.ItemTemplate>
                </controls:SkeletonList>
            </Grid>
        </Grid>

        <!-- 内容区域（非首次加载） -->
        <Grid IsVisible="{Binding !IsInitialLoading}" RowDefinitions="Auto,*">
            <!-- 页面标题 + 视图切换：全库唯一保留页头的页面，因为操作槽里有真实操作 -->
            <controls:PageHeaderView Grid.Row="0"
                                     Margin="{StaticResource PagePadding}"
                                     Title="自选看板"
                                     Description="卡片视图适合盯盘，表格视图适合多字段对比">
                <!-- 视图切换分段器（有数据时显示）：当前视图禁用，另一视图可点 -->
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource SmallSpacing}"
                            VerticalAlignment="Center"
                            IsVisible="{Binding Assets.Count}">
                    <Button Classes="action-button" Content="卡片视图"
                            Command="{Binding ShowCardViewCommand}" IsEnabled="{Binding IsTableView}"/>
                    <Button Classes="action-button" Content="表格视图"
                            Command="{Binding ShowTableViewCommand}" IsEnabled="{Binding IsCardView}"/>
                </StackPanel>
            </controls:PageHeaderView>
            <Panel Grid.Row="1">
            <!-- 收藏网格（对齐原型 fav-grid：auto-fill 自适应换行） -->
            <ScrollViewer IsVisible="{Binding IsCardView}">
                <ItemsControl ItemsSource="{Binding Assets}"
                              Margin="{StaticResource PagePadding}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="assets:AssetInfo">
                        <Border Classes="fav-card"
                                Width="{StaticResource FavCardWidth}"
                                Margin="{StaticResource CardGridMargin}"
                                Tapped="OnStockItemTapped"
                                KeyDown="OnStockItemKeyDown"
                                Focusable="True"
                                AutomationProperties.Name="{Binding Name}"
                                Tag="{Binding .}">
                            <!-- 左右两栏：左「代码/板块 + 名称」，右「价格 + 涨跌」右对齐。
                                 价格是等宽数字且右对齐，同一网格里各卡的价格逐位对齐，
                                 盯盘时视线不必来回扫；也消除了旧版 *,Auto 撑出的中间空洞。
                                 第三列预留删除按钮位（与首页热门卡同构：按钮默认透明但仍占位，
                                 悬停时浮现，避免出现时把价格挤走造成跳动）。 -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource DefaultSpacing}">
                                <!-- 左栏：代码 / 板块 / 名称 -->
                                <StackPanel Grid.Column="0"
                                            Spacing="{StaticResource TinySpacing}"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource TinySpacing}">
                                        <TextBlock Text="{Binding Code}" Classes="caption"/>
                                        <TextBlock Text="{Binding SectorName}"
                                                   Classes="caption"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   IsVisible="{Binding SectorName, Converter={StaticResource NullableVisibilityConverter}}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Name}"
                                               Classes="body-sm"
                                               FontWeight="{DynamicResource WeightEmphasis}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- 右栏：价格（视觉锚点）+ 涨跌徽标 -->
                                <StackPanel Grid.Column="1"
                                            Spacing="{StaticResource TinySpacing}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentPrice}"
                                               HorizontalAlignment="Right"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontSize="{StaticResource TitleFontSize}"
                                               FontWeight="{DynamicResource WeightNumber}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Border HorizontalAlignment="Right"
                                            Background="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}, ConverterParameter=tag}"
                                            CornerRadius="{StaticResource TinyCornerRadius}"
                                            Padding="{StaticResource TagPadding}">
                                        <TextBlock Text="{Binding ChangePercentage}"
                                                   FontFamily="{StaticResource DataFontFamily}"
                                                   FontSize="{StaticResource CaptionFontSize}"
                                                   FontWeight="{DynamicResource WeightNumber}"
                                                   Foreground="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}}"/>
                                    </Border>
                                </StackPanel>

                                <!-- 删除：独立成一列，悬停/键盘聚焦时才出现（样式见 fav-card:pointerover） -->
                                <Button Grid.Column="2"
                                        Classes="delete-button"
                                        VerticalAlignment="Center"
                                        Margin="{StaticResource TinyLeftMargin}"
                                        Width="{StaticResource TinyIconButtonSize}"
                                        Height="{StaticResource TinyIconButtonSize}"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="{StaticResource NoBorderThickness}"
                                        Padding="{StaticResource NoPadding}"
                                        ToolTip.Tip="移出自选"
                                        Tapped="OnDeleteButtonTapped"
                                        Command="{Binding $parent[UserControl].((vm:FavoritesPageViewModel)DataContext).RemoveFavoriteCommand}"
                                        CommandParameter="{Binding .}">
                                    <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                              Width="{StaticResource TinyIconSize}"
                                              Height="{StaticResource TinyIconSize}"
                                              Foreground="{DynamicResource ErrorBrush}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 高密度表格视图（对齐 design.md 4.7 Dense Table）：列头点击排序，行双击进详情 -->
            <DataGrid ItemsSource="{Binding Assets}"
                      IsVisible="{Binding IsTableView}"
                      Margin="{StaticResource PagePadding}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserResizeColumns="True"
                      DoubleTapped="OnGridRowDoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="代码" Binding="{Binding Code}"
                                        FontFamily="{StaticResource DataFontFamily}" Width="Auto"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="现价" Binding="{Binding CurrentPrice}"
                                        SortMemberPath="PriceValue"
                                        FontFamily="{StaticResource DataFontFamily}"
                                        Width="Auto"/>
                    <DataGridTemplateColumn Header="涨跌幅" SortMemberPath="ChangePercentValue" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="assets:AssetInfo">
                                <Border Background="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}, ConverterParameter=tag}"
                                        CornerRadius="{StaticResource TinyCornerRadius}"
                                        Padding="{StaticResource TinyPadding}"
                                        Margin="{StaticResource TinyMargin}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ChangePercentage}"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontSize="{StaticResource CaptionFontSize}"
                                               FontWeight="{DynamicResource WeightTitle}"
                                               Foreground="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="assets:AssetInfo">
                                <Button Width="{StaticResource TinyIconButtonSize}"
                                        Height="{StaticResource TinyIconButtonSize}"
                                        Background="Transparent"
                                        BorderThickness="{StaticResource NoBorderThickness}"
                                        Padding="{StaticResource NoPadding}"
                                        Cursor="Hand"
                                        ToolTip.Tip="移出自选"
                                        HorizontalAlignment="Center"
                                        Command="{Binding $parent[DataGrid].((vm:FavoritesPageViewModel)DataContext).RemoveFavoriteCommand}"
                                        CommandParameter="{Binding .}">
                                    <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                              Width="{StaticResource TinyIconSize}"
                                              Height="{StaticResource TinyIconSize}"
                                              Foreground="{DynamicResource ErrorBrush}"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 空态 / 失败态（含重试入口） -->
            <controls:StateOverlayView State="{Binding OverlayState}"
                                       Message="{Binding OverlayMessage}"
                                       RetryCommand="{Binding RetryCommand}"
                                       RetryText="重新加载"
                                       ShowLoading="False"
                                       IconSize="{StaticResource LargeIconSize}"/>
            </Panel>
        </Grid>
    </Panel>
</UserControl>
