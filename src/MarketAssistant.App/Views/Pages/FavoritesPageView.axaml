<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:converts="using:MarketAssistant.Converters"
             xmlns:assets="using:MarketAssistant.Applications.Assets.Models"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.FavoritesPageView"
             x:DataType="vm:FavoritesPageViewModel">

    <UserControl.Resources>
        <converts:PriceChangeColorConverter x:Key="PriceChangeColorConverter"/>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:FavoritesPageViewModel/>
    </Design.DataContext>

    <!-- 根用 Panel 叠放各状态，使空态/加载占位可撑满整页垂直居中 -->
    <Panel Background="{DynamicResource PageBackgroundBrush}">

        <!-- 首屏骨架：卡片视图占位。
             每张卡是真实 AssetCardView 的结构克隆（AssetCardSkeleton）：同一自适应网格面板、
             同 SmallMargin，数据到达时零跳动。 -->
        <Grid IsVisible="{Binding IsInitialLoading}"
              RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Classes="skeleton skeleton-line-title"
                    Width="180"
                    HorizontalAlignment="Left"
                    Margin="{StaticResource PageHeaderMargin}"/>
            <Grid Grid.Row="1" Margin="{StaticResource PagePaddingCompact}">
                <!-- 与真实网格同构：同一面板、同一最小列宽，窄窗口按相同列数收缩。
                     必须 VerticalAlignment=Top：UniformGrid 会把单元格高度按可用高度均分，
                     否则 ScrollViewer 的视口高度会把单行骨架拉成整屏。 -->
                <controls:SkeletonList Count="6" VerticalAlignment="Top">
                    <controls:SkeletonList.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveUniformGrid MinColumnWidth="{StaticResource FavCardWidth}"
                                                          MaxColumns="4"/>
                        </ItemsPanelTemplate>
                    </controls:SkeletonList.ItemsPanel>
                    <controls:SkeletonList.ItemTemplate>
                        <DataTemplate>
                            <controls:AssetCardSkeleton Variant="Card"
                                                        Margin="{StaticResource SmallMargin}"/>
                        </DataTemplate>
                    </controls:SkeletonList.ItemTemplate>
                </controls:SkeletonList>
            </Grid>
        </Grid>

        <!-- 内容区域（非首次加载） -->
        <Grid IsVisible="{Binding !IsInitialLoading}" RowDefinitions="Auto,*">
            <!-- 页面标题 + 视图切换：保留页头是因为操作槽里有真实操作 -->
            <controls:PageHeaderView Grid.Row="0"
                                     Margin="{StaticResource PageHeaderMargin}"
                                     Title="自选看板"
                                     Description="卡片视图适合盯盘，表格视图适合多字段对比">
                <!-- 视图切换分段器（有数据时显示）：当前视图禁用，另一视图可点 -->
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource SmallSpacing}"
                            VerticalAlignment="Center"
                            IsVisible="{Binding Assets.Count}">
                    <Button Classes="action-button" Content="卡片视图"
                            Command="{Binding ShowCardViewCommand}" IsEnabled="{Binding IsTableView}"/>
                    <Button Classes="action-button" Content="表格视图"
                            Command="{Binding ShowTableViewCommand}" IsEnabled="{Binding IsCardView}"/>
                </StackPanel>
            </controls:PageHeaderView>
            <Panel Grid.Row="1">
            <!-- 收藏网格：自适应等分列铺满整行（容器 16 + 条目 8 合成 24 页边距，
                 卡片间距 16）。固定卡宽 + WrapPanel 会让右边缘参差并留下大块空白。 -->
            <ScrollViewer IsVisible="{Binding IsCardView}">
                <ItemsControl ItemsSource="{Binding Assets}"
                              Margin="{StaticResource PagePaddingCompact}"
                              VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveUniformGrid MinColumnWidth="{StaticResource FavCardWidth}"
                                                          MaxColumns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="assets:AssetInfo">
                        <!-- 点击卡片进详情；右上角实心心形取消自选（确认框在 ViewModel 里，点它不会冒泡成进详情，见 AssetCardView） -->
                        <controls:AssetCardView Variant="Card"
                                                Margin="{StaticResource SmallMargin}"
                                                Title="{Binding Name}"
                                                Code="{Binding Code}"
                                                Subtitle="{Binding SectorName}"
                                                Price="{Binding CurrentPrice}"
                                                ChangeText="{Binding ChangePercentage}"
                                                controls:Activation.Command="{Binding $parent[UserControl].((vm:FavoritesPageViewModel)DataContext).SelectFavoriteAssetCommand}"
                                                controls:Activation.CommandParameter="{Binding}">
                            <Button Classes="btn-icon-sm"
                                    ToolTip.Tip="取消自选"
                                    AutomationProperties.Name="取消自选"
                                    Command="{Binding $parent[UserControl].((vm:FavoritesPageViewModel)DataContext).RemoveFavoriteCommand}"
                                    CommandParameter="{Binding}">
                                <svg:Svg Path="/Assets/Images/tab_favorites_on.svg"
                                         Width="{StaticResource TinyIconSize}"
                                         Height="{StaticResource TinyIconSize}"/>
                            </Button>
                        </controls:AssetCardView>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 高密度表格视图（对齐 design.md 4.7 Dense Table）：列头点击排序，行双击进详情 -->
            <DataGrid ItemsSource="{Binding Assets}"
                      IsVisible="{Binding IsTableView}"
                      Margin="{StaticResource PagePadding}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserResizeColumns="True"
                      DoubleTapped="OnGridRowDoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="代码" Binding="{Binding Code}"
                                        FontFamily="{StaticResource DataFontFamily}" Width="Auto"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="现价" Binding="{Binding CurrentPrice}"
                                        SortMemberPath="PriceValue"
                                        FontFamily="{StaticResource DataFontFamily}"
                                        Width="Auto"/>
                    <DataGridTemplateColumn Header="涨跌幅" SortMemberPath="ChangePercentValue" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="assets:AssetInfo">
                                <Border Background="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}, ConverterParameter=tag}"
                                        CornerRadius="{StaticResource TinyCornerRadius}"
                                        Padding="{StaticResource TinyPadding}"
                                        Margin="{StaticResource TinyMargin}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ChangePercentage}"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontSize="{StaticResource CaptionFontSize}"
                                               FontWeight="{DynamicResource WeightTitle}"
                                               Foreground="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="assets:AssetInfo">
                                <Button Width="{StaticResource TinyIconButtonSize}"
                                        Height="{StaticResource TinyIconButtonSize}"
                                        Background="Transparent"
                                        BorderThickness="{StaticResource NoBorderThickness}"
                                        Padding="{StaticResource NoPadding}"
                                        Cursor="Hand"
                                        ToolTip.Tip="移出自选"
                                        HorizontalAlignment="Center"
                                        Command="{Binding $parent[DataGrid].((vm:FavoritesPageViewModel)DataContext).RemoveFavoriteCommand}"
                                        CommandParameter="{Binding .}">
                                    <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                              Width="{StaticResource TinyIconSize}"
                                              Height="{StaticResource TinyIconSize}"
                                              Foreground="{DynamicResource ErrorBrush}"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 空态 / 失败态（含重试入口） -->
            <controls:StateOverlayView State="{Binding OverlayState}"
                                       Message="{Binding OverlayMessage}"
                                       RetryCommand="{Binding RetryCommand}"
                                       RetryText="重新加载"
                                       ShowLoading="False"
                                       IconSize="{StaticResource LargeIconSize}"/>
            </Panel>
        </Grid>
    </Panel>
</UserControl>
