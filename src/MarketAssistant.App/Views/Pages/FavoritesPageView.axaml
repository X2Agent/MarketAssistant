<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:converts="using:MarketAssistant.Converters"
             xmlns:assets="using:MarketAssistant.Applications.Assets.Models"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.FavoritesPageView"
             x:DataType="vm:FavoritesPageViewModel">

    <UserControl.Resources>
        <converts:PriceChangeColorConverter x:Key="PriceChangeColorConverter"/>
        <converts:NullableVisibilityConverter x:Key="NullableVisibilityConverter"/>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:FavoritesPageViewModel/>
    </Design.DataContext>

    <!-- 收藏卡片（对齐原型 fav-card：宽 290 自适应换行） -->
    <UserControl.Styles>
        <Style Selector="Border.fav-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource DefaultCardPadding}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.fav-card:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- 根用 Panel 叠放各状态，使空态/加载占位可撑满整页垂直居中 -->
    <Panel Background="{DynamicResource CardBackgroundBrush}">

        <!-- 加载指示器 -->
        <StackPanel IsVisible="{Binding IsBusy}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource LargeSpacing}">
            <controls:LoadingDots DotSize="{StaticResource IndicatorSize}" />
            <TextBlock Text="正在加载自选列表..."
                       FontSize="{StaticResource LabelFontSize}"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- 内容区域（非加载状态） -->
        <Grid IsVisible="{Binding !IsBusy}" RowDefinitions="Auto,*">
            <!-- 视图切换分段器（有数据时显示）：当前视图按钮禁用，另一视图可点 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                        Spacing="{StaticResource SmallSpacing}" Margin="{StaticResource PagePadding}"
                        IsVisible="{Binding Assets.Count}">
                <Button Classes="action-button" Content="卡片视图"
                        Command="{Binding ShowCardViewCommand}" IsEnabled="{Binding IsTableView}"/>
                <Button Classes="action-button" Content="表格视图"
                        Command="{Binding ShowTableViewCommand}" IsEnabled="{Binding IsCardView}"/>
            </StackPanel>
            <Panel Grid.Row="1">
            <!-- 空视图：垂直居中 -->
            <StackPanel IsVisible="{Binding !Assets.Count}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource DefaultSpacing}">
                <svg:Svg Path="/Assets/Images/tab_favorites.svg"
                         Width="{StaticResource LargeIconSize}"
                         Height="{StaticResource LargeIconSize}"
                         HorizontalAlignment="Center"/>
                <TextBlock Text="暂无自选资产"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="在资产详情页点击「加入自选」添加"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{StaticResource SmallFontSize}" />
            </StackPanel>
            <!-- 收藏网格（对齐原型 fav-grid：auto-fill 自适应换行） -->
            <ScrollViewer IsVisible="{Binding IsCardView}">
                <ItemsControl ItemsSource="{Binding Assets}"
                              Margin="{StaticResource PagePadding}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="assets:AssetInfo">
                        <Border Classes="fav-card"
                                Width="290"
                                Margin="{StaticResource CardGridMargin}"
                                Tapped="OnStockItemTapped"
                                KeyDown="OnStockItemKeyDown"
                                Focusable="True"
                                AutomationProperties.Name="{Binding Name}"
                                Tag="{Binding .}">
                            <StackPanel Spacing="{StaticResource SmallSpacing}">
                                <!-- 顶部：代码/板块 | 删除 -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="{StaticResource CompactSpacing}">
                                        <TextBlock Text="{Binding Code}"
                                                   FontFamily="{StaticResource DataFontFamily}"
                                                   FontSize="{StaticResource TinyFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding SectorName}"
                                                   FontSize="{StaticResource TinyFontSize}"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   IsVisible="{Binding SectorName, Converter={StaticResource NullableVisibilityConverter}}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Classes="delete-button"
                                            Width="{StaticResource TinyIconButtonSize}"
                                            Height="{StaticResource TinyIconButtonSize}"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            BorderThickness="{StaticResource NoBorderThickness}"
                                            Padding="{StaticResource NoPadding}"
                                            Tapped="OnDeleteButtonTapped"
                                            Command="{Binding $parent[UserControl].((vm:FavoritesPageViewModel)DataContext).RemoveFavoriteCommand}"
                                            CommandParameter="{Binding .}">
                                        <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                  Width="{StaticResource TinyIconSize}"
                                                  Height="{StaticResource TinyIconSize}"
                                                  Foreground="{StaticResource ErrorBrush}" />
                                    </Button>
                                </Grid>

                                <!-- 名称 -->
                                <TextBlock Text="{Binding Name}"
                                           FontSize="{StaticResource MediumFontSize}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                                <!-- 底部：价格 | 涨跌幅 -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding CurrentPrice}"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontSize="{StaticResource LargeFontSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1"
                                            Background="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}, ConverterParameter=tag}"
                                            CornerRadius="{StaticResource TinyCornerRadius}"
                                            Padding="{StaticResource TinyPadding}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ChangePercentage}"
                                                   FontSize="{StaticResource SmallFontSize}"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}}"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 高密度表格视图（对齐 design.md 4.7 Dense Table）：列头点击排序，行双击进详情 -->
            <DataGrid ItemsSource="{Binding Assets}"
                      IsVisible="{Binding IsTableView}"
                      Margin="{StaticResource PagePadding}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserResizeColumns="True"
                      DoubleTapped="OnGridRowDoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="代码" Binding="{Binding Code}"
                                        FontFamily="{StaticResource DataFontFamily}" Width="Auto"/>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="现价" Binding="{Binding CurrentPrice}"
                                        SortMemberPath="PriceValue"
                                        FontFamily="{StaticResource DataFontFamily}"
                                        Width="Auto"/>
                    <DataGridTemplateColumn Header="涨跌幅" SortMemberPath="ChangePercentValue" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="assets:AssetInfo">
                                <Border Background="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}, ConverterParameter=tag}"
                                        CornerRadius="{StaticResource TinyCornerRadius}"
                                        Padding="{StaticResource TinyPadding}"
                                        Margin="{StaticResource TinyMargin}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ChangePercentage}"
                                               FontFamily="{StaticResource DataFontFamily}"
                                               FontSize="{StaticResource SmallFontSize}"
                                               FontWeight="Bold"
                                               Foreground="{Binding ChangePercentage, Converter={StaticResource PriceChangeColorConverter}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="assets:AssetInfo">
                                <Button Width="{StaticResource TinyIconButtonSize}"
                                        Height="{StaticResource TinyIconButtonSize}"
                                        Background="Transparent"
                                        BorderThickness="{StaticResource NoBorderThickness}"
                                        Padding="{StaticResource NoPadding}"
                                        Cursor="Hand"
                                        ToolTip.Tip="移出自选"
                                        HorizontalAlignment="Center"
                                        Command="{Binding $parent[DataGrid].((vm:FavoritesPageViewModel)DataContext).RemoveFavoriteCommand}"
                                        CommandParameter="{Binding .}">
                                    <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                              Width="{StaticResource TinyIconSize}"
                                              Height="{StaticResource TinyIconSize}"
                                              Foreground="{StaticResource ErrorBrush}"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Panel>
        </Grid>
    </Panel>
</UserControl>
