<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:converts="using:MarketAssistant.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MarketAssistant.Views.Pages.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">

    <UserControl.Resources>
        <converts:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
        <Thickness x:Key="GridItemMargin">0,0,8,16</Thickness>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Path.Spin">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <vm:SettingsPageViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto">
        <!-- 主内容区域 -->
        <ScrollViewer Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}">
            <StackPanel Spacing="{StaticResource DefaultSpacing}" Margin="{StaticResource PagePadding}">

                <!-- 外观设置 -->
                <controls:CardView Header="外观设置">
                    <StackPanel Spacing="{StaticResource DefaultSpacing}">
                        <TextBlock Text="主题"
                                   FontSize="{StaticResource LabelFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource DefaultSpacing}">
                            <RadioButton Content="跟随系统"
                                         IsChecked="{Binding IsThemeDefault}"
                                         GroupName="Theme"/>
                            <RadioButton Content="浅色"
                                         IsChecked="{Binding IsThemeLight}"
                                         GroupName="Theme"/>
                            <RadioButton Content="深色"
                                         IsChecked="{Binding IsThemeDark}"
                                         GroupName="Theme"/>
                        </StackPanel>
                    </StackPanel>
                </controls:CardView>

                <!-- 模型设置区域 -->
                <controls:CardView Header="模型设置">
                    <StackPanel Spacing="{StaticResource DefaultSpacing}">
                        <!-- 服务商选择 -->
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="服务商"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding Providers}"
                                      SelectedItem="{Binding SelectedProvider}"
                                      DisplayMemberBinding="{Binding DisplayName}"
                                      PlaceholderText="选择服务商"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- 自定义端点（仅 Custom / Ollama / LMStudio 显示） -->
                        <StackPanel Spacing="{StaticResource SmallSpacing}"
                                    IsVisible="{Binding CanOverrideEndpoint}">
                            <TextBlock Text="API端点"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding UserSetting.Endpoint}"
                                     PlaceholderText="自定义 API 端点"/>
                        </StackPanel>

                        <!-- API密钥 -->
                        <StackPanel Spacing="{StaticResource SmallSpacing}"
                                    IsVisible="{Binding RequiresApiKey}">
                            <TextBlock Text="API密钥"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding ApiKey}"
                                         PlaceholderText="请输入API密钥"
                                         PasswordChar="●"/>
                                <Button Grid.Column="1"
                                        Content="获取密钥"
                                        Classes="btn-primary"
                                        Command="{Binding OpenModelApiWebsiteCommand}"
                                        IsVisible="{Binding ProviderApiKeyUrl, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        Margin="{StaticResource SmallLeftMargin}"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="免费模型不等于免鉴权：是否需要 API Key 由服务商接口决定；本地服务或明确支持匿名调用的模型才可留空。"
                                   FontSize="{StaticResource SmallFontSize}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <!-- 模型选择 -->
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="模型"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <!-- 无模型列表时手动输入 -->
                                <TextBox Grid.Column="0"
                                         Text="{Binding UserSetting.ModelId}"
                                         PlaceholderText="输入模型 ID"
                                         HorizontalAlignment="Stretch"
                                         IsVisible="{Binding !Models.Count}"/>
                                <!-- 有模型列表时替换为下拉选择 -->
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding Models}"
                                          SelectedItem="{Binding UserSetting.ModelId}"
                                          PlaceholderText="选择模型"
                                          HorizontalAlignment="Stretch"
                                          IsVisible="{Binding Models.Count}"/>
                                <!-- 获取按钮（加载时隐藏，由旋转图标替代） -->
                                <Button Grid.Column="1"
                                        Content="获取"
                                        Classes="btn-info"
                                        Command="{Binding FetchModelsCommand}"
                                        IsVisible="{Binding CanShowFetchButton}"
                                        Margin="{StaticResource SmallLeftMargin}"/>
                                <!-- 加载旋转图标 -->
                                <Path Grid.Column="1"
                                      Data="{StaticResource LoadingIcon}"
                                      Fill="{DynamicResource PrimaryBrush}"
                                      Width="16" Height="16"
                                      IsVisible="{Binding IsLoadingModels}"
                                      Margin="{StaticResource SmallLeftMargin}"
                                      Classes="Spin"
                                      RenderTransformOrigin="50%,50%"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </controls:CardView>

                <!-- 嵌入模型设置 -->
                <controls:CardView Header="嵌入模型设置">
                    <StackPanel Spacing="{StaticResource DefaultSpacing}">
                        <!-- API端点 -->
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="API端点"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding UserSetting.EmbeddingEndpoint}"
                                     PlaceholderText="嵌入服务API端点"/>
                        </StackPanel>

                        <!-- API密钥 -->
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="API密钥"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding UserSetting.EmbeddingApiKey}"
                                         PlaceholderText="请输入嵌入服务API密钥"
                                         PasswordChar="&#9679;"/>
                                <Button Grid.Column="1"
                                        Content="获取密钥"
                                        Classes="btn-info"
                                        Command="{Binding OpenEmbeddingApiWebsiteCommand}"
                                        Margin="{StaticResource SmallLeftMargin}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 嵌入模型ID -->
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="嵌入模型"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding UserSetting.EmbeddingModelId}"
                                     PlaceholderText="嵌入模型ID"/>
                        </StackPanel>
                    </StackPanel>
                </controls:CardView>

                <!-- 市场设置区域 -->
                <controls:CardView Header="市场设置">
                    <StackPanel Spacing="{StaticResource DefaultSpacing}">
                        <!-- 市场类型选择 -->
                        <StackPanel Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="市场类型"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource DefaultSpacing}">
                                <RadioButton Content="A股市场" 
                                             GroupName="MarketType"
                                             IsChecked="{Binding IsAShareMarket}"/>
                                <RadioButton Content="虚拟币市场" 
                                             GroupName="MarketType"
                                             IsChecked="{Binding IsCryptoMarket}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- A股市场API配置 -->
                        <StackPanel Spacing="{StaticResource SmallSpacing}" 
                                    IsVisible="{Binding IsAShareMarket}">
                            <TextBlock Text="ZhiTu API令牌"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding UserSetting.ZhiTuApiToken}"
                                         PlaceholderText="请输入ZhiTu API令牌"/>
                                <Button Grid.Column="1"
                                        Content="获取令牌"
                                        Classes="btn-info"
                                        Command="{Binding OpenZhiTuApiWebsiteCommand}"
                                        Margin="{StaticResource SmallLeftMargin}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 虚拟币市场API配置 -->
                        <StackPanel Spacing="{StaticResource SmallSpacing}" 
                                    IsVisible="{Binding IsCryptoMarket}">
                            <TextBlock Text="交易环境与 API 密钥"
                                       FontSize="{StaticResource LabelFontSize}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="交易模式切换与 Binance API 密钥配置已移至交易页面的「API 密钥」标签页，密钥使用 AES-GCM 加密独立存储。"
                                       FontSize="{StaticResource SmallFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>

                            <!-- CoinGecko API密钥 -->
                            <TextBlock Text="CoinGecko API密钥（可选）"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="{StaticResource SmallTopMargin}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Text="{Binding UserSetting.CoinGeckoApiKey}"
                                         PlaceholderText="可选，免费版无需填写"
                                         PasswordChar="●"/>
                                <Button Grid.Column="1"
                                        Content="获取密钥"
                                        Classes="btn-info"
                                        Command="{Binding OpenCoinGeckoApiWebsiteCommand}"
                                        Margin="{StaticResource SmallLeftMargin}"/>
                            </Grid>
                            <TextBlock Text="用于获取代币市值、供应量等数据。免费版有限额但无需API Key"
                                       FontSize="{StaticResource SmallFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </controls:CardView>

                <!-- 投资偏好设置 -->
                <controls:CardView Header="投资偏好设置">
                    <Grid ColumnDefinitions="*,16,*">
                        <!-- 风险承受能力 -->
                        <StackPanel Grid.Column="0" Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="风险承受能力"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding RiskToleranceOptions}"
                                      SelectedItem="{Binding UserSetting.InvestmentPreference.RiskTolerance}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- 投资期限 -->
                        <StackPanel Grid.Column="2" Spacing="{StaticResource SmallSpacing}">
                            <TextBlock Text="投资期限"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding InvestmentHorizonOptions}"
                                      SelectedItem="{Binding UserSetting.InvestmentPreference.InvestmentHorizon}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </controls:CardView>

                <!-- 知识库设置区域 -->
                <controls:CardView Header="知识库设置">
                    <StackPanel Spacing="{StaticResource DefaultSpacing}">
                        <!-- 是否加载知识库 -->
                        <CheckBox IsChecked="{Binding UserSetting.LoadKnowledge}"
                                  Content="加载知识库"/>

                        <StackPanel Spacing="{StaticResource DefaultSpacing}" 
                                    IsEnabled="{Binding UserSetting.LoadKnowledge}">
                            <!-- 知识文件目录 -->
                            <StackPanel Spacing="{StaticResource SmallSpacing}">
                                <TextBlock Text="知识文件目录"
                                           FontSize="{StaticResource LabelFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding UserSetting.KnowledgeFileDirectory}"
                                             PlaceholderText="请选择知识库目录"
                                             IsReadOnly="True"/>
                                    <Button Grid.Column="1"
                                            Content="浏览"
                                            Classes="btn-primary"
                                            Command="{Binding SelectKnowledgeDirectoryCommand}"
                                            Margin="{StaticResource SmallLeftMargin}"/>
                                </Grid>
                            </StackPanel>

                            <!-- 知识库向量化 -->
                            <StackPanel Spacing="{StaticResource SmallSpacing}">
                                <TextBlock Text="知识库向量化"
                                           FontSize="{StaticResource LabelFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource DefaultSpacing}">
                                    <Button Content="向量化文档"
                                            Classes="success"
                                            Command="{Binding VectorizeDocumentsCommand}"
                                            IsEnabled="{Binding IsKnowledgeDirectoryValid}"/>
                                    <PathIcon Data="{StaticResource LoadingIcon}"
                                              Width="{StaticResource DefaultIconSize}"
                                              Height="{StaticResource DefaultIconSize}"
                                              Foreground="{StaticResource PrimaryBrush}"
                                              IsVisible="{Binding IsVectorizing}"/>
                                </StackPanel>
                                
                                <!-- 向量化进度 -->
                                <StackPanel IsVisible="{Binding IsVectorizing}" Spacing="{StaticResource SmallSpacing}">
                                    <ProgressBar Value="{Binding VectorizingProgress}"
                                                 Maximum="100"
                                                 Height="{StaticResource ProgressBarHeight}"/>
                                    <TextBlock Text="{Binding VectorizingProgressText}"
                                               FontSize="{StaticResource BodyFontSize}"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               FontWeight="Medium"/>
                                </StackPanel>
                                
                                <TextBlock Text="将读取知识文件夹中的PDF、DOCX和Markdown文件并进行向量化存储"
                                           FontSize="{StaticResource SmallFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </controls:CardView>

                <!-- 市场分析师角色设置区域 -->
                <controls:CardView Header="市场分析师角色设置">
                    <StackPanel Spacing="{StaticResource LargeSpacing}">
                        <StackPanel Spacing="{StaticResource TinySpacing}">
                            <TextBlock Text="选择参与分析讨论的角色"
                                       FontSize="{StaticResource LabelFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="注意：启用的角色越多，消耗的Token越多"
                                       FontSize="{StaticResource SmallFontSize}"
                                       Foreground="{StaticResource ErrorBrush}"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding AnalystRoles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" 
                                          RowDefinitions="Auto,Auto" 
                                          Margin="{StaticResource GridItemMargin}">
                                        <CheckBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                                  IsChecked="{Binding IsEnabled}"
                                                  IsEnabled="{Binding !IsRequired}"
                                                  VerticalAlignment="Top"
                                                  Margin="{StaticResource SmallRightMargin}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="{StaticResource LabelFontSize}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding Description}"
                                                   FontSize="{StaticResource SmallFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="{StaticResource TinyTopMargin}"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </controls:CardView>

                <!-- 通知设置区域 -->
                <controls:CardView Header="通知设置">
                    <CheckBox IsChecked="{Binding UserSetting.Notification}"
                              Content="开启通知"/>
                </controls:CardView>

                <!-- 日志设置区域 -->
                <controls:CardView Header="日志设置">
                    <StackPanel Spacing="{StaticResource SmallSpacing}">
                        <TextBlock Text="日志文件路径"
                                   FontSize="{StaticResource LabelFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0"
                                     Text="{Binding UserSetting.LogPath}"
                                     PlaceholderText="请输入日志文件路径"/>
                            <Button Grid.Column="1"
                                    Content="浏览"
                                    Classes="btn-info"
                                    Command="{Binding SelectLogPathCommand}"
                                    Margin="{StaticResource SmallLeftMargin}"/>
                        </Grid>
                    </StackPanel>
                </controls:CardView>

                <!-- Web Search设置区域 -->
                <controls:CardView Header="Web Search设置">
                    <StackPanel Spacing="{StaticResource DefaultSpacing}">
                        <!-- 是否启用Web Search -->
                        <CheckBox IsChecked="{Binding UserSetting.EnableWebSearch}"
                                  Content="启用Web Search功能"/>

                        <StackPanel Spacing="{StaticResource DefaultSpacing}" 
                                    IsEnabled="{Binding UserSetting.EnableWebSearch}">
                            <!-- 搜索平台选择 -->
                            <StackPanel Spacing="{StaticResource SmallSpacing}">
                                <TextBlock Text="搜索平台选择"
                                           FontSize="{StaticResource LabelFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource DefaultSpacing}">
                                    <RadioButton Content="Bing" 
                                                 GroupName="SearchProvider"
                                                 IsChecked="{Binding IsBingProvider}"/>
                                    <RadioButton Content="Brave" 
                                                 GroupName="SearchProvider"
                                                 IsChecked="{Binding IsBraveProvider}"/>
                                    <RadioButton Content="Tavily" 
                                                 GroupName="SearchProvider"
                                                 IsChecked="{Binding IsTavilyProvider}"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- API Key -->
                            <StackPanel Spacing="{StaticResource SmallSpacing}">
                                <TextBlock Text="Web Search API Key"
                                           FontSize="{StaticResource LabelFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding UserSetting.WebSearchApiKey}"
                                         PlaceholderText="请输入Web Search API Key"/>
                            </StackPanel>
                            
                            <TextBlock Text="注意：启用Web Search功能需要配置有效的API Key"
                                       FontSize="{StaticResource SmallFontSize}"
                                       Foreground="{StaticResource ErrorBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </controls:CardView>

                <!-- MCP服务器配置区域 -->
                <controls:CardView Header="MCP服务器配置">
                    <StackPanel Spacing="{StaticResource SmallSpacing}">
                        <TextBlock Text="配置MCP服务器，用于连接外部服务"
                                   FontSize="{StaticResource LabelFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button Content="MCP服务器配置"
                                Classes="btn-info"
                                Command="{Binding NavigateToMCPConfigCommand}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </controls:CardView>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作栏 -->
        <Border Grid.Row="1" 
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource TopBorderThickness}"
                Padding="{StaticResource FooterPadding}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="{StaticResource DefaultSpacing}">
                <Button Content="重置"
                        Command="{Binding ResetCommand}"
                        Background="{DynamicResource TextSecondaryBrush}"
                        Foreground="White"
                        MinWidth="{StaticResource MediumButtonMinWidth}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
                <Button Content="保存"
                        Classes="btn-primary"
                        Command="{Binding SaveCommand}"
                        MinWidth="{StaticResource MediumButtonMinWidth}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>