<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:views="using:MarketAssistant.Views.Pages"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:alert="using:MarketAssistant.Applications.PriceAlert"
             xmlns:converts="using:MarketAssistant.Converters"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.PriceAlertPageView"
             x:DataType="vm:PriceAlertPageViewModel">

    <Design.DataContext>
        <vm:PriceAlertPageViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <converts:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
        <converts:PriceChangeColorConverter x:Key="PriceChangeColorConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Ellipse.rule-dot">
            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
        </Style>
        <Style Selector="Ellipse.rule-dot.disabled">
            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Ellipse.rule-dot.triggered">
            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
        </Style>
        <Style Selector="Border.alert-rule-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="{DynamicResource CardBackgroundBrush}">
        <controls:CardView Margin="{StaticResource PagePadding}">
            <controls:CardView.Header>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="{StaticResource SmallSpacing}"
                                VerticalAlignment="Center">
                        <svg:Svg Path="/Assets/Images/tab_alert.svg"
                                 Width="{StaticResource DefaultIconSize}"
                                 Height="{StaticResource DefaultIconSize}"/>
                        <StackPanel Spacing="{StaticResource CompactSpacing}">
                            <TextBlock Text="价格告警"
                                       FontSize="{StaticResource LargeFontSize}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="持续跟踪目标价格与涨跌幅，行情更新后自动判定"
                                       FontSize="{StaticResource SmallFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="刷新列表"
                            Command="{Binding RefreshCommand}"
                            Classes="btn-secondary"
                            VerticalAlignment="Center"/>
                </Grid>
            </controls:CardView.Header>

            <Grid RowDefinitions="Auto,*">
                <TabControl Grid.Row="0"
                            SelectedIndex="{Binding SelectedTabIndex}">
                    <TabItem Header="告警规则"/>
                    <TabItem Header="告警历史"/>
                </TabControl>

                <!-- 规则管理（原有内容，仅在"告警规则"标签页显示） -->
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*"
                      IsVisible="{Binding !IsHistoryTabSelected}">
                <Border Grid.Row="0"
                        Background="{DynamicResource SelectedBackgroundBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        BorderThickness="{StaticResource DefaultBorderThickness}"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="{StaticResource DefaultCardPadding}"
                        Margin="{StaticResource BottomMargin}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource DefaultSpacing}">
                        <Border Grid.Column="0"
                                Width="48"
                                Height="48"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                VerticalAlignment="Top">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                                      Width="{StaticResource DefaultIconSize}"
                                      Height="{StaticResource DefaultIconSize}"
                                      Foreground="{StaticResource TextOnEmphasisBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="{StaticResource DefaultSpacing}">
                            <StackPanel Spacing="{StaticResource CompactSpacing}">
                                <TextBlock Text="创建告警规则"
                                           FontSize="{StaticResource SectionTitleFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="持续告警进入目标区间提醒一次、离开后自动复位；勾选“仅提醒一次”则触发后自动停用，可手动重新启用。"
                                           FontSize="{StaticResource SmallFontSize}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,2*,Auto,*,Auto,*,Auto,Auto"
                                  ColumnSpacing="{StaticResource SmallSpacing}">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding AssetLabelText}"
                                           Classes="form-label"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          IsEditable="True"
                                          ItemsSource="{Binding AssetOptions}"
                                          SelectedItem="{Binding NewRuleSelectedAsset}"
                                          Text="{Binding NewRuleAssetText, Mode=TwoWay}"
                                          IsDropDownOpen="{Binding IsAssetDropDownOpen, Mode=TwoWay}"
                                          PlaceholderText="{Binding AssetPlaceholderText}"
                                          MaxDropDownHeight="{StaticResource DropDownMaxHeight}"
                                          MinHeight="{StaticResource InputHeight}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AssetOption">
                                            <StackPanel Spacing="{StaticResource CompactSpacing}"
                                                        Margin="{StaticResource TinyMargin}">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="{StaticResource LabelFontSize}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Code}"
                                                           FontSize="{StaticResource SmallFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Column="2"
                                           Text="触发条件"
                                           Classes="form-label"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="3"
                                          ItemsSource="{Binding ConditionOptions}"
                                          SelectedItem="{Binding NewRuleCondition}"
                                          MinHeight="{StaticResource InputHeight}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Column="4"
                                           Text="{Binding TargetLabelText}"
                                           Classes="form-label"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="5"
                                         Text="{Binding NewRuleTargetValue}"
                                         PlaceholderText="{Binding TargetPlaceholderText}"
                                         MinHeight="{StaticResource InputHeight}"/>

                                <CheckBox Grid.Column="6"
                                          Content="仅提醒一次"
                                          IsChecked="{Binding NewRuleIsOneTime}"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="触发一次后自动停用；可手动重新启用。默认持续告警，离开目标区间后自动复位。"/>

                                <Button Grid.Column="7"
                                        Content="创建告警"
                                        Command="{Binding AddRuleCommand}"
                                        Classes="btn-primary"
                                        MinWidth="{StaticResource MediumButtonMinWidth}"
                                        MinHeight="{StaticResource InputHeight}"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="{Binding ValidationError}"
                                       Classes="form-error"
                                       IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <!-- 高级选项：去抖 / 冷却 / 限次 / 交易联动（默认收起，保持常用创建路径简洁） -->
                            <Expander HorizontalAlignment="Stretch"
                                      IsExpanded="{Binding IsAdvancedOptionsExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <TextBlock Text="高级选项（去抖确认 / 冷却 / 触发次数 / 交易联动）"
                                               FontSize="{StaticResource LabelFontSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Expander.Header>
                                <StackPanel Spacing="{StaticResource CompactSpacing}"
                                            Margin="{StaticResource TinyMargin}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*"
                                          ColumnSpacing="{StaticResource SmallSpacing}">
                                        <TextBlock Grid.Column="0"
                                                   Text="去抖确认（连续行情次数）"
                                                   Classes="form-label"
                                                   VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="1"
                                                       Value="{Binding NewRuleConfirmTicks, Mode=TwoWay}"
                                                       Minimum="0"
                                                       Maximum="100"
                                                       Increment="1"
                                                       ShowButtonSpinner="False"
                                                       Width="110"
                                                       HorizontalAlignment="Left"
                                                       ToolTip.Tip="条件需连续满足指定行情次数才触发，0 表示立即触发"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="冷却时间（分钟）"
                                                   Classes="form-label"
                                                   VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="3"
                                                       Value="{Binding NewRuleCooldownMinutes, Mode=TwoWay}"
                                                       Minimum="0"
                                                       Maximum="1440"
                                                       Increment="5"
                                                       ShowButtonSpinner="False"
                                                       Width="110"
                                                       HorizontalAlignment="Left"
                                                       ToolTip.Tip="两次触发之间的最小间隔，0 表示不冷却"/>

                                        <TextBlock Grid.Column="4"
                                                   Text="最大触发次数"
                                                   Classes="form-label"
                                                   VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="5"
                                                       Value="{Binding NewRuleMaxTriggerCount, Mode=TwoWay}"
                                                       Minimum="0"
                                                       Maximum="1000"
                                                       Increment="1"
                                                       ShowButtonSpinner="False"
                                                       Width="110"
                                                       HorizontalAlignment="Left"
                                                       ToolTip.Tip="达到次数后规则不再触发，0 表示不限；勾选“仅提醒一次”时恒为 1 次"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto,*"
                                          ColumnSpacing="{StaticResource SmallSpacing}">
                                        <TextBlock Grid.Column="0"
                                                   Text="去抖持续（秒）"
                                                   Classes="form-label"
                                                   VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Column="1"
                                                       Value="{Binding NewRuleConfirmSeconds, Mode=TwoWay}"
                                                       Minimum="0"
                                                       Maximum="600"
                                                       Increment="5"
                                                       ShowButtonSpinner="False"
                                                       Width="110"
                                                       HorizontalAlignment="Left"
                                                       ToolTip.Tip="条件需持续满足的秒数，与连续次数同时配置时取更严判定；0 表示不限制"/>
                                    </Grid>

                                    <CheckBox Content="确认级告警：触发期间该标的的 AI 交易信号强制人工确认（条件离开告警区间后自动解除）"
                                              IsChecked="{Binding NewRuleRequireConfirmation}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander>

                            <Border Background="{DynamicResource SurfaceVariantBrush}"
                                    CornerRadius="{StaticResource TinyCornerRadius}"
                                    Padding="{StaticResource SmallCardPadding}"
                                    IsVisible="{Binding !IsNotificationEnabled}">
                                <TextBlock Text="桌面通知已关闭：告警触发状态仍会记录，但不会显示弹窗。请在“设置 → 通知设置”中开启通知。"
                                           FontSize="{StaticResource SmallFontSize}"
                                           Foreground="{StaticResource WarningBrush}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      ColumnDefinitions="*,Auto"
                      Margin="{StaticResource SmallBottomMargin}">
                    <StackPanel Grid.Column="0" Spacing="{StaticResource CompactSpacing}">
                        <TextBlock Text="告警规则"
                                   FontSize="{StaticResource SectionTitleFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="浮动值 = 当前告警值 - 实际阈值（跌幅目标 3% 的实际阈值为 -3%）"
                                   FontSize="{StaticResource SmallFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{DynamicResource SurfaceVariantBrush}"
                            CornerRadius="{StaticResource TinyCornerRadius}"
                            Padding="{StaticResource TagPadding}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Rules.Count, StringFormat='{}{0} 条'}"
                                   FontSize="{StaticResource SmallFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2"
                            IsVisible="{Binding IsBusy}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource DefaultSpacing}"
                            Margin="{StaticResource BottomMargin}">
                    <controls:LoadingDots DotSize="{StaticResource IndicatorSize}"/>
                    <TextBlock Text="正在加载..."
                               FontSize="{StaticResource SmallFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <Grid Grid.Row="3" IsVisible="{Binding !IsBusy}">
                    <StackPanel IsVisible="{Binding !Rules.Count}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource DefaultSpacing}">
                        <svg:Svg Path="/Assets/Images/empty_data.svg"
                                 Width="{StaticResource LargeIconSize}"
                                 Height="{StaticResource LargeIconSize}"
                                 HorizontalAlignment="Center"
                                 Opacity="0.6"/>
                        <TextBlock Text="暂无告警规则"
                                   FontSize="{StaticResource SubTitleFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyHintText}"
                                   FontSize="{StaticResource SmallFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Rules}"
                                  IsVisible="{Binding Rules.Count}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource SmallSpacing}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="alert:PriceAlertRule">
                                <Border Classes="alert-rule-card"
                                        Background="{DynamicResource ItemBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="{StaticResource DefaultBorderThickness}"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        Padding="{StaticResource DefaultPadding}">
                                    <Grid ColumnDefinitions="2*,1.2*,1.2*,1.6*,Auto,Auto"
                                          ColumnSpacing="{StaticResource DefaultSpacing}">
                                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SmallSpacing}">
                                            <Ellipse Grid.Column="0"
                                                     Classes="rule-dot"
                                                     Classes.disabled="{Binding !Enabled}"
                                                     Classes.triggered="{Binding Triggered}"
                                                     Width="{StaticResource DotIconSize}"
                                                     Height="{StaticResource DotIconSize}"
                                                     VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AssetName}"
                                                           FontSize="{StaticResource LabelFontSize}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="{StaticResource TinySpacing}"
                                                            Margin="{StaticResource TinyTopMargin}">
                                                    <TextBlock Text="{Binding AssetCode}"
                                                               FontSize="{StaticResource SmallFontSize}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <Border Background="{DynamicResource SurfaceVariantBrush}"
                                                            CornerRadius="{StaticResource TinyCornerRadius}"
                                                            Padding="{StaticResource TagPadding}">
                                                        <TextBlock Text="{Binding MarketType, Converter={StaticResource EnumDescriptionConverter}}"
                                                                   FontSize="{StaticResource TinyFontSize}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                    <Border Background="{StaticResource WarningBrush}"
                                                            CornerRadius="{StaticResource TinyCornerRadius}"
                                                            Padding="{StaticResource TagPadding}"
                                                            IsVisible="{Binding IsOneTime}">
                                                        <TextBlock Text="一次性" FontSize="{StaticResource TinyFontSize}" Foreground="{StaticResource TextOnEmphasisBrush}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource SurfaceVariantBrush}"
                                                            CornerRadius="{StaticResource TinyCornerRadius}"
                                                            Padding="{StaticResource TagPadding}"
                                                            IsVisible="{Binding !IsOneTime}">
                                                        <TextBlock Text="持续" FontSize="{StaticResource TinyFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                    <Border Background="{StaticResource WarningBrush}"
                                                            CornerRadius="{StaticResource TinyCornerRadius}"
                                                            Padding="{StaticResource TagPadding}"
                                                            IsVisible="{Binding Triggered}">
                                                        <TextBlock Text="已触发" FontSize="{StaticResource TinyFontSize}" Foreground="{StaticResource TextOnEmphasisBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                                            <TextBlock Text="告警条件" FontSize="{StaticResource TinyFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{StaticResource TinySpacing}"
                                                        IsVisible="{Binding Condition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static alert:AlertCondition.PriceAbove}}">
                                                <TextBlock Text="↑ 涨破" FontWeight="SemiBold" Foreground="{StaticResource BullishBrush}"/>
                                                <TextBlock Text="{Binding TargetPrice, StringFormat='{}{0:N2}'}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{StaticResource TinySpacing}"
                                                        IsVisible="{Binding Condition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static alert:AlertCondition.PriceBelow}}">
                                                <TextBlock Text="↓ 跌破" FontWeight="SemiBold" Foreground="{StaticResource BearishBrush}"/>
                                                <TextBlock Text="{Binding TargetPrice, StringFormat='{}{0:N2}'}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{StaticResource TinySpacing}"
                                                        IsVisible="{Binding Condition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static alert:AlertCondition.ChangePercentAbove}}">
                                                <TextBlock Text="↑ 涨幅超" FontWeight="SemiBold" Foreground="{StaticResource BullishBrush}"/>
                                                <TextBlock Text="{Binding TargetPrice, StringFormat='{}{0:N2}%'}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{StaticResource TinySpacing}"
                                                        IsVisible="{Binding Condition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static alert:AlertCondition.ChangePercentBelow}}">
                                                <TextBlock Text="↓ 跌幅超" FontWeight="SemiBold" Foreground="{StaticResource BearishBrush}"/>
                                                <TextBlock Text="{Binding TargetPrice, StringFormat='{}{0:N2}%'}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding RuleOptionsText}"
                                                       FontSize="{StaticResource TinyFontSize}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding RuleOptionsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                                            <TextBlock Text="实时价格" FontSize="{StaticResource TinyFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding CurrentPriceText}"
                                                       FontFamily="{StaticResource DataFontFamily}"
                                                       FontSize="{StaticResource LabelFontSize}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding QuoteDisplayValue}"
                                                       FontSize="{StaticResource TinyFontSize}"
                                                       Foreground="{Binding CurrentChangePercent, Converter={StaticResource PriceChangeColorConverter}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                                            <TextBlock Text="当前浮动值" FontSize="{StaticResource TinyFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding FloatingValueText}"
                                                       FontFamily="{StaticResource DataFontFamily}"
                                                       FontSize="{StaticResource BodyFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding FloatingValue, Converter={StaticResource PriceChangeColorConverter}}"/>
                                            <TextBlock Text="{Binding QuoteStatusText}"
                                                       FontSize="{StaticResource TinyFontSize}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <ToggleSwitch Grid.Column="4"
                                                      Width="48"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      Command="{Binding $parent[UserControl].((vm:PriceAlertPageViewModel)DataContext).ToggleRuleCommand}"
                                                      CommandParameter="{Binding Id}"
                                                      ToolTip.Tip="{Binding StatusText}"/>

                                        <Button Grid.Column="5"
                                                Classes="btn-icon-sm"
                                                Command="{Binding $parent[UserControl].((vm:PriceAlertPageViewModel)DataContext).RemoveRuleCommand}"
                                                CommandParameter="{Binding Id}"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="删除">
                                            <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                      Width="{StaticResource TinyIconSize}"
                                                      Height="{StaticResource TinyIconSize}"
                                                      Foreground="{StaticResource ErrorBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                </Grid>

                <!-- 告警历史（仅在"告警历史"标签页显示） -->
                <views:AlertHistoryView Grid.Row="1"
                                        DataContext="{Binding AlertHistory}"
                                        IsVisible="{Binding $parent[UserControl].((vm:PriceAlertPageViewModel)DataContext).IsHistoryTabSelected}"/>
            </Grid>
        </controls:CardView>
    </ScrollViewer>
</UserControl>
