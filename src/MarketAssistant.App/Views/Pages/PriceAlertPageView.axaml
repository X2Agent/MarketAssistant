<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:alert="using:MarketAssistant.Applications.PriceAlert"
             xmlns:converts="using:MarketAssistant.Converters"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.PriceAlertPageView"
             x:DataType="vm:PriceAlertPageViewModel">

    <Design.DataContext>
        <vm:PriceAlertPageViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <converts:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 规则状态圆点：默认绿色（启用），停用时灰色，已触发时橙色优先 -->
        <Style Selector="Ellipse.rule-dot">
            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
        </Style>
        <Style Selector="Ellipse.rule-dot.disabled">
            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Ellipse.rule-dot.triggered">
            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="{DynamicResource CardBackgroundBrush}">
        <controls:CardView Margin="{StaticResource PagePadding}">
            <controls:CardView.Header>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="{StaticResource SmallSpacing}"
                                VerticalAlignment="Center">
                        <svg:Svg Path="/Assets/Images/tab_alert.svg"
                                 Width="{StaticResource DefaultIconSize}"
                                 Height="{StaticResource DefaultIconSize}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="价格告警"
                                   FontSize="{StaticResource LargeFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="刷新"
                            Command="{Binding RefreshCommand}"
                            Classes="btn-secondary"
                            VerticalAlignment="Center"/>
                </Grid>
            </controls:CardView.Header>

            <Grid RowDefinitions="Auto,Auto,*">

                <!-- 添加告警规则表单 -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceVariantBrush}"
                        CornerRadius="{StaticResource DefaultCornerRadius}"
                        Padding="{StaticResource DefaultPadding}"
                        Margin="{StaticResource BottomMargin}">
                    <StackPanel Spacing="{StaticResource SmallSpacing}">
                        <Grid ColumnDefinitions="210,150,150,Auto"
                              ColumnSpacing="{StaticResource SmallSpacing}">

                            <!-- 交易对搜索下拉 -->
                            <StackPanel Grid.Column="0" Spacing="{StaticResource TinySpacing}">
                                <TextBlock Text="交易对" Classes="form-label"/>
                                <AutoCompleteBox Text="{Binding NewRuleAssetText, Mode=TwoWay}"
                                                 ItemsSource="{Binding AssetOptions}"
                                                 SelectedItem="{Binding NewRuleSelectedAsset}"
                                                 PlaceholderText="搜索并选择交易对，如 BTC / 茅台"
                                                 FilterMode="Contains"
                                                 MinimumPrefixLength="1"
                                                 MaxDropDownHeight="320"/>
                            </StackPanel>

                            <!-- 触发条件 -->
                            <StackPanel Grid.Column="1" Spacing="{StaticResource TinySpacing}">
                                <TextBlock Text="触发条件" Classes="form-label"/>
                                <ComboBox ItemsSource="{Binding ConditionOptions}"
                                          SelectedItem="{Binding NewRuleCondition}"
                                          MinHeight="{StaticResource InputHeight}"
                                          VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- 目标值（价格或涨跌幅） -->
                            <StackPanel Grid.Column="2" Spacing="{StaticResource TinySpacing}">
                                <TextBlock Text="{Binding TargetLabelText}" Classes="form-label"/>
                                <TextBox Text="{Binding NewRuleTargetValue}"
                                         PlaceholderText="{Binding TargetPlaceholderText}"/>
                            </StackPanel>

                            <!-- 添加按钮 -->
                            <StackPanel Grid.Column="3"
                                        VerticalAlignment="Bottom"
                                        Spacing="{StaticResource TinySpacing}">
                                <Button Content="添加"
                                        Command="{Binding AddRuleCommand}"
                                        Classes="btn-primary"
                                        MinWidth="{StaticResource SmallButtonMinWidth}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 校验错误提示 -->
                        <TextBlock Text="{Binding ValidationError}"
                                   Classes="form-error"
                                   IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>

                <!-- 加载指示器 -->
                <StackPanel Grid.Row="1"
                            IsVisible="{Binding IsBusy}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource DefaultSpacing}"
                            Margin="{StaticResource BottomMargin}">
                    <controls:LoadingDots DotSize="{StaticResource IndicatorSize}"/>
                    <TextBlock Text="正在加载..."
                               FontSize="{StaticResource SmallFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- 规则列表 -->
                <Grid Grid.Row="2" IsVisible="{Binding !IsBusy}">

                    <!-- 空视图 -->
                    <StackPanel IsVisible="{Binding !Rules.Count}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource DefaultSpacing}">
                        <svg:Svg Path="/Assets/Images/empty_data.svg"
                                 Width="{StaticResource LargeIconSize}"
                                 Height="{StaticResource LargeIconSize}"
                                 HorizontalAlignment="Center"
                                 Opacity="0.6"/>
                        <TextBlock Text="暂无告警规则"
                                   FontSize="{StaticResource SubTitleFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyHintText}"
                                   FontSize="{StaticResource SmallFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 规则列表 -->
                    <ItemsControl ItemsSource="{Binding Rules}"
                                  IsVisible="{Binding Rules.Count}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource SmallSpacing}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="alert:PriceAlertRule">
                                <Border Background="{DynamicResource ItemBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="{StaticResource DefaultBorderThickness}"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        Padding="{StaticResource DefaultPadding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                          ColumnSpacing="{StaticResource SmallSpacing}">

                                        <!-- 状态圆点 -->
                                        <Ellipse Grid.Column="0"
                                                 Classes="rule-dot"
                                                 Classes.disabled="{Binding !Enabled}"
                                                 Classes.triggered="{Binding Triggered}"
                                                 Width="{StaticResource DotIconSize}"
                                                 Height="{StaticResource DotIconSize}"
                                                 VerticalAlignment="Center"/>

                                        <!-- 资产信息 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AssetName}"
                                                       FontSize="{StaticResource LabelFontSize}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{StaticResource TinySpacing}"
                                                        Margin="{StaticResource TinyTopMargin}">
                                                <TextBlock Text="{Binding AssetCode}"
                                                           FontSize="{StaticResource SmallFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <Border Background="{DynamicResource SurfaceVariantBrush}"
                                                        CornerRadius="{StaticResource TinyCornerRadius}"
                                                        Padding="{StaticResource TagPadding}">
                                                    <TextBlock Text="{Binding MarketType, Converter={StaticResource EnumDescriptionConverter}}"
                                                               FontSize="{StaticResource TinyFontSize}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                                <Border Background="{StaticResource WarningBrush}"
                                                        CornerRadius="{StaticResource TinyCornerRadius}"
                                                        Padding="{StaticResource TagPadding}"
                                                        IsVisible="{Binding Triggered}">
                                                    <TextBlock Text="已触发"
                                                               FontSize="{StaticResource TinyFontSize}"
                                                               Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 触发条件与目标价：涨破（红） -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="{StaticResource TinySpacing}"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding Condition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static alert:AlertCondition.PriceAbove}}">
                                            <TextBlock Text="↑ 涨破"
                                                       FontSize="{StaticResource BodyFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BullishBrush}"/>
                                            <TextBlock Text="{Binding TargetPrice, StringFormat='{}{0:N2}'}"
                                                       FontSize="{StaticResource BodyFontSize}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <!-- 触发条件与目标价：跌破（绿） -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="{StaticResource TinySpacing}"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding Condition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static alert:AlertCondition.PriceBelow}}">
                                            <TextBlock Text="↓ 跌破"
                                                       FontSize="{StaticResource BodyFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BearishBrush}"/>
                                            <TextBlock Text="{Binding TargetPrice, StringFormat='{}{0:N2}'}"
                                                       FontSize="{StaticResource BodyFontSize}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <!-- 触发条件与目标值：涨幅超（红） -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="{StaticResource TinySpacing}"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding Condition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static alert:AlertCondition.ChangePercentAbove}}">
                                            <TextBlock Text="↑ 涨幅超"
                                                       FontSize="{StaticResource BodyFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BullishBrush}"/>
                                            <TextBlock Text="{Binding TargetPrice, StringFormat='{}{0:N2}%'}"
                                                       FontSize="{StaticResource BodyFontSize}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <!-- 触发条件与目标值：跌幅超（绿） -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="{StaticResource TinySpacing}"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding Condition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static alert:AlertCondition.ChangePercentBelow}}">
                                            <TextBlock Text="↓ 跌幅超"
                                                       FontSize="{StaticResource BodyFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BearishBrush}"/>
                                            <TextBlock Text="{Binding TargetPrice, StringFormat='{}{0:N2}%'}"
                                                       FontSize="{StaticResource BodyFontSize}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <!-- 启停开关 -->
                                        <ToggleSwitch Grid.Column="3"
                                                      Width="48"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding Enabled}"
                                                      IsEnabled="{Binding !Triggered}"
                                                      Command="{Binding $parent[UserControl].((vm:PriceAlertPageViewModel)DataContext).ToggleRuleCommand}"
                                                      CommandParameter="{Binding Id}"
                                                      ToolTip.Tip="启用/禁用"/>

                                        <!-- 删除按钮 -->
                                        <Button Grid.Column="4"
                                                Classes="btn-icon-sm"
                                                Command="{Binding $parent[UserControl].((vm:PriceAlertPageViewModel)DataContext).RemoveRuleCommand}"
                                                CommandParameter="{Binding Id}"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="删除">
                                            <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                      Width="{StaticResource TinyIconSize}"
                                                      Height="{StaticResource TinyIconSize}"
                                                      Foreground="{StaticResource ErrorBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </controls:CardView>
    </ScrollViewer>
</UserControl>
