<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:views="using:MarketAssistant.Views.Pages"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:alert="using:MarketAssistant.Applications.PriceAlert"
             xmlns:converts="using:MarketAssistant.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.PriceAlertPageView"
             x:DataType="vm:PriceAlertPageViewModel">

    <Design.DataContext>
        <vm:PriceAlertPageViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <converts:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
        <converts:PriceChangeColorConverter x:Key="PriceChangeColorConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Ellipse.rule-dot">
            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
        </Style>
        <Style Selector="Ellipse.rule-dot.disabled">
            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Ellipse.rule-dot.triggered">
            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
        </Style>
        <!-- 一次性 / 已触发 / 持续：12% 语义底 + 同色字（design.md 7.5）。
             不用语义色实底——实底会抢走强调色的焦点，白字对比度也不足。 -->
        <Style Selector="Border.rule-tag">
            <Setter Property="CornerRadius" Value="{StaticResource TinyCornerRadius}"/>
            <Setter Property="Padding" Value="{StaticResource TagPadding}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
        </Style>
        <Style Selector="Border.rule-tag TextBlock">
            <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.rule-tag.warning">
            <Setter Property="Background" Value="{StaticResource WarningTagBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.rule-tag.warning TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="{StaticResource PagePadding}" RowDefinitions="Auto,*">

        <!-- ===== 页签栏：固定在内容区顶部，不随内容滚动 ===== -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderThickness="{StaticResource NoBorderThickness}"
                CornerRadius="{StaticResource CardCornerRadius}"
                Margin="{StaticResource BottomMargin}">
            <StackPanel Orientation="Horizontal" Margin="{StaticResource HorizontalMargin}">
                <Button Classes="underline-tab" Content="告警规则"
                        Classes.selected="{Binding IsRulesTabSelected}"
                        Command="{Binding SelectTabCommand}" CommandParameter="0"/>
                <Button Classes="underline-tab" Content="告警历史"
                        Classes.selected="{Binding IsHistoryTabSelected}"
                        Command="{Binding SelectTabCommand}" CommandParameter="1"/>
            </StackPanel>
        </Border>

        <!-- ===== 规则管理：表单与列表同处一个滚动区，窄窗下不会把列表压没 ===== -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsRulesTabSelected}">
            <Grid RowDefinitions="Auto,Auto,Auto">

                <!-- 创建规则卡片：与其它卡片同表面。不用 SelectedBackgroundBrush 铺底——
                     那是"选中项"的令牌，大面积铺开会变成整页第二个强调色焦点，
                     输入框的 SunkenBackgroundBrush 在其上也读不出凹陷层次。 -->
                <Border Grid.Row="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="{StaticResource NoBorderThickness}"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="{StaticResource CardPadding}"
                        Margin="{StaticResource BottomMargin}">
                    <StackPanel Spacing="{StaticResource DefaultSpacing}">
                        <StackPanel Spacing="{StaticResource CompactSpacing}">
                            <TextBlock Text="创建告警规则" Classes="card-title"/>
                            <TextBlock Text="持续告警进入目标区间提醒一次、离开后自动复位；勾选“仅提醒一次”则触发后自动停用，可手动重新启用。"
                                       Classes="caption"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 主字段：标签在上、控件在下。混排成一行会让每列宽度由标签字数决定，无法对齐。 -->
                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="*,*,*,*"
                              ColumnSpacing="{StaticResource GridGutter}"
                              RowSpacing="{StaticResource GridGutter}">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="{StaticResource TinySpacing}">
                                <TextBlock Text="{Binding AssetLabelText}" Classes="form-label"/>
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding AssetOptions}"
                                          SelectedItem="{Binding NewRuleSelectedAsset}"
                                          Text="{Binding NewRuleAssetText, Mode=TwoWay}"
                                          IsDropDownOpen="{Binding IsAssetDropDownOpen, Mode=TwoWay}"
                                          DropDownClosed="OnAssetBoxDropDownClosed"
                                          PlaceholderText="{Binding AssetPlaceholderText}"
                                          MaxDropDownHeight="{StaticResource DropDownMaxHeight}"
                                          MinHeight="{StaticResource InputHeight}"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="{Binding !IsWatchlistScopeSelected}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AssetOption">
                                            <StackPanel Spacing="{StaticResource CompactSpacing}"
                                                        Margin="{StaticResource TinyMargin}">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="{StaticResource BodySmFontSize}"
                                                           FontWeight="{DynamicResource WeightTitle}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Code}"
                                                           FontSize="{StaticResource CaptionFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="{StaticResource TinySpacing}">
                                <TextBlock Text="作用域" Classes="form-label"/>
                                <ComboBox ItemsSource="{Binding ScopeOptions}"
                                          SelectedItem="{Binding NewRuleScope}"
                                          MinHeight="{StaticResource InputHeight}"
                                          HorizontalAlignment="Stretch"
                                          ToolTip.Tip="自选股：对当前市场全部自选股生效，每个标的独立触发">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="{StaticResource TinySpacing}">
                                <TextBlock Text="触发条件" Classes="form-label"/>
                                <ComboBox ItemsSource="{Binding ConditionOptions}"
                                          SelectedItem="{Binding NewRuleCondition}"
                                          MinHeight="{StaticResource InputHeight}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="3" Spacing="{StaticResource TinySpacing}">
                                <TextBlock Text="{Binding TargetLabelText}" Classes="form-label"/>
                                <TextBox Text="{Binding NewRuleTargetValue}"
                                         PlaceholderText="{Binding TargetPlaceholderText}"
                                         MinHeight="{StaticResource InputHeight}"
                                         IsEnabled="{Binding HasTargetValue}"/>
                            </StackPanel>

                            <!-- 指标类规则才出现的 K 线周期：换到第二行首列，避免挤压上面四个常用字段 -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="{StaticResource TinySpacing}"
                                        IsVisible="{Binding IsIndicatorRuleSelected}">
                                <TextBlock Text="K线周期" Classes="form-label"/>
                                <ComboBox ItemsSource="{Binding KLinePeriodOptions}"
                                          SelectedItem="{Binding NewRuleKLineType}"
                                          MinHeight="{StaticResource InputHeight}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- 选项与提交：复选框在左、主按钮在右，与字段同一基线 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <CheckBox Grid.Column="0"
                                      Content="仅提醒一次"
                                      IsChecked="{Binding NewRuleIsOneTime}"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="触发一次后自动停用；可手动重新启用。默认持续告警，离开目标区间后自动复位。"/>
                            <Button Grid.Column="1"
                                    Content="创建告警"
                                    Command="{Binding AddRuleCommand}"
                                    Classes="btn-primary"
                                    MinWidth="{StaticResource MediumButtonMinWidth}"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="{Binding ValidationError}"
                                   Classes="form-error"
                                   IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- 高级选项：卡片内嵌手风琴用裸 Expander（同 StrategyConfigView 的「高级参数」）。
                             section-card 是页面级分组壳，套进卡片会与父卡同色、只剩一圈无效圆角。 -->
                        <Expander HorizontalAlignment="Stretch"
                                  IsExpanded="{Binding IsAdvancedOptionsExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <TextBlock Text="高级选项（去抖确认 / 冷却 / 触发次数 / 交易联动）" Classes="form-label"/>
                            </Expander.Header>
                            <StackPanel Spacing="{StaticResource DefaultSpacing}"
                                        Margin="{StaticResource ExpanderContentPadding}">
                                <Grid ColumnDefinitions="*,*,*,*"
                                      ColumnSpacing="{StaticResource GridGutter}">
                                    <StackPanel Grid.Column="0" Spacing="{StaticResource TinySpacing}">
                                        <TextBlock Text="去抖确认（连续行情次数）" Classes="form-label"/>
                                        <NumericUpDown Value="{Binding NewRuleConfirmTicks, Mode=TwoWay}"
                                                       Minimum="0"
                                                       Maximum="100"
                                                       Increment="1"
                                                       ShowButtonSpinner="False"
                                                       HorizontalAlignment="Stretch"
                                                       ToolTip.Tip="条件需连续满足指定行情次数才触发，0 表示立即触发"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="{StaticResource TinySpacing}">
                                        <TextBlock Text="冷却时间（分钟）" Classes="form-label"/>
                                        <NumericUpDown Value="{Binding NewRuleCooldownMinutes, Mode=TwoWay}"
                                                       Minimum="0"
                                                       Maximum="1440"
                                                       Increment="5"
                                                       ShowButtonSpinner="False"
                                                       HorizontalAlignment="Stretch"
                                                       ToolTip.Tip="两次触发之间的最小间隔，0 表示不冷却"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="{StaticResource TinySpacing}">
                                        <TextBlock Text="最大触发次数" Classes="form-label"/>
                                        <NumericUpDown Value="{Binding NewRuleMaxTriggerCount, Mode=TwoWay}"
                                                       Minimum="0"
                                                       Maximum="1000"
                                                       Increment="1"
                                                       ShowButtonSpinner="False"
                                                       HorizontalAlignment="Stretch"
                                                       ToolTip.Tip="达到次数后规则不再触发，0 表示不限；勾选“仅提醒一次”时恒为 1 次"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Spacing="{StaticResource TinySpacing}">
                                        <TextBlock Text="去抖持续（秒）" Classes="form-label"/>
                                        <NumericUpDown Value="{Binding NewRuleConfirmSeconds, Mode=TwoWay}"
                                                       Minimum="0"
                                                       Maximum="600"
                                                       Increment="5"
                                                       ShowButtonSpinner="False"
                                                       HorizontalAlignment="Stretch"
                                                       ToolTip.Tip="条件需持续满足的秒数，与连续次数同时配置时取更严判定；0 表示不限制"/>
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="确认级告警：触发期间该标的的 AI 交易信号强制人工确认（条件离开告警区间后自动解除）"
                                          IsChecked="{Binding NewRuleRequireConfirmation}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander>

                        <Border Background="{DynamicResource WarningPanelBackgroundBrush}"
                                CornerRadius="{StaticResource SmallCornerRadius}"
                                Padding="{StaticResource SmallCardPadding}"
                                IsVisible="{Binding !IsNotificationEnabled}">
                            <TextBlock Text="桌面通知已关闭：告警触发状态仍会记录，但不会显示弹窗。请在“设置 → 通知设置”中开启通知。"
                                       FontSize="{StaticResource CaptionFontSize}"
                                       Foreground="{DynamicResource WarningPanelTextBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1"
                      ColumnDefinitions="*,Auto,Auto"
                      Margin="{StaticResource SmallBottomMargin}">
                    <StackPanel Grid.Column="0" Spacing="{StaticResource CompactSpacing}">
                        <TextBlock Text="告警规则" Classes="card-title"/>
                        <TextBlock Text="浮动值 = 当前告警值 - 实际阈值（跌幅目标 3% 的实际阈值为 -3%）"
                                   Classes="caption"/>
                    </StackPanel>
                    <!-- 刷新：列表自身的操作，放在列表标题行比页面级页头更贴近语义 -->
                    <Button Grid.Column="1"
                            Content="刷新"
                            Command="{Binding RefreshCommand}"
                            Classes="btn-secondary btn-sm"
                            VerticalAlignment="Center"
                            Margin="{StaticResource SmallRightMargin}"/>
                    <Border Grid.Column="2"
                            Background="{DynamicResource SurfaceVariantBrush}"
                            CornerRadius="{StaticResource TinyCornerRadius}"
                            Padding="{StaticResource TagPadding}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Rules.Count, StringFormat='{}{0} 条'}"
                                   Classes="caption"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <!-- 首屏骨架：5 条规则卡的结构克隆（同列宽、同内边距、同开关与删除按钮尺寸） -->
                    <controls:SkeletonList Count="5"
                                           Spacing="{StaticResource SmallSpacing}"
                                           IsVisible="{Binding IsInitialLoading}">
                        <controls:SkeletonList.ItemTemplate>
                            <DataTemplate>
                                <controls:SkeletonCard Variant="Row"
                                                       Background="{DynamicResource ItemBackgroundBrush}"
                                                       CornerRadius="{StaticResource CardCornerRadius}"
                                                       Padding="{StaticResource DefaultPadding}">
                                    <Grid ColumnDefinitions="2*,1.2*,1.2*,1.6*,Auto,Auto"
                                          ColumnSpacing="{StaticResource DefaultSpacing}">
                                        <StackPanel Grid.Column="0" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                                            <controls:SkeletonLines Row="BodySm" LineCount="1" LineWidths="104"/>
                                            <controls:SkeletonLines Row="Caption" LineCount="1" LineWidths="132"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                                            <controls:SkeletonLines Row="Caption" LineCount="1" LineWidths="48"/>
                                            <controls:SkeletonLines Row="BodySm" LineCount="1" LineWidths="72"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                                            <controls:SkeletonLines Row="Caption" LineCount="1" LineWidths="48"/>
                                            <controls:SkeletonLines Row="BodySm" LineCount="1" LineWidths="60"/>
                                            <controls:SkeletonLines Row="Caption" LineCount="1" LineWidths="44"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                                            <controls:SkeletonLines Row="Caption" LineCount="1" LineWidths="60"/>
                                            <controls:SkeletonLines Row="Body" LineCount="1" LineWidths="66"/>
                                            <controls:SkeletonLines Row="Caption" LineCount="1" LineWidths="56"/>
                                        </StackPanel>
                                        <!-- 开关与删除按钮：与真实控件同尺寸 -->
                                        <Border Grid.Column="4"
                                                Classes="skeleton"
                                                Width="40" Height="20"
                                                CornerRadius="10"
                                                VerticalAlignment="Center"/>
                                        <Border Grid.Column="5"
                                                Classes="skeleton skeleton-circle"
                                                Width="{StaticResource SmallIconButtonSize}"
                                                Height="{StaticResource SmallIconButtonSize}"
                                                CornerRadius="{StaticResource SmallCornerRadius}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </controls:SkeletonCard>
                            </DataTemplate>
                        </controls:SkeletonList.ItemTemplate>
                    </controls:SkeletonList>

                    <ItemsControl ItemsSource="{Binding Rules}"
                                  IsVisible="{Binding !IsInitialLoading}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{StaticResource SmallSpacing}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="alert:PriceAlertRule">
                                <Border Background="{DynamicResource ItemBackgroundBrush}"
                                        BorderThickness="{StaticResource NoBorderThickness}"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        Padding="{StaticResource DefaultPadding}">
                                    <Grid ColumnDefinitions="2*,1.2*,1.2*,1.6*,Auto,Auto"
                                          ColumnSpacing="{StaticResource DefaultSpacing}">
                                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SmallSpacing}">
                                            <Ellipse Grid.Column="0"
                                                     Classes="rule-dot"
                                                     Classes.disabled="{Binding !Enabled}"
                                                     Classes.triggered="{Binding Triggered}"
                                                     Width="{StaticResource DotIconSize}"
                                                     Height="{StaticResource DotIconSize}"
                                                     VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AssetName}" Classes="body-sm"
                                                           FontWeight="{DynamicResource WeightTitle}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="{StaticResource TinySpacing}"
                                                            Margin="{StaticResource TinyTopMargin}">
                                                    <TextBlock Text="{Binding AssetCode}" Classes="caption"/>
                                                    <Border Classes="rule-tag">
                                                        <TextBlock Text="{Binding MarketType, Converter={StaticResource EnumDescriptionConverter}}"/>
                                                    </Border>
                                                    <Border Classes="rule-tag warning" IsVisible="{Binding IsOneTime}">
                                                        <TextBlock Text="一次性"/>
                                                    </Border>
                                                    <Border Classes="rule-tag" IsVisible="{Binding !IsOneTime}">
                                                        <TextBlock Text="持续"/>
                                                    </Border>
                                                    <Border Classes="rule-tag warning" IsVisible="{Binding Triggered}">
                                                        <TextBlock Text="已触发"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                                            <TextBlock Text="告警条件" Classes="caption"/>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{StaticResource TinySpacing}"
                                                        IsVisible="{Binding Condition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static alert:AlertCondition.PriceAbove}}">
                                                <TextBlock Text="↑ 涨破" FontWeight="{DynamicResource WeightTitle}" Foreground="{StaticResource BullishBrush}"/>
                                                <TextBlock Text="{Binding TargetPrice, StringFormat='{}{0:N2}'}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontWeight="{DynamicResource WeightTitle}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{StaticResource TinySpacing}"
                                                        IsVisible="{Binding Condition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static alert:AlertCondition.PriceBelow}}">
                                                <TextBlock Text="↓ 跌破" FontWeight="{DynamicResource WeightTitle}" Foreground="{StaticResource BearishBrush}"/>
                                                <TextBlock Text="{Binding TargetPrice, StringFormat='{}{0:N2}'}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontWeight="{DynamicResource WeightTitle}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{StaticResource TinySpacing}"
                                                        IsVisible="{Binding Condition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static alert:AlertCondition.ChangePercentAbove}}">
                                                <TextBlock Text="↑ 涨幅超" FontWeight="{DynamicResource WeightTitle}" Foreground="{StaticResource BullishBrush}"/>
                                                <TextBlock Text="{Binding TargetPrice, StringFormat='{}{0:N2}%'}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontWeight="{DynamicResource WeightTitle}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="{StaticResource TinySpacing}"
                                                        IsVisible="{Binding Condition, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static alert:AlertCondition.ChangePercentBelow}}">
                                                <TextBlock Text="↓ 跌幅超" FontWeight="{DynamicResource WeightTitle}" Foreground="{StaticResource BearishBrush}"/>
                                                <TextBlock Text="{Binding TargetPrice, StringFormat='{}{0:N2}%'}"
                                                           FontFamily="{StaticResource DataFontFamily}"
                                                           FontWeight="{DynamicResource WeightTitle}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding RuleOptionsText}"
                                                       Classes="caption"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding RuleOptionsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                                            <TextBlock Text="实时价格" Classes="caption"/>
                                            <TextBlock Text="{Binding CurrentPriceText}"
                                                       FontFamily="{StaticResource DataFontFamily}"
                                                       FontSize="{StaticResource BodySmFontSize}"
                                                       FontWeight="{DynamicResource WeightTitle}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding QuoteDisplayValue}"
                                                       Classes="caption"
                                                       Foreground="{Binding CurrentChangePercent, Converter={StaticResource PriceChangeColorConverter}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Spacing="{StaticResource TinySpacing}" VerticalAlignment="Center">
                                            <TextBlock Text="当前浮动值" Classes="caption"/>
                                            <TextBlock Text="{Binding FloatingValueText}"
                                                       FontFamily="{StaticResource DataFontFamily}"
                                                       FontSize="{StaticResource BodyFontSize}"
                                                       FontWeight="{DynamicResource WeightTitle}"
                                                       Foreground="{Binding FloatingValue, Converter={StaticResource PriceChangeColorConverter}}"/>
                                            <TextBlock Text="{Binding QuoteStatusText}" Classes="caption"/>
                                        </StackPanel>

                                        <!-- 行容器是 ItemsControl + Border（无整行选中），开关可直接放行内 -->
                                        <ToggleSwitch Grid.Column="4"
                                                      Width="48"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      Command="{Binding $parent[UserControl].((vm:PriceAlertPageViewModel)DataContext).ToggleRuleCommand}"
                                                      CommandParameter="{Binding Id}"
                                                      ToolTip.Tip="{Binding StatusText}"/>

                                        <Button Grid.Column="5"
                                                Classes="btn-icon-sm"
                                                Command="{Binding $parent[UserControl].((vm:PriceAlertPageViewModel)DataContext).RemoveRuleCommand}"
                                                CommandParameter="{Binding Id}"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="删除">
                                            <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                                      Width="{StaticResource TinyIconSize}"
                                                      Height="{StaticResource TinyIconSize}"
                                                      Foreground="{DynamicResource ErrorBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空态 / 失败态（含重试入口） -->
                    <controls:StateOverlayView State="{Binding OverlayState}"
                                               Message="{Binding OverlayMessage}"
                                               RetryCommand="{Binding RetryCommand}"
                                               RetryText="重新加载"
                                               ShowLoading="False"/>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ===== 告警历史 ===== -->
        <views:AlertHistoryView Grid.Row="1"
                                DataContext="{Binding AlertHistory}"
                                IsVisible="{Binding $parent[UserControl].((vm:PriceAlertPageViewModel)DataContext).IsHistoryTabSelected}"/>
    </Grid>
</UserControl>
