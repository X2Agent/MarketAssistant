<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 品牌主色调 - 采用专业金融蓝 -->
    <Color x:Key="Primary">#1976D2</Color>
    <Color x:Key="PrimaryDark">#0D47A1</Color>
    <Color x:Key="PrimaryLight">#42A5F5</Color>
    <Color x:Key="Secondary">#424242</Color>
    <Color x:Key="SecondaryLight">#616161</Color>
    <Color x:Key="Accent">#FF6B35</Color>

    <!-- 功能性颜色 - 对齐设计系统 v2.2（Tailwind 语义色） -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Error">#EF4444</Color>
    <Color x:Key="Info">#3B82F6</Color>

    <!-- 功能色按钮交互状态 - 悬停(变浅)与按下(变深) -->
    <Color x:Key="SuccessHover">#34D399</Color>
    <Color x:Key="SuccessPressed">#059669</Color>
    <Color x:Key="WarningHover">#FBBF24</Color>
    <Color x:Key="WarningPressed">#D97706</Color>
    <Color x:Key="InfoHover">#60A5FA</Color>
    <Color x:Key="InfoPressed">#2563EB</Color>
    
    <!-- 股票涨跌颜色 - 中国市场标准（红涨绿跌） -->
    <Color x:Key="BullishRed">#F44336</Color>
    <Color x:Key="BearishGreen">#4CAF50</Color>

    <!-- 涨跌标签背景 - 约 12% 透明度色块（设计系统 v2.1 裁决第 4 条：靠色块而非纯文字色区分语义） -->
    <SolidColorBrush x:Key="BullishTagBackgroundBrush" Color="#1FF44336"/>
    <SolidColorBrush x:Key="BearishTagBackgroundBrush" Color="#1F4CAF50"/>
    <SolidColorBrush x:Key="NeutralTagBackgroundBrush" Color="#149E9E9E"/>

    <!-- 中性色系 - 用于灰色状态 -->
    <Color x:Key="Neutral">#9E9E9E</Color>

    <!-- 主题变体颜色 - 支持亮色/暗色主题 -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key='Light'>
            <!-- 背景层级 - 对齐设计系统 v2 -->
            <SolidColorBrush x:Key='PageBackgroundBrush'>#F5F6F8</SolidColorBrush>
            <SolidColorBrush x:Key='CardBackgroundBrush'>#FFFFFF</SolidColorBrush>
            <!-- 列表项背景 - 统一使用白色卡片背景，去除灰色底 -->
            <SolidColorBrush x:Key='ItemBackgroundBrush'>#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key='SurfaceVariantBrush'>#F0F1F3</SolidColorBrush>
            
            <!-- 文本颜色 - 增强对比度（对齐设计系统 v2.2） -->
            <SolidColorBrush x:Key='TextPrimaryBrush'>#1A1D26</SolidColorBrush>
            <SolidColorBrush x:Key='TextSecondaryBrush'>#6B7280</SolidColorBrush>
            <SolidColorBrush x:Key='TextDisabledBrush'>#9CA3AF</SolidColorBrush>
            
            <!-- 边框和分割线 - 更清晰的层次 -->
            <SolidColorBrush x:Key='BorderBrush'>#E0E2E8</SolidColorBrush>
            <SolidColorBrush x:Key='SubtleBorderBrush'>#EEF0F4</SolidColorBrush>
            <SolidColorBrush x:Key='DividerBrush'>#EEF0F4</SolidColorBrush>
            
            <!-- 交互状态 - 选中态使用品牌蓝 15% 填充（bg-selected） -->
            <SolidColorBrush x:Key='HoverBackgroundBrush'>#F5F5F5</SolidColorBrush>
            <SolidColorBrush x:Key='PressedBackgroundBrush'>#EEEEEE</SolidColorBrush>
            <SolidColorBrush x:Key='SelectedBackgroundBrush'>#261976D2</SolidColorBrush>
    <SolidColorBrush x:Key='ModeCardSelectedTextBrush'>#0D47A1</SolidColorBrush>
            
            <!-- 阴影颜色 -->
            <SolidColorBrush x:Key='ShadowBrush'>#40000000</SolidColorBrush>
            
            <!-- 语义化容器背景 -->
            <SolidColorBrush x:Key='DangerBackgroundBrush'>#FEF2F2</SolidColorBrush>

            <!-- 语义面板（提示/建议/亮点风险区块） -->
            <SolidColorBrush x:Key='SuccessPanelBackgroundBrush'>#ECFDF5</SolidColorBrush>
            <SolidColorBrush x:Key='SuccessPanelBorderBrush'>#10B981</SolidColorBrush>
            <SolidColorBrush x:Key='SuccessPanelTextBrush'>#065F46</SolidColorBrush>
            <SolidColorBrush x:Key='WarningPanelBackgroundBrush'>#FFFBEB</SolidColorBrush>
            <SolidColorBrush x:Key='WarningPanelBorderBrush'>#F59E0B</SolidColorBrush>
            <SolidColorBrush x:Key='WarningPanelTextBrush'>#92400E</SolidColorBrush>
            <SolidColorBrush x:Key='InfoPanelBackgroundBrush'>#F0F9FF</SolidColorBrush>
            <SolidColorBrush x:Key='InfoPanelBorderBrush'>#3B82F6</SolidColorBrush>
            <SolidColorBrush x:Key='InfoPanelTextBrush'>#1E40AF</SolidColorBrush>
            <SolidColorBrush x:Key='DangerPanelBackgroundBrush'>#FEE2E2</SolidColorBrush>
            <SolidColorBrush x:Key='DangerPanelBorderBrush'>#EF4444</SolidColorBrush>
            <SolidColorBrush x:Key='DangerPanelTextBrush'>#991B1B</SolidColorBrush>

            <!-- 聚焦/激活边框（border-active）与 Danger 面板强化档（按钮 hover） -->
            <SolidColorBrush x:Key='BorderActiveBrush'>#1976D2</SolidColorBrush>
            <SolidColorBrush x:Key='DangerPanelBackgroundStrongBrush'>#FEE2E2</SolidColorBrush>
        </ResourceDictionary>
        
        <ResourceDictionary x:Key='Dark'>
            <!-- 背景层级 - 蓝调深色四层体系（对齐设计系统 v2） -->
            <SolidColorBrush x:Key='PageBackgroundBrush'>#0A0E17</SolidColorBrush>
            <SolidColorBrush x:Key='CardBackgroundBrush'>#111722</SolidColorBrush>
            <!-- 列表项背景 - 与卡片背景保持一致 -->
            <SolidColorBrush x:Key='ItemBackgroundBrush'>#111722</SolidColorBrush>
            <SolidColorBrush x:Key='SurfaceVariantBrush'>#1B2233</SolidColorBrush>
            
            <!-- 文本颜色 - 减轻长时间盯盘眩光 -->
            <SolidColorBrush x:Key='TextPrimaryBrush'>#E4EAF5</SolidColorBrush>
            <SolidColorBrush x:Key='TextSecondaryBrush'>#8894A8</SolidColorBrush>
            <SolidColorBrush x:Key='TextDisabledBrush'>#5A6680</SolidColorBrush>
            
            <!-- 边框和分割线 -->
            <SolidColorBrush x:Key='BorderBrush'>#1E2636</SolidColorBrush>
            <SolidColorBrush x:Key='DividerBrush'>#182032</SolidColorBrush>
            
            <!-- 交互状态 - 选中态使用品牌蓝 15% 填充（bg-selected，对齐设计系统 v2.2） -->
            <SolidColorBrush x:Key='HoverBackgroundBrush'>#161C2A</SolidColorBrush>
            <SolidColorBrush x:Key='PressedBackgroundBrush'>#1B2233</SolidColorBrush>
            <SolidColorBrush x:Key='SelectedBackgroundBrush'>#261976D2</SolidColorBrush>
            <SolidColorBrush x:Key='ModeCardSelectedTextBrush'>#42A5F5</SolidColorBrush>
            
            <!-- 阴影颜色 -->
            <SolidColorBrush x:Key='ShadowBrush'>#80000000</SolidColorBrush>
            
            <!-- 语义化容器背景 -->
            <SolidColorBrush x:Key='DangerBackgroundBrush'>#2D1B1B</SolidColorBrush>

            <!-- 语义面板：暗色下使用低透明度色块 + 高亮文字 -->
            <SolidColorBrush x:Key='SuccessPanelBackgroundBrush'>#1E10B981</SolidColorBrush>
            <SolidColorBrush x:Key='SuccessPanelBorderBrush'>#10B981</SolidColorBrush>
            <SolidColorBrush x:Key='SuccessPanelTextBrush'>#34D399</SolidColorBrush>
            <SolidColorBrush x:Key='WarningPanelBackgroundBrush'>#1EF59E0B</SolidColorBrush>
            <SolidColorBrush x:Key='WarningPanelBorderBrush'>#F59E0B</SolidColorBrush>
            <SolidColorBrush x:Key='WarningPanelTextBrush'>#FBBF24</SolidColorBrush>
            <SolidColorBrush x:Key='InfoPanelBackgroundBrush'>#1E3B82F6</SolidColorBrush>
            <SolidColorBrush x:Key='InfoPanelBorderBrush'>#3B82F6</SolidColorBrush>
            <SolidColorBrush x:Key='InfoPanelTextBrush'>#93C5FD</SolidColorBrush>
            <SolidColorBrush x:Key='DangerPanelBackgroundBrush'>#1EEF4444</SolidColorBrush>
            <SolidColorBrush x:Key='DangerPanelBorderBrush'>#EF4444</SolidColorBrush>
            <SolidColorBrush x:Key='BorderActiveBrush'>#42A5F5</SolidColorBrush>
            <SolidColorBrush x:Key='DangerPanelBackgroundStrongBrush'>#2EEF4444</SolidColorBrush>
            <SolidColorBrush x:Key='DangerPanelTextBrush'>#FCA5A5</SolidColorBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 品牌色画刷 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource SecondaryLight}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>

    <!-- 功能性画刷 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>

    <!-- 功能色按钮交互状态画刷 -->
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="{StaticResource SuccessHover}"/>
    <SolidColorBrush x:Key="SuccessPressedBrush" Color="{StaticResource SuccessPressed}"/>
    <SolidColorBrush x:Key="WarningHoverBrush" Color="{StaticResource WarningHover}"/>
    <SolidColorBrush x:Key="WarningPressedBrush" Color="{StaticResource WarningPressed}"/>
    <SolidColorBrush x:Key="InfoHoverBrush" Color="{StaticResource InfoHover}"/>
    <SolidColorBrush x:Key="InfoPressedBrush" Color="{StaticResource InfoPressed}"/>
    
    <!-- 股票专用画刷 - 语义化命名 -->
    <SolidColorBrush x:Key="BullishBrush" Color="{StaticResource BullishRed}"/>
    <SolidColorBrush x:Key="BearishBrush" Color="{StaticResource BearishGreen}"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource Neutral}"/>
    
    <!-- 向后兼容的别名 - 逐步迁移 -->
    <SolidColorBrush x:Key="UpColorBrush" Color="{StaticResource BullishRed}"/>
    <SolidColorBrush x:Key="DownColorBrush" Color="{StaticResource BearishGreen}"/>

    <!-- ========== 半透明背景色 ========== -->
    <SolidColorBrush x:Key="DarkOverlayBrush" Color="#80000000"/>
    <SolidColorBrush x:Key="LightOverlayBrush" Color="#40FFFFFF"/>

    <!-- ========== 强调底色上的前景文字（on-color） ========== -->
    <!-- 用于品牌蓝/功能色实底上的白字（按钮、徽章、头像、涨跌标签等），明暗主题同值 -->
    <SolidColorBrush x:Key="TextOnEmphasisBrush" Color="#FFFFFF"/>
    
    <!-- ========== 通知窗口专用颜色 - 蓝调深色体系（对齐设计系统 v2.2） ========== -->
    <Color x:Key="NotificationDarkBackground">#161C2A</Color>
    <Color x:Key="NotificationDarkBorder">#1E2636</Color>
    <Color x:Key="NotificationDarkHover">#1B2233</Color>
    <Color x:Key="NotificationDarkPressed">#20293D</Color>
    <Color x:Key="NotificationIconSuccess">#10B981</Color>
    <Color x:Key="NotificationTextLight">#FFFFFF</Color>
    <Color x:Key="NotificationTextSecondary">#8894A8</Color>
    <Color x:Key="NotificationShadow">#60000000</Color>
    
    <SolidColorBrush x:Key="NotificationDarkBackgroundBrush" Color="{StaticResource NotificationDarkBackground}"/>
    <SolidColorBrush x:Key="NotificationDarkBorderBrush" Color="{StaticResource NotificationDarkBorder}"/>
    <SolidColorBrush x:Key="NotificationDarkHoverBrush" Color="{StaticResource NotificationDarkHover}"/>
    <SolidColorBrush x:Key="NotificationDarkPressedBrush" Color="{StaticResource NotificationDarkPressed}"/>
    <SolidColorBrush x:Key="NotificationIconSuccessBrush" Color="{StaticResource NotificationIconSuccess}"/>
    <SolidColorBrush x:Key="NotificationTextLightBrush" Color="{StaticResource NotificationTextLight}"/>
    <SolidColorBrush x:Key="NotificationTextSecondaryBrush" Color="{StaticResource NotificationTextSecondary}"/>
    
    <!-- ========== 阴影定义 ========== -->
    <BoxShadows x:Key="NotificationBoxShadow">0 4 16 0 #60000000</BoxShadows>
    <BoxShadows x:Key="ElevatedBoxShadow">0 8 32 0 #30000000</BoxShadows>
    <BoxShadows x:Key="CardBoxShadow">0 2 8 0 #15000000</BoxShadows>
    <BoxShadows x:Key="SubtleBoxShadow">0 2 8 0 #10000000</BoxShadows>
    <BoxShadows x:Key="SmallBoxShadow">0 1 3 0 #20000000</BoxShadows>
    <BoxShadows x:Key="SidebarBoxShadow">-4 0 16 0 #40000000</BoxShadows>
    <BoxShadows x:Key="InputAreaBoxShadow">0 -2 8 0 #08000000</BoxShadows>
    <BoxShadows x:Key="UserBubbleBoxShadow">0 2 4 0 #301976D2</BoxShadows>
    

</ResourceDictionary>
