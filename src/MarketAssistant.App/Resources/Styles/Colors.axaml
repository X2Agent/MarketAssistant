<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================== -->
    <!-- MarketAssistant Design System v3.0 — Color Tokens                    -->
    <!--                                                                     -->
    <!-- 三条硬规则（改动前请先读）：                                          -->
    <!--  1. 只有一个交互强调色 Accent。其余一切后退为中性灰。                  -->
    <!--     语义色（涨/跌/警告/危险）只表达数据语义，禁止用于装饰、图标底色。   -->
    <!--  2. 不画边框。层次靠表面色阶（1%–3% 微对比）+ 阴影，不靠 1px 描边。    -->
    <!--  3. 明暗两套中性阶各自独立取色（暗色用纯中性，不用蓝调），              -->
    <!--     主题感知资源一律 DynamicResource 引用，StaticResource 不会随主题刷新。 -->
    <!-- ================================================================== -->

    <!-- ========== 唯一强调色 ========== -->
    <!-- 交互语义：主按钮、选中态、链接、焦点环、进度。 -->
    <Color x:Key="AccentColor">#0066FF</Color>
    <Color x:Key="AccentHoverColor">#0052CC</Color>
    <Color x:Key="AccentPressedColor">#0040A3</Color>

    <!-- ========== 语义色（只用于数据与状态，不参与装饰） ========== -->
    <!-- A 股/中国用户默认红涨绿跌；数值正负、买卖方向、成败提示复用同一语义。 -->
    <Color x:Key="BullishRed">#E5484D</Color>
    <Color x:Key="BearishGreen">#16A34A</Color>
    <Color x:Key="Neutral">#8A93A0</Color>

    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="Warning">#D97706</Color>
    <!-- Error 没有全局 Color：错误色明暗两套取值不同（暗色需提亮），
         统一在 ThemeDictionaries 里以 ErrorBrush 提供，避免这里放一个"看起来能用"的值。 -->

    <!-- ========== 涨跌标签底色（约 12% 透明度色块，靠色块而非纯文字色区分语义） ========== -->
    <SolidColorBrush x:Key="BullishTagBackgroundBrush" Color="#1FE5484D"/>
    <SolidColorBrush x:Key="BearishTagBackgroundBrush" Color="#1F16A34A"/>
    <SolidColorBrush x:Key="NeutralTagBackgroundBrush" Color="#148A93A0"/>
    <!-- 状态标签（一次性 / 已触发）：12% 警告色底 + 警告色字。
         语义色只出现在这类小面积标签上，不做实底块。 -->
    <SolidColorBrush x:Key="WarningTagBackgroundBrush" Color="#1FD97706"/>
    <SolidColorBrush x:Key="DangerTagBackgroundBrush" Color="#1FDC2626"/>
    <!-- 低风险等“正向状态”标签：与 BearishTagBackgroundBrush 同色值但语义不同——
         后者表达“价格下跌”，不能拿来标“安全/成功” -->
    <SolidColorBrush x:Key="SuccessTagBackgroundBrush" Color="#1F16A34A"/>
    <!-- 提示 / 模拟环境等中性说明标签：12% 强调色底，字色用 InfoPanelTextBrush。
         与 SelectedBackgroundBrush 区分——后者只表达“选中”。 -->
    <SolidColorBrush x:Key="InfoTagBackgroundBrush" Color="#1F0066FF"/>

    <!-- ================================================================== -->
    <!-- 主题色阶：Light / Dark                                              -->
    <!--                                                                     -->
    <!-- 表面层级（浅色）：Page #F5F7FA → Card #FFFFFF → Sunken #EEF0F3       -->
    <!-- 表面层级（暗色）：Page #0D0D0D → Card #161616 → Sunken #101010      -->
    <!--                   → Raised #1C1C1C（下拉/弹窗等真正浮起的层）        -->
    <!-- 相邻层色差只有 1%–3%，这正是"不画边框也能分层"的来源。                -->
    <!-- ================================================================== -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <!-- 表面色阶 -->
            <SolidColorBrush x:Key="PageBackgroundBrush">#F5F7FA</SolidColorBrush>
            <SolidColorBrush x:Key="CardBackgroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ItemBackgroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceVariantBrush">#F0F2F5</SolidColorBrush>
            <SolidColorBrush x:Key="SunkenBackgroundBrush">#EEF0F3</SolidColorBrush>
            <!-- 骨架灰条：浅色与 SurfaceVariant 同值 -->
            <SolidColorBrush x:Key="SkeletonBrush">#F0F2F5</SolidColorBrush>

            <!-- 文字三档：主 / 次 / 弱。纯黑仅出现在主文字上。 -->
            <SolidColorBrush x:Key="TextPrimaryBrush">#14161A</SolidColorBrush>
            <SolidColorBrush x:Key="TextSecondaryBrush">#5C6470</SolidColorBrush>
            <SolidColorBrush x:Key="TextDisabledBrush">#8A93A0</SolidColorBrush>

            <!-- 分隔：默认不画边框，仅在表格行、分区之间用极浅色阶 -->
            <SolidColorBrush x:Key="BorderBrush">#E4E7ED</SolidColorBrush>
            <SolidColorBrush x:Key="SubtleBorderBrush">#EEF0F3</SolidColorBrush>
            <SolidColorBrush x:Key="DividerBrush">#E4E7ED</SolidColorBrush>

            <!-- 交互态：hover 只加深色阶，不放大、不加亮线 -->
            <SolidColorBrush x:Key="HoverBackgroundBrush">#F0F2F5</SolidColorBrush>
            <SolidColorBrush x:Key="PressedBackgroundBrush">#E6E9EE</SolidColorBrush>
            <SolidColorBrush x:Key="SelectedBackgroundBrush">#1A0066FF</SolidColorBrush>
            <SolidColorBrush x:Key="AccentSubtleBrush">#0F0066FF</SolidColorBrush>

            <!-- 语义面板：浅底 + 深字，不描边。
                 只有 Background 与 Text 两类：v3 不画边框，面板不需要 Border 色。 -->
            <SolidColorBrush x:Key="SuccessPanelBackgroundBrush">#F0FDF4</SolidColorBrush>
            <SolidColorBrush x:Key="SuccessPanelTextBrush">#14532D</SolidColorBrush>
            <SolidColorBrush x:Key="WarningPanelBackgroundBrush">#FFFBEB</SolidColorBrush>
            <SolidColorBrush x:Key="WarningPanelTextBrush">#92400E</SolidColorBrush>
            <SolidColorBrush x:Key="WarningBackgroundAltBrush">#FEF3C7</SolidColorBrush>
            <SolidColorBrush x:Key="InfoPanelBackgroundBrush">#EFF5FF</SolidColorBrush>
            <SolidColorBrush x:Key="InfoPanelTextBrush">#1E40AF</SolidColorBrush>
            <SolidColorBrush x:Key="DangerPanelBackgroundBrush">#FEF2F2</SolidColorBrush>
            <SolidColorBrush x:Key="DangerPanelTextBrush">#991B1B</SolidColorBrush>
            <SolidColorBrush x:Key="DangerPanelBackgroundStrongBrush">#FEE2E2</SolidColorBrush>
            <!-- 涨跌标签字色：BullishBrush / BearishBrush 压在自己的 12% 色底上只有 3.3 / 2.9，
                 12px 小字不达 AA，所以标签用同色相的深一档（浅色 5.0 / 6.2 以上，含次级面）。
                 数值与图标仍用 BullishBrush / BearishBrush，保持全局“红涨绿跌”色相不变。 -->
            <SolidColorBrush x:Key="BullishTagTextBrush">#BE2A30</SolidColorBrush>
            <SolidColorBrush x:Key="BearishTagTextBrush">#166534</SolidColorBrush>
            <!-- 错误色（浅色）：#DC2626 在白色卡片上对比度 4.83，达标 -->
            <SolidColorBrush x:Key="ErrorBrush">#DC2626</SolidColorBrush>

            <!-- 开关轨道（关）：需要比 BorderBrush 更明确，否则在白色卡片上读不出"这是个开关" -->
            <SolidColorBrush x:Key="SwitchTrackOffBrush">#DDE1E7</SolidColorBrush>
            <SolidColorBrush x:Key="SwitchTrackOffHoverBrush">#CED3DA</SolidColorBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- 表面色阶：纯中性灰，不用蓝调（暗色下蓝调会让中性面发脏） -->
            <SolidColorBrush x:Key="PageBackgroundBrush">#0D0D0D</SolidColorBrush>
            <SolidColorBrush x:Key="CardBackgroundBrush">#161616</SolidColorBrush>
            <SolidColorBrush x:Key="ItemBackgroundBrush">#161616</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceVariantBrush">#1C1C1C</SolidColorBrush>
            <SolidColorBrush x:Key="SunkenBackgroundBrush">#101010</SolidColorBrush>
            <!-- 骨架灰条：灰条带 0.55–0.95 的呼吸透明度，暗色下 SurfaceVariant(#1C1C1C) 与 #161616 卡片
                 只差 6 级、叠透明度后几乎消失，所以单独取更亮一档（#262626，与浅色同级的可见度） -->
            <SolidColorBrush x:Key="SkeletonBrush">#262626</SolidColorBrush>

            <!-- 文字不提纯白（#EDEDED 而非 #FFFFFF），配合字重降档避免暗底发粗刺眼 -->
            <SolidColorBrush x:Key="TextPrimaryBrush">#EDEDED</SolidColorBrush>
            <SolidColorBrush x:Key="TextSecondaryBrush">#A0A0A0</SolidColorBrush>
            <SolidColorBrush x:Key="TextDisabledBrush">#6E6E6E</SolidColorBrush>

            <SolidColorBrush x:Key="BorderBrush">#262626</SolidColorBrush>
            <SolidColorBrush x:Key="SubtleBorderBrush">#1F1F1F</SolidColorBrush>
            <SolidColorBrush x:Key="DividerBrush">#262626</SolidColorBrush>

            <SolidColorBrush x:Key="HoverBackgroundBrush">#1F1F1F</SolidColorBrush>
            <SolidColorBrush x:Key="PressedBackgroundBrush">#262626</SolidColorBrush>
            <SolidColorBrush x:Key="SelectedBackgroundBrush">#290066FF</SolidColorBrush>
            <SolidColorBrush x:Key="AccentSubtleBrush">#140066FF</SolidColorBrush>

            <!-- 暗色语义面板：低透明度色块 + 提亮文字，不描边 -->
            <SolidColorBrush x:Key="SuccessPanelBackgroundBrush">#14251A</SolidColorBrush>
            <SolidColorBrush x:Key="SuccessPanelTextBrush">#4ADE80</SolidColorBrush>
            <SolidColorBrush x:Key="WarningPanelBackgroundBrush">#2A1F0F</SolidColorBrush>
            <SolidColorBrush x:Key="WarningPanelTextBrush">#FBBF24</SolidColorBrush>
            <SolidColorBrush x:Key="WarningBackgroundAltBrush">#33260F</SolidColorBrush>
            <SolidColorBrush x:Key="InfoPanelBackgroundBrush">#101B2E</SolidColorBrush>
            <SolidColorBrush x:Key="InfoPanelTextBrush">#83B6FF</SolidColorBrush>
            <SolidColorBrush x:Key="DangerPanelBackgroundBrush">#2A1414</SolidColorBrush>
            <SolidColorBrush x:Key="DangerPanelTextBrush">#FCA5A5</SolidColorBrush>
            <SolidColorBrush x:Key="DangerPanelBackgroundStrongBrush">#3A1A1A</SolidColorBrush>
            <!-- 暗色涨跌标签字色：提亮同色相，压在 12% 色底上 ≥ 5.4（BullishBrush 原值仅 3.9–4.1） -->
            <SolidColorBrush x:Key="BullishTagTextBrush">#FF6B70</SolidColorBrush>
            <SolidColorBrush x:Key="BearishTagTextBrush">#3FCF6F</SolidColorBrush>
            <!-- 错误色（暗色）：#DC2626 在 #161616 卡片上仅 3.75，提亮到 #F87171 以满足正文 AA -->
            <SolidColorBrush x:Key="ErrorBrush">#F87171</SolidColorBrush>

            <!-- 开关轨道（关）：暗色下比 SurfaceVariant 再亮一档，才在 #161616 卡片上可见 -->
            <SolidColorBrush x:Key="SwitchTrackOffBrush">#3A3A3A</SolidColorBrush>
            <SolidColorBrush x:Key="SwitchTrackOffHoverBrush">#464646</SolidColorBrush>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ========== 强调色画刷 ========== -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>

    <!-- ========== 语义色画刷 ========== -->
    <SolidColorBrush x:Key="BullishBrush" Color="{StaticResource BullishRed}"/>
    <SolidColorBrush x:Key="BearishBrush" Color="{StaticResource BearishGreen}"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="{StaticResource Neutral}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>

    <!-- 错误色按主题取值：暗色下 #DC2626 在卡片上对比度仅 3.75（低于正文 AA 4.5），
         故暗色改用更亮的红 #F87171（实测 6.54）。定义在 ThemeDictionaries 中。 -->

    <!-- ========== 遮罩 ========== -->
    <SolidColorBrush x:Key="DarkOverlayBrush" Color="#80000000"/>

    <!-- 强调实底上的前景文字（按钮、徽章、涨跌标签），明暗同值 -->
    <SolidColorBrush x:Key="TextOnEmphasisBrush" Color="#FFFFFF"/>

    <!-- ========== 通知窗口（跟随暗色中性阶，去边框） ========== -->
    <Color x:Key="NotificationDarkBackground">#1C1C1C</Color>
    <Color x:Key="NotificationDarkHover">#262626</Color>
    <Color x:Key="NotificationDarkPressed">#303030</Color>
    <Color x:Key="NotificationTextLight">#EDEDED</Color>
    <Color x:Key="NotificationTextSecondary">#A0A0A0</Color>

    <SolidColorBrush x:Key="NotificationDarkBackgroundBrush" Color="{StaticResource NotificationDarkBackground}"/>
    <SolidColorBrush x:Key="NotificationDarkHoverBrush" Color="{StaticResource NotificationDarkHover}"/>
    <SolidColorBrush x:Key="NotificationDarkPressedBrush" Color="{StaticResource NotificationDarkPressed}"/>
    <SolidColorBrush x:Key="NotificationTextLightBrush" Color="{StaticResource NotificationTextLight}"/>
    <SolidColorBrush x:Key="NotificationTextSecondaryBrush" Color="{StaticResource NotificationTextSecondary}"/>

</ResourceDictionary>
