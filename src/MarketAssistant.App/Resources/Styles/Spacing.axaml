<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================== -->
    <!-- MarketAssistant Design System v3.0 — Spacing & Type Scale            -->
    <!--                                                                     -->
    <!-- 间距：4 的倍数，允许 16 / 20 / 24 三档呼吸（页面级用 24）。            -->
    <!-- 字号：全局只有 4 档。新增页面禁止再引入第 5 档。                       -->
    <!-- ================================================================== -->

    <!-- ========== 字号（唯一 4 档） ========== -->
    <!-- Display 32：大数字、资产现价、余额等"一眼要看到"的数值（等宽）          -->
    <!-- Title   24：页面标题、弹窗标题                                        -->
    <!-- Body    16：阅读型正文（聊天、报告、说明）                             -->
    <!-- BodySm  14：密集数据界面正文（表格、卡片、表单、按钮），主力字号         -->
    <!-- Caption 12：辅助说明、时间戳、单位、表头                              -->
    <x:Double x:Key="DisplayFontSize">32</x:Double>
    <x:Double x:Key="TitleFontSize">24</x:Double>
    <x:Double x:Key="BodyFontSize">16</x:Double>
    <x:Double x:Key="BodySmFontSize">14</x:Double>
    <x:Double x:Key="CaptionFontSize">12</x:Double>

    <!-- ========== 行高（与字号档位一一对应，均为 1.5 上下） ========== -->
    <x:Double x:Key="DisplayLineHeight">40</x:Double>
    <x:Double x:Key="TitleLineHeight">32</x:Double>
    <x:Double x:Key="BodyLineHeight">24</x:Double>
    <x:Double x:Key="BodySmLineHeight">21</x:Double>
    <x:Double x:Key="CaptionLineHeight">18</x:Double>

    <!-- 字号、字重见上方 5 个语义令牌（Display/Title/Body/BodySm/Caption）。 -->

    <!-- ================================================================== -->
    <!-- 字重：主题感知                                                       -->
    <!--                                                                     -->
    <!-- 暗色模式的文字天生显粗（浅色字在深底上会"溢出"），故暗色整体降一档：     -->
    <!--   Light: Title=SemiBold(600) Body=Normal(400) Emph=Medium(500)      -->
    <!--   Dark : Title=Medium(500)   Body=Normal(400) Emph=Normal(400)      -->
    <!-- 用这些键而不是硬写 FontWeight="{DynamicResource WeightTitle}"，才能自动跟随主题切换。           -->
    <!-- ================================================================== -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <FontWeight x:Key="WeightTitle">SemiBold</FontWeight>
            <FontWeight x:Key="WeightBody">Normal</FontWeight>
            <FontWeight x:Key="WeightEmphasis">Medium</FontWeight>
            <FontWeight x:Key="WeightNumber">SemiBold</FontWeight>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <FontWeight x:Key="WeightTitle">Medium</FontWeight>
            <FontWeight x:Key="WeightBody">Normal</FontWeight>
            <FontWeight x:Key="WeightEmphasis">Normal</FontWeight>
            <FontWeight x:Key="WeightNumber">Medium</FontWeight>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ========== 字体族 ========== -->
    <!-- Inter 无中文字形，必须显式给出中文回退链，否则中文会落到兜底字体导致字重与字面不一致。 -->
    <FontFamily x:Key="UiFontFamily">Inter, Microsoft YaHei UI, PingFang SC, Noto Sans SC, Source Han Sans SC, sans-serif</FontFamily>
    <!-- 等宽只留给数值（价格/涨跌/计数），禁止用于正文或代码块以外的场景 -->
    <FontFamily x:Key="DataFontFamily">JetBrains Mono, SF Mono, Consolas, Cascadia Mono, Menlo, monospace</FontFamily>

    <!-- ========== 圆角 ========== -->
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="DefaultCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="SmallCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="TinyCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="FABCornerRadius">28</CornerRadius>

    <!-- ========== 间距阶梯 ========== -->
    <!-- 语义令牌（Tiny/Small/Default/Large/Section）；不要再用 Space1..6 这类序号别名，
         两套并存会让同一间距出现两种写法。 -->
    <x:Double x:Key="TinySpacing">4</x:Double>
    <x:Double x:Key="CompactSpacing">4</x:Double>
    <x:Double x:Key="SmallSpacing">8</x:Double>
    <x:Double x:Key="DefaultSpacing">12</x:Double>
    <x:Double x:Key="LargeSpacing">16</x:Double>
    <x:Double x:Key="SectionSpacing">24</x:Double>

    <!-- ========== Padding ========== -->
    <!-- 页面统一 24；卡片 16–20；紧凑元素 8–12 -->
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="PagePaddingCompact">16</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="DefaultCardPadding">16</Thickness>
    <Thickness x:Key="CompactCardPadding">12</Thickness>
    <Thickness x:Key="SmallCardPadding">8</Thickness>
    <Thickness x:Key="TagPadding">6,2</Thickness>
    <Thickness x:Key="TinyPadding">4</Thickness>
    <Thickness x:Key="SmallPadding">8</Thickness>
    <Thickness x:Key="DefaultPadding">12</Thickness>
    <Thickness x:Key="NoPadding">0</Thickness>
    <Thickness x:Key="ListItemPadding">12,10</Thickness>
    <Thickness x:Key="SegmentButtonPadding">12,6</Thickness>
    <Thickness x:Key="ChipPadding">8,2</Thickness>
    <Thickness x:Key="CompactButtonPadding">12,4</Thickness>
    <Thickness x:Key="ProgressDialogPadding">32,24</Thickness>
    <Thickness x:Key="FABMargin">0,0,24,24</Thickness>
    <!-- 手风琴（Expander.section-card）内容内边距：壳本身不留边距，由页面用该令牌给内容留白 -->
    <Thickness x:Key="ExpanderContentPadding">20,16,20,20</Thickness>

    <!-- ========== Margin ========== -->
    <!-- 页面页头外边距：左右上 24、底部 0。与内容区自身的 PagePadding 顶边距合成
         24 区块间距；页头模板不再自带底部外边距，否则两处叠加成 36。 -->
    <Thickness x:Key="PageHeaderMargin">24,24,24,0</Thickness>
    <Thickness x:Key="DefaultMargin">12</Thickness>
    <Thickness x:Key="SmallMargin">8</Thickness>
    <Thickness x:Key="TinyMargin">4</Thickness>
    <Thickness x:Key="LargeMargin">24</Thickness>
    <Thickness x:Key="NoMargin">0</Thickness>
    <Thickness x:Key="DefaultVerticalMargin">0,12</Thickness>
    <Thickness x:Key="SmallCardGridMargin">0,0,8,8</Thickness>

    <!-- 自选卡片最小列宽：自适应网格按它决定列数，骨架屏共用同一令牌，
         避免两处各写一个字面量而漂移 -->
    <x:Double x:Key="FavCardWidth">300</x:Double>

    <!-- AI 选股结果卡最小列宽：卡内有四列指标（现价/目标价/止损价/预期收益）与两个操作按钮，
         窄于它会换行，所以只在宽窗口切到两列 -->
    <x:Double x:Key="SelectionCardWidth">440</x:Double>

    <Thickness x:Key="BottomMargin">0,0,0,12</Thickness>
    <Thickness x:Key="SmallBottomMargin">0,0,0,8</Thickness>
    <Thickness x:Key="TinyBottomMargin">0,0,0,4</Thickness>
    <Thickness x:Key="TopMargin">0,12,0,0</Thickness>
    <Thickness x:Key="SmallTopMargin">0,8,0,0</Thickness>
    <Thickness x:Key="TinyTopMargin">0,4,0,0</Thickness>
    <Thickness x:Key="RightMargin">0,0,12,0</Thickness>
    <Thickness x:Key="SmallRightMargin">0,0,8,0</Thickness>
    <Thickness x:Key="TinyRightMargin">0,0,4,0</Thickness>
    <Thickness x:Key="LeftMargin">12,0,0,0</Thickness>
    <Thickness x:Key="SmallLeftMargin">8,0,0,0</Thickness>
    <Thickness x:Key="TinyLeftMargin">4,0,0,0</Thickness>
    <Thickness x:Key="HorizontalMargin">16,0</Thickness>
    <Thickness x:Key="SmallHorizontalMargin">8,0</Thickness>
    <Thickness x:Key="TinyVerticalMargin">0,4</Thickness>
    <!-- 二级页面返回条：内容区顶部内嵌窄条，根页面折叠为零高度 -->
    <Thickness x:Key="BackBarMargin">24,8,24,0</Thickness>
    <Thickness x:Key="LogoTopMargin">0,24,0,0</Thickness>

    <!-- ========== 控件尺寸 ========== -->
    <x:Double x:Key="ButtonHeight">36</x:Double>
    <x:Double x:Key="SmallButtonHeight">30</x:Double>
    <x:Double x:Key="IconButtonSize">40</x:Double>
    <x:Double x:Key="SmallIconButtonSize">32</x:Double>
    <x:Double x:Key="TinyIconButtonSize">26</x:Double>

    <x:Double x:Key="InputHeight">40</x:Double>
    <x:Double x:Key="TextAreaHeight">150</x:Double>
    <x:Double x:Key="CompactTextAreaHeight">120</x:Double>
    <x:Double x:Key="ModeSelectionHeight">80</x:Double>

    <!-- ========== 边框厚度 ========== -->
    <!-- v3 只有一个：无边框。厚度为 1px 的底/顶分隔令牌也一并删除——
         全库已改用表面色阶分区，留着"给某块加一条线"的令牌只会被误用。
         DataGrid 的行间分隔由 GridLinesVisibility + SubtleBorderBrush 表达，不用厚度令牌。 -->
    <Thickness x:Key="NoBorderThickness">0</Thickness>

    <!-- ========== 图标 ========== -->
    <x:Double x:Key="LargeIconSize">48</x:Double>
    <x:Double x:Key="MediumIconSize">32</x:Double>
    <x:Double x:Key="DefaultIconSize">24</x:Double>
    <x:Double x:Key="SmallIconSize">20</x:Double>
    <x:Double x:Key="TinyIconSize">16</x:Double>
    <x:Double x:Key="MiniIconSize">14</x:Double>
    <x:Double x:Key="DotIconSize">6</x:Double>

    <!-- ========== 布局尺寸 ========== -->
    <x:Double x:Key="HeaderHeight">64</x:Double>
    <Thickness x:Key="FooterPadding">16</Thickness>
    <x:Double x:Key="DividerHeight">1</x:Double>
    <x:Double x:Key="ProgressBarHeight">6</x:Double>
    <x:Double x:Key="IndicatorSize">12</x:Double>
    <!-- 状态圆点：运行中/等待/完成/失败四态共用同一尺寸，外层容器用 IndicatorSize 留白居中 -->
    <x:Double x:Key="StatusDotSize">9</x:Double>

    <x:Double x:Key="MaxDialogWidth">560</x:Double>
    <x:Double x:Key="DialogCardWidth">440</x:Double>
    <x:Double x:Key="MaxChatBubbleWidth">760</x:Double>
    <x:Double x:Key="MaxInputHeight">160</x:Double>

    <!-- ========== 导航 ========== -->
    <!-- v3：240px 文字导航（图标 + 标签 + 分组标题），窄窗收敛为 72px 图标轨 -->
    <GridLength x:Key="NavRailWidth">240</GridLength>
    <GridLength x:Key="NavRailCollapsedWidth">72</GridLength>
    <x:Double x:Key="NavItemHeight">40</x:Double>
    <Thickness x:Key="NavHeaderPadding">20,20,20,0</Thickness>
    <Thickness x:Key="NavItemInnerMargin">12,0</Thickness>
    <Thickness x:Key="NavGroupMargin">12,16,12,6</Thickness>
    <Thickness x:Key="NavHolderPadding">12,20,12,0</Thickness>
    <Thickness x:Key="NavHolderCompactPadding">12,16,12,0</Thickness>
    <Thickness x:Key="NavFooterPadding">12,8,12,16</Thickness>

    <!-- ========== 栅格 ========== -->
    <x:Double x:Key="GridGutter">16</x:Double>

    <!-- ========== 窗口 ========== -->
    <!-- 最小宽 720：必须低于 CompactWindowBreakpoint(1024)，否则窄窗收起逻辑永远不可达。
         720 时导航收起为 72px，内容区仍有 648px，足够单列布局。 -->
    <x:Double x:Key="MainWindowMinWidth">720</x:Double>
    <x:Double x:Key="MainWindowMinHeight">600</x:Double>
    <x:Double x:Key="CompactWindowBreakpoint">1024</x:Double>

    <!-- ========== 其他 ========== -->
    <x:Double x:Key="LogoSize">80</x:Double>
    <x:Double x:Key="AppLogoSize">40</x:Double>
    <x:Double x:Key="FABSize">56</x:Double>
    <x:Double x:Key="ProgressBarWidth">300</x:Double>
    <x:Double x:Key="MediumButtonMinWidth">100</x:Double>
    <x:Double x:Key="SmallButtonMinWidth">80</x:Double>
    <x:Double x:Key="DropDownMaxHeight">400</x:Double>
    <x:Double x:Key="ProgressDialogWidth">440</x:Double>
    <x:Double x:Key="SmallDialogHeight">200</x:Double>
    <x:Double x:Key="UpdateButtonWidth">100</x:Double>
    <x:Double x:Key="UpdateButtonHeight">36</x:Double>

    <!-- ========== 聊天/侧栏 ========== -->
    <!-- 智能助手抽屉：贴右边缘浮出、叠在报告之上（不挤压主区），
         宽度按"能容下 Adaptive Card 双列指标"取值。
         上限受主窗口最小宽度约束：720 - 72（窄窗图标轨）= 648，640 保证最小窗口下仍能完整显示 -->
    <x:Double x:Key="ChatDrawerWidth">640</x:Double>
    <!-- 抽屉贴边于右侧，只保留外侧两角：左侧圆角与内容区分层，右侧与窗口边齐平 -->
    <CornerRadius x:Key="ChatDrawerCornerRadius">12,0,0,12</CornerRadius>

    <!-- ========== 通知 ========== -->
    <x:Double x:Key="NotificationWidth">420</x:Double>
    <x:Double x:Key="NotificationHeight">84</x:Double>
    <x:Double x:Key="NotificationMessageMaxHeight">56</x:Double>
    <CornerRadius x:Key="NotificationIconCornerRadius">12</CornerRadius>

</ResourceDictionary>
