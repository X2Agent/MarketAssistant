<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================== -->
    <!-- 列表与表格样式 (List & Table Styles)                                  -->
    <!-- 金融数据列表 — 清晰对齐、快速扫描、悬停反馈                            -->
    <!-- ================================================================== -->

    <!-- ===== ListBoxItem 基础样式 ===== -->
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="{StaticResource SmallMargin}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ===== 数据列表行 — 金融数据专用 ===== -->
    <Style Selector="ListBoxItem.data-row">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
    </Style>
    <Style Selector="ListBoxItem.data-row:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
    </Style>
    <Style Selector="ListBoxItem.data-row:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
    </Style>
    <Style Selector="ListBoxItem.data-row:selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- ===== 交替行背景 ===== -->
    <Style Selector="ListBoxItem.data-row-alt">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ===== 股票代码列表项 ===== -->
    <Style Selector="ListBoxItem.stock-item">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem.stock-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
    </Style>
    <Style Selector="ListBoxItem.stock-item:selected">
        <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
    </Style>

    <!-- ===== ItemsControl 通用容器 ===== -->
    <Style Selector="ItemsControl">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

</Styles>
