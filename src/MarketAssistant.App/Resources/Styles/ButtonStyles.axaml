<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================== -->
    <!-- 按钮组件体系 (Button System)                                        -->
    <!-- 变体: Primary / Secondary / Ghost / Danger / Icon                   -->
    <!-- 尺寸: Small (28) / Medium (32) / Large (40)                          -->
    <!-- ================================================================== -->

    <!-- ===== 全局按钮默认 ===== -->
    <Style Selector="Button">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Height" Value="{StaticResource ButtonHeight}"/>
        <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}"/>
        <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- ===== Primary 按钮 — 主要操作 ===== -->
    <Style Selector="Button.btn-primary">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
    </Style>
    <Style Selector="Button.btn-primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
    </Style>
    <Style Selector="Button.btn-primary:disabled">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <!-- ===== Secondary 按钮 — 次要操作 ===== -->
    <Style Selector="Button.btn-secondary">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style Selector="Button.btn-secondary:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.btn-secondary:pressed">
        <Setter Property="Background" Value="{DynamicResource PressedBackgroundBrush}"/>
    </Style>

    <!-- ===== Ghost 按钮 — 低优先级操作 ===== -->
    <Style Selector="Button.btn-ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.btn-ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- ===== Danger 按钮 — 危险/删除操作 ===== -->
    <Style Selector="Button.btn-danger">
        <Setter Property="Background" Value="{DynamicResource DangerPanelBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource DangerPanelTextBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerPanelBackgroundStrongBrush}"/>
    </Style>
    <Style Selector="Button.btn-danger:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerPanelBorderBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ===== 按钮尺寸变体 ===== -->

    <!-- Small 按钮 (28px) -->
    <Style Selector="Button.btn-sm">
        <Setter Property="Height" Value="{StaticResource SmallButtonHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource TinyFontSize}"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <!-- Large 按钮 (40px) -->
    <Style Selector="Button.btn-lg">
        <Setter Property="Height" Value="{StaticResource LargeButtonHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource LabelFontSize}"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>

    <!-- ===== Icon 按钮 — 纯图标按钮 (44px 点击区域) ===== -->
    <Style Selector="Button.btn-icon">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource IconButtonSize}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.btn-icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.btn-icon:disabled">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>

    <!-- Small Icon 按钮 (36px) -->
    <Style Selector="Button.btn-icon-sm">
        <Setter Property="Width" Value="{StaticResource SmallIconButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource SmallIconButtonSize}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.btn-icon-sm:pointerover">
        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- ===== 特定场景按钮（保持向后兼容） ===== -->

    <!-- 时间周期按钮 -->
    <Style Selector="Button.period-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}"/>
        <Setter Property="Padding" Value="{StaticResource SmallHorizontalMargin}"/>
        <Setter Property="Height" Value="{StaticResource SmallButtonHeight}"/>
        <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}"/>
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.period-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.period-button.selected">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- 操作按钮 -->
    <Style Selector="Button.action-button">
        <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}"/>
        <Setter Property="Padding" Value="{StaticResource HorizontalMargin}"/>
        <Setter Property="Height" Value="{StaticResource ButtonHeight}"/>
        <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}"/>
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
    </Style>
    <Style Selector="Button.action-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <!-- 成功按钮 -->
    <Style Selector="Button.success">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}"/>
    </Style>
    <Style Selector="Button.success:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SuccessHoverBrush}"/>
    </Style>
    <Style Selector="Button.success:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource SuccessPressedBrush}"/>
    </Style>

    <!-- 警告按钮 -->
    <Style Selector="Button.warning">
        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}"/>
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}"/>
    </Style>
    <Style Selector="Button.warning:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource WarningHoverBrush}"/>
    </Style>
    <Style Selector="Button.warning:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource WarningPressedBrush}"/>
    </Style>

    <!-- 功能按钮 — 次要描边样式，与浅色卡片风格统一 -->
    <Style Selector="Button.feature-button">
        <Setter Property="Background" Value="{DynamicResource ItemBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource SmallFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="{StaticResource ButtonHeight}"/>
        <Setter Property="Padding" Value="{StaticResource CompactCardPadding}"/>
        <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}"/>
    </Style>
    <Style Selector="Button.feature-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
    <Style Selector="Button.feature-button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <!-- 图标操作按钮 — 工具栏图标按钮，悬停浅色反馈 -->
    <Style Selector="Button.icon-action">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="{StaticResource SmallCornerRadius}"/>
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.icon-action:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceVariantBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
    <Style Selector="Button.icon-action:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    </Style>

    <!-- Info 按钮 — 信息/链接操作 -->
    <Style Selector="Button.btn-info">
        <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.btn-info:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource InfoHoverBrush}"/>
    </Style>
    <Style Selector="Button.btn-info:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource InfoPressedBrush}"/>
    </Style>

    <!-- 悬停显示按钮 (删除/收藏) -->
    <Style Selector="Button.delete-button, Button.favorite-button">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- 收藏按钮 -->
    <Style Selector="Button.favorite-button">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

</Styles>
