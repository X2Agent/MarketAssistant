<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================== -->
    <!-- MarketAssistant Design System v3.0 — Typography                      -->
    <!--                                                                     -->
    <!-- 全局五档字号：32 / 24 / 16 / 14 / 12
         （Display 大数字 / Title 标题 / Body 阅读正文 / BodySm 密集数据主力 / Caption 辅助）。
         BodySm(14) 由 Body(16) 派生：同一档正文在表格、表单这类高密度场景降一级，
         而不是再新造一档语义。除此之外不新增字号。 -->
    <!--
    三条排版纪律：
      1. 不用全大写、不用斜体。中文没有大小写，全大写只对英文标签有害。
      2. 字重一律走 {DynamicResource Weight*}，才能随暗色自动降一档。
      3. 等宽字体只给数值。文字类内容一律无衬线。
    -->

    <!-- ===== 标题（页面 / 弹窗 / 卡片组） ===== -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}"/>
        <Setter Property="FontWeight" Value="{DynamicResource WeightTitle}"/>
        <Setter Property="LineHeight" Value="{StaticResource TitleLineHeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- 卡片标题：同 Title 语义但缩小到正文档，靠字重而非字号拉开层级 -->
    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
        <Setter Property="FontWeight" Value="{DynamicResource WeightTitle}"/>
        <Setter Property="LineHeight" Value="{StaticResource BodyLineHeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- ===== 正文 ===== -->
    <!-- body：阅读型（聊天、报告、说明文字） -->
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
        <Setter Property="FontWeight" Value="{DynamicResource WeightBody}"/>
        <Setter Property="LineHeight" Value="{StaticResource BodyLineHeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- body-sm：密集数据界面（表格、卡片、表单），这是最常用的档 -->
    <Style Selector="TextBlock.body-sm">
        <Setter Property="FontSize" Value="{StaticResource BodySmFontSize}"/>
        <Setter Property="FontWeight" Value="{DynamicResource WeightBody}"/>
        <Setter Property="LineHeight" Value="{StaticResource BodySmLineHeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- ===== 辅助文字 ===== -->
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="FontWeight" Value="{DynamicResource WeightBody}"/>
        <Setter Property="LineHeight" Value="{StaticResource CaptionLineHeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- 表单标签 -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="{StaticResource BodySmFontSize}"/>
        <Setter Property="FontWeight" Value="{DynamicResource WeightEmphasis}"/>
        <Setter Property="LineHeight" Value="{StaticResource BodySmLineHeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- ===== 数值（等宽，只给数字） ===== -->
    <!-- 数字锁定宽度靠两件事：DataFontFamily（等宽字体族）+ 全局 TextBlock 的
         FontFeatures="tnum"（见 App.axaml）。tnum 是表格数字，保证等宽字体族缺失
         （三平台回退到 Consolas / SF Mono / DejaVu，字宽各不相同）时仍逐位对齐。 -->
    <Style Selector="TextBlock.num">
        <Setter Property="FontFamily" Value="{StaticResource DataFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource BodySmFontSize}"/>
        <Setter Property="FontWeight" Value="{DynamicResource WeightBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.num-lg">
        <Setter Property="FontFamily" Value="{StaticResource DataFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}"/>
        <Setter Property="FontWeight" Value="{DynamicResource WeightNumber}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.num-sm">
        <Setter Property="FontFamily" Value="{StaticResource DataFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="FontWeight" Value="{DynamicResource WeightBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- v3 排版类只有这一组：title / card-title / body / body-sm / caption / label /
         num(-lg/-sm)。语义色不提供 TextBlock 类——它在不同底色上要不同取值，
         统一写死一种会在一半场景下不合规（涨跌色由转换器按主题解析）。
         不要恢复 body-strong / num-strong / overline / text-* / text-code：
         它们与上面的类只差一个字重或一个前景色，会让同一层级出现多种写法。 -->

</Styles>
