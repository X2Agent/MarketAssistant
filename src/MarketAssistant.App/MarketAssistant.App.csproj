<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    
    <!-- 跨平台构建配置 -->
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
    <UseAppHost>true</UseAppHost>
    
    <!-- 应用程序信息 -->
    <AssemblyName>MarketAssistant</AssemblyName>
	<AssemblyVersion>1.0.0.0</AssemblyVersion>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <!-- 静态兜底版本号：有 Git Tag 时由 ResolveVersionFromGitTag 自动覆盖为最新 Tag，发版后由 CI 自动回写 -->
    <FallbackVersion>1.0.0-beta2</FallbackVersion>
    <Version>$(FallbackVersion)</Version>
    <Company>X2Agent</Company>
    <Product>Market Assistant</Product>
    <AssemblyTitle>Market Assistant</AssemblyTitle>
    <Copyright>Copyright © 2026</Copyright>
    <Description>AI 智能市场分析助手</Description>
    
    <!-- macOS 特定配置 -->
    <CFBundleName>MarketAssistant</CFBundleName>
    <CFBundleDisplayName>Market Assistant</CFBundleDisplayName>
    <CFBundleIdentifier>xyz.haoai.market</CFBundleIdentifier>
    <!-- CFBundle 版本号跟随 <Version> 自动同步，发版时通过 -p:Version 注入 -->
    <CFBundleVersion>$(Version)</CFBundleVersion>
    <CFBundleShortVersionString>$(Version)</CFBundleShortVersionString>
    <CFBundlePackageType>APPL</CFBundlePackageType>
    <CFBundleSignature>MKAS</CFBundleSignature>
    <CFBundleExecutable>MarketAssistant</CFBundleExecutable>
    <CFBundleIconFile>MarketAssistant.icns</CFBundleIconFile>
    <NSHighResolutionCapable>true</NSHighResolutionCapable>
    <NSPrincipalClass>NSApplication</NSPrincipalClass>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarketAssistant.Core\MarketAssistant.Core.csproj" />
    <ProjectReference Include="..\MarketAssistant.Agents\MarketAssistant.Agents.csproj" />
    <ProjectReference Include="..\MarketAssistant.Trading\MarketAssistant.Trading.csproj" />
    <ProjectReference Include="..\MarketAssistant.DataProviders\MarketAssistant.DataProviders.csproj" />
    <ProjectReference Include="..\MarketAssistant.App.Services\MarketAssistant.App.Services.csproj" />
    <ProjectReference Include="..\MarketAssistant.Rag\MarketAssistant.Rag.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- logo_1024.png 仅供 macOS 打包脚本生成 icns 使用，运行期无需随包分发 -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\logo_1024.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="config\prompts\**\*.yaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="skills\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>skills\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="AdaptiveCards" />
	<PackageReference Include="Avalonia" />
	<PackageReference Include="Avalonia.Desktop" />
	<PackageReference Include="Avalonia.Themes.Fluent" />
	<PackageReference Include="Avalonia.Fonts.Inter" />
	<PackageReference Include="Markdig" />
	<PackageReference Include="CommunityToolkit.Mvvm" />
	<PackageReference Include="Svg.Controls.Skia.Avalonia" />
	<PackageReference Include="Svg.Skia" />
	<!-- SkiaSharp：分享卡 PDF 封装（SKDocument）。Svg.Skia 已传递依赖，显式引用避免隐式依赖漂移 -->
	<PackageReference Include="SkiaSharp" />
	<!-- Avalonia 官方 WebView（MIT 开源,无需许可证） -->
	<PackageReference Include="Avalonia.Controls.WebView" />
	<PackageReference Include="Avalonia.Controls.DataGrid" />
	<PackageReference Include="Markdown.Avalonia" />
	<PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <!-- macOS 平台特定配置 - 修复 WebView 相关本地库问题 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64'">
    <!-- 跳过不存在的本地库检查 -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- 排除可选的本地库文件 -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64'">
    <Content Remove="**/libEGL.dylib" />
    <Content Remove="**/libGLESv2.dylib" />
  </ItemGroup>

  <!-- 编译期自动从最新 Git Tag (v*) 推导版本号：当未通过命令行显式指定 -p:Version 时生效 -->
  <Target Name="ResolveVersionFromGitTag"
          BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;PrepareForBuild"
          Condition="'$(DisableGitVersionLookup)' != 'true' And '$(Version)' == '$(FallbackVersion)'">
    <Exec Command="git describe --tags --abbrev=0 --match &quot;v[0-9]*&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitLatestTag" />
      <Output TaskParameter="ExitCode" PropertyName="_GitDescribeExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_GitDescribeExitCode)' == '0' And '$(_GitLatestTag)' != ''">
      <_ResolvedGitVersion>$(_GitLatestTag.Trim().TrimStart('v'))</_ResolvedGitVersion>
      <Version Condition="'$(_ResolvedGitVersion)' != ''">$(_ResolvedGitVersion)</Version>
      <PackageVersion Condition="'$(_ResolvedGitVersion)' != ''">$(_ResolvedGitVersion)</PackageVersion>
      <InformationalVersion Condition="'$(_ResolvedGitVersion)' != ''">$(_ResolvedGitVersion)</InformationalVersion>
      <CFBundleVersion Condition="'$(_ResolvedGitVersion)' != ''">$(_ResolvedGitVersion)</CFBundleVersion>
      <CFBundleShortVersionString Condition="'$(_ResolvedGitVersion)' != ''">$(_ResolvedGitVersion)</CFBundleShortVersionString>
    </PropertyGroup>
  </Target>
</Project>
