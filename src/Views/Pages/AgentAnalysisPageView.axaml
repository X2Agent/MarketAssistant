<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:views="using:MarketAssistant.Views.Components"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             xmlns:converts="using:MarketAssistant.Converts"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="MarketAssistant.Views.Pages.AgentAnalysisPageView"
             x:DataType="vm:AgentAnalysisViewModel"
             x:Name="ParentPage">

    <UserControl.Resources>
        <x:Double x:Key="HistoryFlyoutWidth">220</x:Double>
        <x:Double x:Key="HistoryFlyoutMaxHeight">300</x:Double>
    </UserControl.Resources>

    <Grid ColumnDefinitions="*,Auto">
        <!-- 主内容区域 -->
        <Grid Grid.Column="0" ClipToBounds="True">
            <!-- 进度显示区域 - 仅在分析时显示 -->
            <views:ProgressDisplayView 
                IsVisible="{Binding IsBusy}"
                IsAnalysisInProgress="{Binding IsAnalysisInProgress}"
                AnalysisStage="{Binding AnalysisStage}"/>

            <!-- 分析完成后的内容区域（包含浮动操作按钮） -->
            <Grid IsVisible="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}">
                <!-- 智能分析报告区域 -->
                <ContentControl Content="{Binding AnalysisReportViewModel}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:AnalysisReportViewModel">
                            <views:AnalysisReportView DataContext="{Binding}"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            
                <!-- 水印控件 -->
                <controls:WatermarkView 
                    Text="数据来源网络，仅供参考。投资有风险，入市需谨慎！" 
                    OpacityValue="0.15" 
                    Angle="-30" 
                    FontSize="{StaticResource ExtraLargeFontSize}" 
                    HorizontalRepeatCount="2" 
                    VerticalRepeatCount="4" 
                    ZIndex="999" 
                    IsHitTestVisible="False"/>
            
                <!-- 浮动操作按钮组 -->
                <StackPanel HorizontalAlignment="Right" 
                            VerticalAlignment="Bottom" 
                            ZIndex="1000" 
                            Margin="{StaticResource FABMargin}"
                            Spacing="{StaticResource DefaultSpacing}">
                    <!-- 历史报告 FAB -->
                    <Button Content="📋"
                            FontSize="{StaticResource TitleFontSize}"
                            Width="{StaticResource FABSize}"
                            Height="{StaticResource FABSize}"
                            CornerRadius="{StaticResource FABCornerRadius}"
                            Background="{DynamicResource SecondaryBrush}"
                            IsVisible="{Binding HasReportHistory}"
                            ToolTip.Tip="历史报告"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <Button.Flyout>
                            <Flyout Placement="Left">
                                <StackPanel Width="{StaticResource HistoryFlyoutWidth}" MaxHeight="{StaticResource HistoryFlyoutMaxHeight}">
                                    <TextBlock Text="历史报告" FontWeight="Bold" 
                                               Margin="{StaticResource SmallBottomMargin}"/>
                                    <ItemsControl ItemsSource="{Binding ReportHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Background="Transparent"
                                                        Padding="{StaticResource CompactCardPadding}"
                                                        Margin="{StaticResource TinyBottomMargin}"
                                                        Command="{Binding $parent[ItemsControl].((vm:AgentAnalysisViewModel)DataContext).LoadHistoryReportCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                                                        <TextBlock Text="{Binding ScoreTrendText}"
                                                                   FontSize="{StaticResource LabelFontSize}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding KeyScoreChangeText}"
                                                                   FontSize="{StaticResource LabelFontSize}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- 导出报告 FAB -->
                    <Button Content="📄"
                            FontSize="{StaticResource TitleFontSize}"
                            Width="{StaticResource FABSize}"
                            Height="{StaticResource FABSize}"
                            CornerRadius="{StaticResource FABCornerRadius}"
                            Background="{DynamicResource SecondaryBrush}"
                            Command="{Binding ExportReportCommand}"
                            IsVisible="{Binding CanExportReport}"
                            ToolTip.Tip="导出 Markdown 报告"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                    <!-- 智能对话 FAB -->
                    <Button Content="💬" 
                            FontSize="{StaticResource TitleFontSize}"
                            Width="{StaticResource FABSize}"
                            Height="{StaticResource FABSize}"
                            CornerRadius="{StaticResource FABCornerRadius}"
                            Background="{DynamicResource PrimaryBrush}"
                            Command="{Binding ToggleChatSidebarCommand}"
                            ToolTip.Tip="智能对话"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 聊天侧边栏 -->
        <Border Grid.Column="1" 
                IsVisible="{Binding IsChatSidebarVisible}"
                Width="{StaticResource SidebarWidth}"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="{StaticResource LeftBorderThickness}">
            <ContentControl Content="{Binding ChatSidebarViewModel}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:ChatSidebarViewModel">
                        <views:ChatSidebarView DataContext="{Binding}"
                                              CloseCommand="{Binding #ParentPage.((vm:AgentAnalysisViewModel)DataContext).ToggleChatSidebarCommand}" />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>

