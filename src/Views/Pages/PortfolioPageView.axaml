<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarketAssistant.ViewModels"
             xmlns:controls="using:MarketAssistant.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MarketAssistant.Views.Pages.PortfolioPageView"
             x:DataType="vm:PortfolioPageViewModel">

    <ScrollViewer Background="{DynamicResource CardBackgroundBrush}">
        <StackPanel Spacing="{StaticResource DefaultSpacing}" Margin="{StaticResource ImmersivePageMargin}">

            <!-- 总览卡片 -->
            <controls:CardView Header="持仓总览">
                <Grid ColumnDefinitions="*,*,*,*">
                    <StackPanel Grid.Column="0" Spacing="{StaticResource TinySpacing}">
                        <TextBlock Text="总市值" FontSize="{StaticResource LabelFontSize}" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalMarketValue, StringFormat={}{0:N2}}" 
                                   FontSize="{StaticResource LargeFontSize}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource TinySpacing}">
                        <TextBlock Text="总成本" FontSize="{StaticResource LabelFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalCost, StringFormat={}{0:N2}}"
                                   FontSize="{StaticResource LargeFontSize}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="{StaticResource TinySpacing}">
                        <TextBlock Text="总盈亏" FontSize="{StaticResource LabelFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalProfitLoss, StringFormat={}{0:N2}}"
                                   FontSize="{StaticResource LargeFontSize}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="{StaticResource TinySpacing}">
                        <TextBlock Text="收益率" FontSize="{StaticResource LabelFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalProfitLossPercent, StringFormat={}{0:F2}%}"
                                   FontSize="{StaticResource LargeFontSize}" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </controls:CardView>

            <!-- 添加交易 -->
            <controls:CardView Header="记录交易">
                <StackPanel Spacing="{StaticResource SmallSpacing}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch">
                        <TextBox Grid.Row="0" Grid.Column="0" Margin="{StaticResource TinyMargin}"
                                 Text="{Binding TradeAssetCode}" Watermark="资产代码（如 BTC）"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="{StaticResource TinyMargin}"
                                 Text="{Binding TradeAssetName}" Watermark="资产名称（选填）"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Margin="{StaticResource TinyMargin}"
                                 Text="{Binding TradePrice}" Watermark="价格"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="{StaticResource TinyMargin}"
                                 Text="{Binding TradeQuantity}" Watermark="数量"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource DefaultSpacing}" 
                                HorizontalAlignment="Right">
                        <Button Content="买入" Command="{Binding ExecuteBuyCommand}"
                                Background="{DynamicResource RiseBrush}" Foreground="White"
                                Padding="{StaticResource PagePadding}"/>
                        <Button Content="卖出" Command="{Binding ExecuteSellCommand}"
                                Background="{DynamicResource FallBrush}" Foreground="White"
                                Padding="{StaticResource PagePadding}"/>
                    </StackPanel>
                </StackPanel>
            </controls:CardView>

            <!-- 持仓列表 -->
            <controls:CardView Header="当前持仓">
                <ItemsControl ItemsSource="{Binding Positions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="{StaticResource DefaultCardPadding}"
                                    Margin="{StaticResource TinyBottomMargin}"
                                    Background="{DynamicResource PageBackgroundBrush}"
                                    CornerRadius="{StaticResource SmallCornerRadius}">
                                <Grid ColumnDefinitions="2*,*,*,*,*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding AssetName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding AssetCode}" 
                                                   FontSize="{StaticResource LabelFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="持仓" FontSize="{StaticResource LabelFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Quantity, StringFormat={}{0:G}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="成本" FontSize="{StaticResource LabelFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding AverageCost, StringFormat={}{0:G}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="现价" FontSize="{StaticResource LabelFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CurrentPrice, StringFormat={}{0:G}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="盈亏" FontSize="{StaticResource LabelFontSize}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding ProfitLossPercent, StringFormat={}{0:F2}%}"/>
                                    </StackPanel>
                                    <Button Grid.Column="5" Content="✕" 
                                            Command="{Binding $parent[ItemsControl].((vm:PortfolioPageViewModel)DataContext).RemovePositionCommand}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:CardView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
