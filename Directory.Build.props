<Project>
  <PropertyGroup>
    <!-- 集中管理所有工程的通用属性（原 WinUI/Windows TFM 相关段已移除：当前全部工程均为 net10.0，无 WinUI 目标） -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MarketAssistant</RootNamespace>

    <!-- VS 隔离构建（Isolated MSBuild）会在 obj-isolated/bin-isolated 生成第二套编译产物，
         默认 glob 会将其扫入 Compile 项，与 obj/bin 下的生成文件重复导致 CS0579。
         obj-workbuddy/bin-workbuddy 为 WorkBuddy 隔离构建目录，同样需排除。
         此处显式排除，防止生成文件被编译两份。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj-isolated/**;**/bin-isolated/**;**/obj-workbuddy/**;**/bin-workbuddy/**</DefaultItemExcludes>

    <!-- 限制发布/输出的卫星资源语种，避免生成大量无用语言目录 -->
    <!-- 如需调整，使用分号分隔：例如 zh-Hans;en-US;ja -->
    <SatelliteResourceLanguages>zh-Hans;en-us</SatelliteResourceLanguages>

    <!--
      质量门策略（渐进式，勿直接跳级）：

      当前默认开启的是「编译器 + MSTest 分析器」级别的门禁：
        - TreatWarningsAsErrors：本次已将全库存量警告清零（Release 构建 0 Warning），
          后续新增警告将直接导致构建失败，防止静默累积。
        - EnableNETAnalyzers=false：.NET CA 规则暂不默认全量开启。
          实测一次性开启 AnalysisMode=Recommended 会在本仓库暴露数百处存量告警
          （CA1305/CA1310/CA1848/CA1859/CA1860 等，横跨 Rag、DataProviders、Core 等层），
          在发版前引入会直接阻塞构建，风险高于收益。

      渐进路径：先按目录分批清零存量，再按规则分批开启。
        1) dotnet build -p:AnalysisMode=Recommended 查看全量告警（不改构建结果）
        2) 逐项目清零后，为该项目单独放开（如 Directory.Build.props 同级加条件）
        3) 全库清零后再把 EnableNETAnalyzers 置为 true 并启用 TreatWarningsAsErrors

      已完成的真实缺陷修复（可作为后续参考基线）：
        - CA1310/CA1311/CA1304：全库标的与标识符的字符串比较、大小写转换已改为
          Ordinal / Invariant（如 BinanceAccountService、BinanceExchangeClient、
          StockSymbolConverter、CryptoSymbolConverter 等 18 个文件）。
          原先依赖当前区域设置，在 tr-TR/az 等区域下交易所前缀与计价货币后缀
          可能匹配失败，进而把标的路由到错误市场，属资金安全相关缺陷。
        - CA1816：4 处 Dispose 补齐 GC.SuppressFinalize；ClipImageEmbeddingService
          另补幂等保护（ONNX InferenceSession 重复释放不安全）。
        - DateTime.Parse 一致性：ChatSessionPersistenceService 的 5 处读取改为
          InvariantCulture + RoundtripKind，与写入侧 ToString("O") 对齐，
          并与 DailyBriefingService 统一。此前在非 en-US 区域下可能丢失 Kind。

      以下规则经逐条核查确认为误报或与既有约定冲突，预先关闭以免干扰后续治理：
        - CA1848/CA1873 日志内插值：本项目已统一使用结构化日志占位符写法，
          规则会把「含 {占位符} 字面量的普通插值字符串」误判为日志内插值。
        - CA1720 枚举名格式：枚举成员带 [Description] 中文标注并以名称持久化到
          SQLite（PositionSide/OrderSide 等），改名会破坏数据兼容性。
        - CA1305 指定区域性格式化：本项目约 200 处命中中，绝大多数是**面向用户的
          展示格式化**（如 AlertEvent.LocalTimeText 用 ToString("yyyy-MM-dd HH:mm:ss")、
          AShareIndexQuoteService 用 ToString("N2")）。这些位置**应当**跟随当前区域，
          否则中文用户会看到 1234.56 而非 1,234.56，属体验回退。
          真正需要固定区域的两类已单独处理：① 持久化读写（写入 ToString("O") /
          读取 InvariantCulture）；② 协议与解析（已全库核查 decimal/double.Parse
          均已指定 CultureInfo）。StringBuilder.AppendLine 的插值命中同属误报。
        - CA1707 标识符含下划线：测试方法名采用
          `场景_条件_预期` 约定（如 ChainRegistryTest），为团队既有命名惯例。
    -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!--
      警告即错误：防止新增警告静默累积。
      调试时可用 dotnet build -p:TreatWarningsAsErrors=false 临时放宽。
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 生成文档注释缺失等噪声告警对当前项目无价值，统一关闭 -->
    <NoWarn>$(NoWarn);CS1591;CA1305;CA1707</NoWarn>
  </PropertyGroup>
</Project>
