<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- MAF / Agents -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.6.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.6.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows.Generators" Version="1.6.1" />

    <!-- Microsoft.Extensions.* -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.5.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.5.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.6" />

    <!-- Data / docs / parsing -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="Markdig" Version="1.1.1" />
    <PackageVersion Include="PdfPig" Version="0.1.13" />
    <PackageVersion Include="SmartReader" Version="0.11.0" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />

    <!-- ML / indicators -->
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.24.3" />
    <PackageVersion Include="Skender.Stock.Indicators" Version="2.7.1" />

    <!-- SK / MCP -->
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.SqliteVec" Version="1.73.0-preview" />
    <PackageVersion Include="Microsoft.SemanticKernel.Plugins.Web" Version="1.73.0-alpha" />
    <PackageVersion Include="ModelContextProtocol" Version="1.1.0" />

    <!-- Logging -->
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- UI -->
    <PackageVersion Include="Avalonia" Version="12.0.0-preview2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.0.0-preview2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.0.0-preview2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.0.0-preview2" />
    <PackageVersion Include="Avalonia.Controls.WebView" Version="12.0.0-preview2" />
    <PackageVersion Include="Markdown.Avalonia" Version="11.0.3-a1" />
    <PackageVersion Include="AdaptiveCards" Version="3.1.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.58.0" />
    <PackageVersion Include="Svg.Controls.Skia.Avalonia" Version="11.3.9.4" />
    <PackageVersion Include="Svg.Skia" Version="3.6.0" />
    <PackageVersion Include="SkiaSharp" Version="3.119.2" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="MSTest" Version="4.1.0" />
  </ItemGroup>
</Project>

